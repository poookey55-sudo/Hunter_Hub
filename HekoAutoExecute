            if NexoHRQuestId then pcall(function() push(NexoHRQuestId()) end) end
            if NexoKMQuestId then pcall(function() push(NexoKMQuestId()) end) end
            if NexoRctQuestId then pcall(function() push(NexoRctQuestId()) end) end
            if currentQuestId then pcall(function() push(currentQuestId()) end) end
            for i = 1, #ids do pcall(NexoCapStaleFix, ids[i]) end
            task.wait(NEXO_STALE_TICK)
        end
    end
end)

-- ---------------------------------------------------------------------------------------------
-- CAPTURE QUESTS, PART 3: ROAM INSIDE THE AREA AND HUNT (requested behaviour)
-- ---------------------------------------------------------------------------------------------
-- Instead of parking in the middle of the volume and yanking mobs onto us, the character now
-- MOVES around inside the quest area and goes to the mobs, dragging any stray ServerModel in on
-- the way. This matters for scoring, not just looks:
--   * EnemyInAreaPoints is sampled every 2s, so a mob that is standing still inside the volume is
--     worth more than one being re-slammed onto our position 20x a second.
--   * Sitting perfectly still in one spot is also the least natural thing a player can do.
-- Everything stays inside Bounds: the roam target is always clamped to 70% of the area radius, so
-- roaming can never walk the quest out of its own scoring volume.
-- Smooth, continuous orbiting -- NOT teleport hops. The character is stepped a few studs per
-- frame at heartbeat rate, so it reads as running in a circle inside the quest area instead of
-- blinking between points. Nothing here ever moves us out of the volume: every target is clamped
-- to NEXO_ROAM_CLAMP of the radius, and the only instant correction allowed is when some OTHER
-- system has already thrown us far outside (NEXO_ROAM_SNAP), which we undo in one step.
NEXO_ROAM_SPEED = 55     -- studs/second of travel (a run, not a teleport)
NEXO_ROAM_TURN  = 1.15   -- radians/second around the circle
NEXO_ROAM_NEAR  = 5      -- how close we circle the mob we are hitting
NEXO_ROAM_SWEEP = 0.55   -- sweep radius as a fraction of the area radius
NEXO_ROAM_CLAMP = 0.70   -- never travel past this fraction of the radius
NEXO_ROAM_SNAP  = 250    -- only a displacement this large is corrected instantly
NEXO_ROAM_PICK  = 0.35   -- seconds between re-picking a mob / re-running the bring
NexoRoamAngle = 0

-- Keep a roam target inside the scoring volume (height preserved so we stay on the mobs' level).
function NexoCapClamp(p, center, rad)
    local d = p - center
    local flat = Vector3.new(d.X, 0, d.Z)
    local lim = rad * NEXO_ROAM_CLAMP
    if flat.Magnitude > lim and flat.Magnitude > 0 then
        flat = flat.Unit * lim
    end
    local ylim = rad * 0.35
    local y = math.clamp(p.Y, center.Y - ylim, center.Y + ylim)
    return Vector3.new(center.X + flat.X, y, center.Z + flat.Z)
end

task.spawn(function()
    local nextPick, best = 0, nil
    while NEXOG.NexoHubSession == SESSION do
        local farming = QuestOn or BringQuestOn or AutoGojoOn or BringGojoOn
            or (NexoRctAnyOn and NexoRctAnyOn()) or (NexoStarQuestOn and NexoStarQuestOn())
            or (NexoHRAnyOn and NexoHRAnyOn()) or (NexoKMAnyOn and NexoKMAnyOn())
        local center, rad = NexoCapPoint()
        if not (farming and center and NexoCapRoamOn) then
            if NexoCapPhase == "roam" then NexoCapPhase = "hold" end
            best = nil
            task.wait(NEXO_IDLE)
        else
            local cur = getModel()
            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
            if not chrp then
                best = nil
                task.wait(NEXO_IDLE)
            else
                NexoCapPhase = "roam"
                local now = os.clock()
                if now >= nextPick then
                    nextPick = now + NEXO_ROAM_PICK
                    -- keep the mobs in the volume with us (their SERVER models: what scoring reads)
                    pcall(NexoAIBring, chrp.Position)
                    best = nil
                    local bd = math.huge
                    local list = NexoAIQuestList()
                    for i = 1, #list do
                        local pp = list[i].pp
                        if pp and pp.Parent then
                            local dc = pp.Position - center
                            if Vector3.new(dc.X, 0, dc.Z).Magnitude <= rad and math.abs(dc.Y) <= rad then
                                local d = (pp.Position - chrp.Position).Magnitude
                                if d < bd then bd, best = d, pp end
                            end
                        end
                    end
                end

                -- one frame of travel; dt keeps the speed constant regardless of frame rate
                local dt = RunService.Heartbeat:Wait() or 0.016
                if dt > 0.2 then dt = 0.2 end
                NexoRoamAngle = (NexoRoamAngle + NEXO_ROAM_TURN * dt) % (math.pi * 2)

                local target
                if best and best.Parent then
                    -- CIRCLE THE MOB: keep our distance and strafe around it while the attack
                    -- loops swing, rather than standing on top of it.
                    local mp = best.Position
                    local b = chrp.Position - mp
                    b = Vector3.new(b.X, 0, b.Z)
                    local bearing = (b.Magnitude > 0.1) and math.atan2(b.Z, b.X) or NexoRoamAngle
                    bearing = bearing + NEXO_ROAM_TURN * dt
                    target = Vector3.new(
                        mp.X + math.cos(bearing) * NEXO_ROAM_NEAR,
                        mp.Y + 2,
                        mp.Z + math.sin(bearing) * NEXO_ROAM_NEAR
                    )
                else
                    -- ORBIT THE AREA: no mob in the volume yet, so keep circling inside it
                    target = Vector3.new(
                        center.X + math.cos(NexoRoamAngle) * rad * NEXO_ROAM_SWEEP,
                        center.Y + 3,
                        center.Z + math.sin(NexoRoamAngle) * rad * NEXO_ROAM_SWEEP
                    )
                end
                target = NexoCapClamp(target, center, rad)

                local p = chrp.Position
                local d = target - p
                local flat = Vector3.new(d.X, 0, d.Z)
                local dist = flat.Magnitude
                local step = flat
                if dist > NEXO_ROAM_SNAP then
                    step = flat                       -- something else flung us: undo it in one move
                elseif dist > NEXO_ROAM_SPEED * dt then
                    step = flat.Unit * (NEXO_ROAM_SPEED * dt)  -- glide, never blink
                end
                local np = p + step
                np = Vector3.new(np.X, p.Y + (target.Y - p.Y) * math.min(1, dt * 6), np.Z)
                pcall(function()
                    chrp.AssemblyLinearVelocity = Vector3.zero
                    chrp.AssemblyAngularVelocity = Vector3.zero
                    if dist > 0.6 then
                        local dir = flat.Unit
                        chrp.CFrame = CFrame.new(np, Vector3.new(np.X + dir.X, np.Y, np.Z + dir.Z))
                    else
                        chrp.CFrame = CFrame.new(np)
                    end
                end)
            end
        end
    end
end)

-- ---------------------------------------------------------------------------------------------
-- CAPTURE QUESTS, PART 2: GO GET THE MOBS (the reason points still read 0)
-- ---------------------------------------------------------------------------------------------
-- Everything below was measured live on the running client, not assumed:
--
--  * The character WAS already standing in the middle of the capture area (server model at
--    1444.4, -9.0, -1267.1 vs area centre 1444.4, -13.0, -1267.1), so the area anchoring works.
--  * SavedQuest.Points read 15 -- exactly one EnemyKilledPoints -- proving the server DOES credit
--    a kill made inside the volume. The scoring path is fine.
--  * But a scan of every humanoid within 60 studs of the area returned only THREE models, and all
--    three were the player (client model, its Visual, and the server model). There was not a
--    single quest enemy anywhere in the streamed world.
--  * The quest mobs spawn at workspace.Map.Spawnpoints.QuestSpawnpoints -- 114 plain "Node" parts.
--    The closest one to this capture area is 217 studs away; the rest are 354-623 studs out.
--
-- So the bring loop had nothing to bring. Roblox only replicates nearby models, so mobs sitting at
-- a node 217+ studs away do not exist on our client at all -- an infinite-range bring cannot pull
-- something that was never streamed in. Worse, the area leash added earlier pinned us inside the
-- volume, which guaranteed we could never get close enough to a node for them to stream.
--
-- The fix is a two-phase cycle, which is how a Capture quest is actually meant to be played:
--   GATHER -> no quest mobs on our client, so fly to the nearest spawn node, sit there briefly so
--             they stream in and aggro onto us (AgroRadius 24, AgroEndRadius 225 -- they chase far)
--   HOLD   -> mobs exist, so return to the area centre. The bring loop drags the aggroed mobs in
--             with us, parks them inside the volume, and they get killed there for +15 each, plus
--             +1 per mob every 2s just for being held in the zone.
-- Nodes are tried nearest-first and rotated on failure, so a dead/empty node cannot stall the run.
-- Declared GLOBAL (no `local`) to avoid consuming main-chunk local registers (near Luau's 200 cap).

NEXO_CAP_NODE_WAIT = 1.8   -- seconds spent at a node letting mobs stream in + aggro
NEXO_CAP_HAUL_WAIT = 0.6   -- settle time after hauling back to the area
NEXO_CAP_NODE_HOP  = 3     -- consecutive empty visits before rotating to the next node
NexoCapPhase = "idle"      -- "idle" | "gather" | "hold" -- read by NexoCapKeepInside
NexoCapRoamOn = true       -- ON by default: roam the area and hunt instead of standing still.
NexoCapGatherOn = false    -- OFF by default: the node-fetch path is unverified (0 mobs streamed
                           -- in the live test), so it never moves you unless you enable it.
NexoCapM = NexoCapM or { t = -1, n = 0 }
NexoCapN = NexoCapN or { key = nil, list = nil, i = 1, miss = 0 }

-- How many quest mobs are streamed in right now. Uses the SAME name-tag scan the hub already does
-- for quest targeting (clientLabels + the quest's own enemy-name set), so no extra GUI walk.
function NexoCapMobs()
    local c, now = NexoCapM, os.clock()
    if (now - c.t) < 0.3 then return c.n end
    c.t, c.n = now, 0
    local cap = NexoCapInfo()
    if not cap.on or not cap.names or #cap.names == 0 then return 0 end
    local CF = workspace.Characters and workspace.Characters:FindFirstChild("Client")
    if not CF then return 0 end
    local nms, nn, n = cap.names, #cap.names, 0
    for _, d in ipairs(clientLabels(CF)) do
        if d.ClassName == "TextLabel" then
            local lt = string.lower(d.Text)
            for i = 1, nn do
                if string.find(lt, nms[i], 1, true) then n = n + 1 break end
            end
        end
    end
    c.n = n
    return n
end

-- Quest spawn nodes, sorted nearest-first to the active capture area. Cached per quest id.
function NexoCapNodes()
    local cap = NexoCapInfo()
    if not cap.on or not cap.pos then return nil end
    local st, key = NexoCapN, tostring(cap.id)
    if st.key == key and st.list and #st.list > 0 then return st.list end
    local qs
    pcall(function() qs = workspace.Map.Spawnpoints.QuestSpawnpoints end)
    if not qs then return nil end
    local list = {}
    for _, c in ipairs(qs:GetChildren()) do
        if c:IsA("BasePart") then
            local v = c.Position - cap.pos
            list[#list + 1] = { p = c.Position, d = Vector3.new(v.X, 0, v.Z).Magnitude }
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    st.key, st.list, st.i, st.miss = key, list, 1, 0
    if #list == 0 then return nil end
    return list
end

-- GATHER/HOLD supervisor. Only runs while a farming switch is on AND an unfinished Capture quest is
-- active, so it costs one boolean check per NEXO_IDLE tick otherwise.
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        local farming = QuestOn or BringQuestOn or AutoGojoOn or BringGojoOn
            or (NexoRctAnyOn and NexoRctAnyOn()) or (NexoStarQuestOn and NexoStarQuestOn())
            or (NexoHRAnyOn and NexoHRAnyOn()) or (NexoKMAnyOn and NexoKMAnyOn())
        local capPos, capRad = NexoCapPoint()
        if not (farming and capPos and NexoCapGatherOn) then
            NexoCapPhase = "idle"
            task.wait(NEXO_IDLE)
        elseif NexoCapMobs() > 0 then
            -- mobs are on our client: hold the area so the bring loop parks them in the volume
            NexoCapPhase = "hold"
            NexoCapN.miss = 0
            task.wait(0.4)
        else
            -- nothing streamed: go fetch. Never teleports blind -- only to a real spawn node.
            local nodes = NexoCapNodes()
            if not nodes then
                NexoCapPhase = "hold"
                task.wait(NEXO_IDLE)
            else
                NexoCapPhase = "gather"
                local st = NexoCapN
                if st.i > #nodes then st.i = 1 end
                local node = nodes[st.i]
                local cur = getModel()
                local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                if chrp and node then
                    pcall(function()
                        chrp.AssemblyLinearVelocity = Vector3.zero
                        chrp.CFrame = CFrame.new(node.p + Vector3.new(0, 6, 0))
                    end)
                    task.wait(NEXO_CAP_NODE_WAIT)
                    if NexoCapMobs() > 0 then
                        st.miss = 0 -- this node produced mobs: keep using it next cycle
                    else
                        st.miss = st.miss + 1
                        if st.miss >= NEXO_CAP_NODE_HOP then
                            st.miss, st.i = 0, st.i + 1 -- empty node: rotate outward
                        end
                    end
                    -- haul whatever aggroed back into the scoring volume
                    NexoCapPhase = "hold"
                    local pos2 = NexoCapPoint()
                    if pos2 then
                        pcall(function()
                            chrp.AssemblyLinearVelocity = Vector3.zero
                            chrp.CFrame = CFrame.new(pos2 + Vector3.new(0, NEXO_CAP_LIFT, 0))
                        end)
                    end
                    task.wait(NEXO_CAP_HAUL_WAIT)
                else
                    task.wait(NEXO_IDLE)
                end
            end
        end
    end
end)
