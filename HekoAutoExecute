-- Re-resolved on demand: the altar folder only exists while Shadow Island is streamed in.
function nexoAltarSet()
    if NexoAltarSet and NexoAltarSet.Parent then return NexoAltarSet end
    NexoAltarSet = nil
    pcall(function()
