-- Robustly "click" any visible TextButton whose text contains the keyword: fire EVERY handler on
-- all its click signals (Activated / MouseButton1Click / Down / Up) so it works no matter which
-- one the game connected to. firesignal(MouseButton1Click) alone often misses .Activated buttons.
-- ANTI-LAG: clickPopups() checks SEVERAL keywords inside ONE PlayerGui walk. Every raid /
-- trial safety net used to call clickPopup twice in a row, which meant two full GUI walks
-- back to back on every tick. clickPopup(kw) is kept as a 1-keyword wrapper so every
-- existing call site behaves exactly as before.
NEXO_CLICK_SIGNALS = { "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }
function clickPopups(...) -- GLOBAL: the main chunk is near Luau's 200 local-register cap
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local kws, n = { ... }, select("#", ...)
    for i = 1, n do kws[i] = string.lower(tostring(kws[i] or "")) end
    local clicked = false
    for _, d in ipairs(pg:GetDescendants()) do
        local hit = false
        if d.ClassName == "TextButton" and d.Visible then
            local txt = string.lower(d.Text)
            for i = 1, n do
                if kws[i] ~= "" and string.find(txt, kws[i], 1, true) then hit = true break end
            end
        end
        if hit then
            for _, sname in ipairs(NEXO_CLICK_SIGNALS) do -- shared list: no table per button
                pcall(function()
                    if getconnections then
                        for _, cn in ipairs(getconnections(d[sname])) do
                            pcall(function() cn:Fire() end)
                        end
                    end
                end)
            end
            pcall(function() firesignal(d.MouseButton1Click) end)
            clicked = true
        end
    end
    return clicked
end
local function clickPopup(keyword) return clickPopups(keyword) end

--========================================================--
--  SHARED OVERLORD RAID ENGINE  (drives ALL 10 raids)
--========================================================--
-- One proven flow for every Overlord raid, built from the fixed Blood Raid logic:
--   1) QUEUE  : CreateIslandQueue:InvokeServer{ Difficulty = RaidCfg.difficulty, ConfigID = cfg.config }
--               SPAWNS the join part, and we TP onto it the instant it appears
--   2) ANCHOR : stand on the join part's TOP surface and auto-TP back the moment you drift off,
--               reading its nametag (<Zone> > NametagAtt > BillboardGui > Frame > Duration /
--               PlayerCount) -> "Starting in 4 seconds" / "1/5 Players"
--   3) MAP    : countdown finished -> make sure we are standing on OUR OWN raid island
--   4) BOSS   : smash the boss (UNCHANGED kill path: Black Flash + attack), Retry_Method the
--               instant it dies -> boss respawns -> kill again -> loop forever
--   5) WATCHDOGS : outside our island for RAID_OUTSIDE_SEC, or no boss + no pad for RAID_STALL_SEC,
--               restarts the WHOLE flow from step 1, so the loop can never stay broken
-- ANTI-LAG: ZERO workspace:GetDescendants() walks in here. The old find*Zone() helpers did a FULL
-- workspace walk every time the pad was missing -- that was the raid lag. The pad instance, its two
-- TextLabels and the island bounding boxes are cached per raid, and idle raids sleep at NEXO_IDLE.
RAID_PAD_RADIUS  = 10  -- studs from the pad top that still counts as "on the join part"
RAID_OUTSIDE_SEC = 2   -- seconds outside YOUR raid island before the full restart
RAID_STALL_SEC   = 12  -- seconds with no boss and no progress before the full restart
INF_STUCK_SEC    = 25  -- INFINITY raids only: switch on but nothing happening for this long
                       -- (no boss, no join part, no island) = the client is holding a dead
                       -- queue/lock, so everything is dropped and re-queued from scratch.
RAID_QUEUE_GAP   = 1   -- min seconds between CreateIslandQueue invokes (remote-friendly)
RAID_ISLE_MARGIN = 80  -- studs of slack around the raid island bounding box

-- QueueZones is NOT always a direct child of workspace -- in this build it lives under workspace.Map
-- (Map > QueueZones > Choso > NametagAtt > BillboardGui > Frame > Duration). That is why the old
-- lookups found nothing, spawned the part and then never teleported. Resolved once and cached;
-- recursive FindFirstChild is a single C-side lookup, NOT a Lua descendant walk, so there is no lag.
RaidZonesCache = RaidZonesCache or { folder = nil }
function nexoQueueZones()
    local f = RaidZonesCache.folder
    if f and f.Parent then return f end
    f = workspace:FindFirstChild("QueueZones")
    if not f then
        local map = workspace:FindFirstChild("Map")
        f = map and map:FindFirstChild("QueueZones")
        if not f and map then f = map:FindFirstChild("QueueZones", true) end
    end
    if not f then f = workspace:FindFirstChild("QueueZones", true) end
    RaidZonesCache.folder = f
    return f
end
-- Top surface of the join part (+lift): standing INSIDE the part never registers you in the queue.
-- 4 fallbacks so a Model-style pad (parts nested deeper, no PrimaryPart) still resolves instead of
-- silently returning nil and skipping the teleport.
function nexoRaidPadPos(p)
    if not p then return nil end
    local pos = starRageTopPos(p) -- BasePart / PrimaryPart fast path
    if pos then return pos end
    local part = p:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position + Vector3.new(0, (part.Size.Y / 2) + STAR_PAD_LIFT, 0) end
    local ok, cf, size = pcall(function() return p:GetBoundingBox() end)
    if ok and cf and size then return cf.Position + Vector3.new(0, (size.Y / 2) + STAR_PAD_LIFT, 0) end
    local att = p:FindFirstChildWhichIsA("Attachment", true) -- NametagAtt sits on the pad itself
    if att then
        local ok2, wp = pcall(function() return att.WorldPosition end)
        if ok2 and wp then return wp + Vector3.new(0, STAR_PAD_LIFT, 0) end
    end
    return nil
end
function nexoRaidMyPos()
    local m = getModel()
    local h = m and m:FindFirstChild("HumanoidRootPart")
    if not h then return nil end
    return h.Position
end

-- cfg = {
--   zones  = { "Choso" },        -- QueueZone (join part) name(s)
--   config = "Choso",            -- ConfigID sent to CreateIslandQueue
--   tag    = "choso",            -- boss client name-tag text (lowercase substring)
--   isles  = { "choso" },        -- island model name(s) under Map.Geometry.BossIslands
--   isOn   = function() return AutoBloodRaidOn end,  -- live toggle read
-- }
function nexoRaidEngine(cfg)
    local pad, lblSrc, lblDur, lblCnt = nil, nil, nil, nil
    local isleT, isleList, queueT = -1, {}, 0
    local myIsle = nil -- the ONE island model of the raid instance we actually joined
    local isOn = cfg.isOn

    -- JOIN PART (cached instance; always scoped inside QueueZones so the raid MAP model, which can
    -- share the same name, is never mistaken for the join part)
    local function getPad()
        if pad and pad.Parent then return pad end
        pad = nil
        local qz = nexoQueueZones()
        if not qz then return nil end
        for _, nm in ipairs(cfg.zones) do
            local f = qz:FindFirstChild(nm) or qz:FindFirstChild(nm, true)
            if f then pad = f break end
        end
        if not pad then
            for _, d in ipairs(qz:GetChildren()) do
                local ln = string.lower(d.Name)
                for _, nm in ipairs(cfg.zones) do
                    if string.find(ln, string.lower(nm), 1, true) then pad = d break end
                end
                if pad then break end
            end
        end
        return pad
    end
    -- JOIN PART INFO: "Starting in 4 seconds" (Duration) + "1/5 Players" (PlayerCount)
    local function padInfo(p)
        p = p or getPad()
        if not p then return nil, nil, nil end
        if lblSrc ~= p or not (lblDur and lblDur.Parent) then
            lblSrc, lblDur, lblCnt = p, nil, nil
            -- scoped to the pad only (a handful of instances) and only when the cache is stale
            pcall(function()
                for _, d in ipairs(p:GetDescendants()) do
                    if d:IsA("TextLabel") then
                        local n = string.lower(d.Name)
                        if n == "duration" then lblDur = d
                        elseif n == "playercount" then lblCnt = d end
                    end
                end
            end)
        end
        local txt = (lblDur and lblDur.Parent) and lblDur.Text or nil
        local secs
        if txt then
            local low = string.lower(txt)
            local n = string.match(low, "(%d+)%s*second") or string.match(low, "starting in%s*(%d+)")
            secs = n and tonumber(n) or nil
        end
        return txt, secs, ((lblCnt and lblCnt.Parent) and lblCnt.Text or nil)
    end
    -- OUR RAID MAP: the matching island model(s) under workspace.Map.Geometry.BossIslands (cached 2s)
    local function isles()
        local now = os.clock()
        if isleT >= 0 and (now - isleT) < 2 then return isleList end
        local list = {}
        local map = workspace:FindFirstChild("Map")
        local geo = map and map:FindFirstChild("Geometry")
        local folder = geo and geo:FindFirstChild("BossIslands")
        if not folder then folder = workspace:FindFirstChild("BossIslands", true) end
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                if m:IsA("Model") then
                    local ln, hit = string.lower(m.Name), false
                    for _, nm in ipairs(cfg.isles) do
                        if string.find(ln, string.lower(nm), 1, true) then hit = true break end
                    end
                    if hit then
                        local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
                        if ok and cf and size then
                            list[#list + 1] = {
                                model  = m, -- identity across cache refreshes (instance lock)
                                cf     = cf,
                                center = cf.Position,
                                half   = (size * 0.5) + Vector3.new(RAID_ISLE_MARGIN, RAID_ISLE_MARGIN, RAID_ISLE_MARGIN),
                            }
                        end
                    end
                end
            end
        end
        isleList, isleT = list, now
        return list
    end
    local function hasIsles()
        return #isles() > 0
    end
    local function inIsle(pos)
        if not pos then return false end
        for _, isl in ipairs(isles()) do
            local rel = isl.cf:PointToObjectSpace(pos)
            if math.abs(rel.X) <= isl.half.X and math.abs(rel.Y) <= isl.half.Y and math.abs(rel.Z) <= isl.half.Z then
                return true
            end
        end
        return false
    end
    -- ============ RAID INSTANCE LOCK ============
    -- Several players can run the SAME raid at the same time, so BossIslands holds SEVERAL island
    -- models with the SAME name. isles() returns all of them, which means inIsle() on its own is
    -- happy to accept a NEIGHBOUR's island and, through it, a neighbour's boss. So we lock onto the
    -- ONE island instance we are actually standing on and treat that as "the raid I joined".
    local function isleOf(pos)
        if not pos then return nil end
        for _, isl in ipairs(isles()) do
            local rel = isl.cf:PointToObjectSpace(pos)
            if math.abs(rel.X) <= isl.half.X and math.abs(rel.Y) <= isl.half.Y and math.abs(rel.Z) <= isl.half.Z then
                return isl
            end
        end
        return nil
    end
    local function lockIsle()
        local isl = isleOf(nexoRaidMyPos())
        if isl then myIsle = isl.model end
        return myIsle
    end
    local function clearIsle() myIsle = nil end
    -- Inside MY locked island only. Before the lock is taken (still in the lobby) it falls back to
    -- the generic test, so nothing regresses; once locked it is strictly one instance.
    local function inMyIsle(pos)
        if not pos then return false end
        if myIsle and myIsle.Parent then
            for _, isl in ipairs(isles()) do
                if isl.model == myIsle then
                    local rel = isl.cf:PointToObjectSpace(pos)
                    return math.abs(rel.X) <= isl.half.X
                        and math.abs(rel.Y) <= isl.half.Y
                        and math.abs(rel.Z) <= isl.half.Z
                end
            end
        end
        myIsle = nil -- our island despawned (raid over): drop the stale lock and re-acquire
        return inIsle(pos)
    end

    -- land on the island NEAREST to us (used right after the countdown and to pull us back in)
    local function land()
        local pos = nexoRaidMyPos()
        local best, bestD
        for _, isl in ipairs(isles()) do
            local d = pos and (isl.center - pos).Magnitude or 0
            if not bestD or d < bestD then best, bestD = isl, d end
        end
        if not best then return false end
        myIsle = best.model -- this is the instance we are being placed into
        nexoPadHold(best.center + Vector3.new(0, best.half.Y * 0.35, 0), 4)
        lockIsle() -- re-confirm from where we actually ended up
        return true
    end
    local function findBoss()
        -- take the instance lock the moment we are standing on our island, then only ever accept a
        -- boss INSIDE it -- never another player's raid.
        if not (myIsle and myIsle.Parent) then lockIsle() end
        return findNearestTaggedBoss(cfg.tag, inMyIsle)
    end
    -- SPAWN THE JOIN PART (rate-limited so the remote is never spammed)
    local function doQueue(force)
        local now = os.clock()
        if not force and (now - queueT) < RAID_QUEUE_GAP then return false end
        queueT = now
        clearIsle() -- brand new instance incoming: the old lock is meaningless
        pcall(function()
            CreateIslandQueue:InvokeServer({
                -- cfg.difficulty pins a raid that does NOT offer the full Easy..Calamity range
                -- (SummerSiege is Easy/Normal/Hard only); everything else still follows the
                -- Raid-tab dropdown exactly as before.
                Difficulty = cfg.difficulty or RaidCfg.difficulty,
                ConfigID = cfg.config,
                Modifiers = {},
            })
        end)
        return true
    end

    task.spawn(function()
      -- ============ SUPERVISOR ============
      -- Any unexpected runtime error in the flow below (a part destroyed mid-teleport, a nil index
      -- after a respawn, a remote that throws) used to kill this thread PERMANENTLY -- the raid just
      -- silently stopped and only came back if you toggled it off and on. The whole body now runs
      -- inside pcall and is restarted automatically, with a short backoff so a persistent fault
      -- cannot hot-spin the CPU. This is what makes the loop self-healing.
      while NEXOG.NexoHubSession == SESSION do
        local ok, err = pcall(function()
        local inThis = false        -- true while we're in the boss room with a live boss
        local outsideT = nil        -- os.clock() of the moment we first went outside our island
        local stallT = os.clock()   -- last time the raid actually made progress
        local sawBoss = false       -- INFINITY: true once a boss really existed in THIS instance
        local hardT = os.clock()    -- INFINITY: last time anything at all progressed (stuck repair)
        while NEXOG.NexoHubSession == SESSION do
            if not isOn() then
                inThis, outsideT = false, nil
                clearIsle() -- toggled off: forget the instance so the next run re-locks cleanly
                stallT = os.clock()
                sawBoss, hardT = false, os.clock()
                NexoInfReturning = false -- never leave the panel stuck on "returning"
                task.wait(NEXO_IDLE) -- IDLE: costs nothing while this raid is off
            else
                local mdl = getModel()
                local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    task.wait(0.1)
                else
                    local boss, bh = findBoss()
                    if boss and bh then
                        -- ============ BOSS PHASE (unchanged kill path) ============
                        inThis, outsideT = true, nil
                        stallT = os.clock()
                        sawBoss, hardT = true, os.clock()
                        while isOn() and NEXOG.NexoHubSession == SESSION do
                            boss, bh = findBoss()
                            if not (boss and bh) then break end
                            local cur = getModel()
                            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                            if chrp then
                                pcall(function()
                                    chrp.AssemblyLinearVelocity = Vector3.zero
                                    chrp.CFrame = auraGoal(bh)
                                end)
                                -- fire BOTH Black Flash + attack every tick (faster boss kills); each
                                -- move is still capped by its own damageReady/startReady throttle.
                                enableBlackFlash()
                                task.spawn(pcall, blackFlashList, {boss}, cur, chrp)
                                task.spawn(pcall, attackList, {boss}, cur, chrp)
                            end
                            task.wait(0.05)
                        end
                        stallT = os.clock()
                    elseif inThis then
                        -- ============ RETRY PHASE: boss just died ============
                        -- NO DELAY: clear popups + Retry INSTANTLY, then poll for the respawn and
                        -- re-Retry 4x/sec in case the first Retry fired under a reward popup.
                        clickPopup("next"); clickPopup("close")
                        if cfg.infinite then
                        -- ============ INFINITY RAID: ONE CLEAR -> AUTO RETURN ============
                        -- ONLY infinity raids take this path (cfg.infinite); every other raid keeps
                        -- the exact Retry loop below, untouched. An infinite raid ENDS when the boss
                        -- dies, so instead of Retry we clear the reward popups, fire Return_Method to
                        -- go back to the lobby, drop the island lock and queue a brand new run.
                        NexoInfReturning = true
                        pcall(function() NexoReturnRaid:InvokeServer() end)
                        clearIsle()
                        local tR, lastR = os.clock(), os.clock()
                        while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - tR) < 8 do
                            -- back in the lobby the moment the join pad exists again / island is gone
                            if getPad() or not inIsle(nexoRaidMyPos()) then break end
                            if (os.clock() - lastR) >= 0.5 then
                                clickPopups("next", "close") -- a reward popup can eat the first Return
                                pcall(function() NexoReturnRaid:InvokeServer() end)
                                lastR = os.clock()
                            end
                            task.wait(LOOP_GAP)
                        end
                        NexoInfReturning = false
                        inThis, outsideT = false, nil -- lobby again: restart from QUEUE
                        stallT = os.clock()
                        sawBoss, hardT = false, os.clock()
                        doQueue(true)
                        else
                        pcall(function() RetryRaid:InvokeServer() end)
                        local t0, lastRetry = os.clock(), os.clock()
                        while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - t0) < 6 do
                            if findBoss() then break end
                            if (os.clock() - lastRetry) >= 0.25 then
                                clickPopup("next"); clickPopup("close")
                                pcall(function() RetryRaid:InvokeServer() end)
                                lastRetry = os.clock()
                            end
                            -- WATCHDOG: thrown off the island mid-retry -> restart the whole flow
                            if hasIsles() and not inIsle(nexoRaidMyPos()) then
                                if not outsideT then
                                    outsideT = os.clock()
                                elseif (os.clock() - outsideT) >= RAID_OUTSIDE_SEC then
                                    break
                                end
                            else
                                outsideT = nil
                            end
                            task.wait(LOOP_GAP) -- ANTI-LAG: 20x/sec, remote rate gates unchanged
                        end
                        if not findBoss() then
                            inThis, outsideT = false, nil -- no respawn -> back to QUEUE/ANCHOR
                            stallT = os.clock()
                        end
                        end
                    else
                        local p = getPad()
                        if p then
                            -- ============ ANCHOR PHASE: hold the join part through the countdown ============
                            -- TELEPORT FIRST, queue second: CreateIslandQueue:InvokeServer YIELDS until
                            -- the server answers, so queueing first delayed (and sometimes skipped) the TP.
                            hardT = os.clock() -- a join part exists: the flow is alive
                            local padPos = nexoRaidPadPos(p)
                            if padPos then nexoPadHold(padPos, 6) end
                            doQueue()
                            padPos = nexoRaidPadPos(p) or padPos
                            if padPos then nexoPadHold(padPos, 4) end
                            local t0, lastTp = os.clock(), 0
                            while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - t0) < 30 do
                                if findBoss() then break end
                                if not (p and p.Parent) then break end   -- pad gone = raid launched
                                padPos = nexoRaidPadPos(p) or padPos
                                local _, secs = padInfo(p)
                                -- AUTO TP BACK: any drift off the part during the countdown snaps back,
                                -- plus a steady re-anchor 4x/sec so nothing can nudge you off the pad.
                                local me = nexoRaidMyPos()
                                if padPos and ((not me) or (me - padPos).Magnitude > RAID_PAD_RADIUS) then
                                    nexoPadHold(padPos, 2)
                                elseif padPos and (os.clock() - lastTp) >= 0.25 then
                                    lastTp = os.clock()
                                    nexoPadHold(padPos, 1)
                                end
                                if secs and secs <= 0 then break end      -- countdown finished
                                if hasIsles() and inIsle(nexoRaidMyPos()) then break end
                                task.wait(0.05)
                            end
                            -- ============ MAP PHASE: countdown done -> be ON the raid map ============
                            local t1 = os.clock()
                            outsideT = nil
                            while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - t1) < 8 do
                                if findBoss() then break end
                                if hasIsles() then
                                    if inIsle(nexoRaidMyPos()) then
                                        outsideT = nil
                                    else
                                        if not outsideT then
                                            outsideT = os.clock()
                                        elseif (os.clock() - outsideT) >= RAID_OUTSIDE_SEC then
                                            outsideT = nil
                                            land() -- TP me onto the raid map
                                        end
                                    end
                                elseif getPad() and (os.clock() - t1) > 2 then
                                    break -- pad is back: we're in the lobby again, restart from ANCHOR
                                end
                                task.wait(0.1)
                            end
                            stallT = os.clock()
                        else
                            local me = nexoRaidMyPos()
                            if hasIsles() and inIsle(me) then
                                -- ============ LOOP-BREAK REPAIR: on the map, no boss alive ============
                                -- Nudge the respawn with Retry first (cheap); if the boss still never
                                -- comes back, give up on this instance and spawn a fresh join part.
                                clickPopup("next"); clickPopup("close")
                                if cfg.infinite then
                                    -- ###### FIX: DO NOT CANCEL A RAID THAT IS STILL STARTING ######
                                    -- The old code fired Return the instant findBoss() came back empty.
                                    -- On the map that also happens for the first moments of a run while
                                    -- the boss is still streaming in, so the hub teleported you straight
                                    -- back out and killed the raid. Now Return only happens when the run
                                    -- is genuinely finished: a boss really existed in THIS instance and
                                    -- is now gone, or we have sat on the map with no boss at all for the
                                    -- full stall timeout.
                                    if sawBoss or (os.clock() - stallT) >= RAID_STALL_SEC then
                                        NexoInfReturning = true
                                        pcall(function() NexoReturnRaid:InvokeServer() end)
                                        clearIsle()
                                        sawBoss = false
                                        hardT = os.clock()
                                    end
                                else
                                    pcall(function() RetryRaid:InvokeServer() end)
                                end
                                local t2 = os.clock()
                                while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - t2) < 3 do
                                    if findBoss() then break end
                                    if hasIsles() and not inIsle(nexoRaidMyPos()) then break end
                                    task.wait(LOOP_GAP)
                                end
                                if cfg.infinite then NexoInfReturning = false end
                                if not findBoss() and (os.clock() - stallT) >= RAID_STALL_SEC then
                                    stallT = os.clock()
                                    hardT = os.clock()
                                    doQueue(true)
                                end
                            elseif hasIsles() and me then
                                -- ============ OUTSIDE-THE-MAP WATCHDOG (RAID_OUTSIDE_SEC) ============
                                if not outsideT then outsideT = os.clock() end
                                if (os.clock() - outsideT) < RAID_OUTSIDE_SEC then
                                    task.wait(0.1)
                                else
                                    outsideT = nil
                                    stallT = os.clock()
                                    doQueue(true) -- spawn the join part again -> full restart
                                    task.wait(0.25)
                                end
                            else
                                -- ============ QUEUE PHASE: lobby, no pad -> spawn the join part ============
                                outsideT = nil
                                local skip = false
                                if cfg.infinite then
                                    -- ###### FIX: SWITCH ON BUT NOTHING HAPPENS ######
                                    -- After a broken run the client can be left holding a dead queue /
                                    -- island lock, so re-queueing silently did nothing and the toggle
                                    -- looked dead until you restarted the hub. If nothing at all has
                                    -- progressed for INF_STUCK_SEC we now hard-reset: drop the lock and
                                    -- the returning flag, clear popups, fire one Return, then force a
                                    -- fresh queue.
                                    if (os.clock() - hardT) >= INF_STUCK_SEC then
                                        hardT = os.clock()
                                        NexoInfReturning = false
                                        sawBoss = false
                                        clearIsle()
                                        clickPopups("next", "close")
                                        pcall(function() NexoReturnRaid:InvokeServer() end)
                                        task.wait(0.5)
                                        doQueue(true)
                                        skip = true
                                    end
                                    -- WINDOW GUARD: the Infinite Raid is only open for part of every
                                    -- hour (live RaidsConfig values). Queueing while it is shut just
                                    -- fails, so wait quietly instead of hammering the remote -- and the
                                    -- run starts by itself the moment the window opens.
                                    if not skip then
                                        local okW, isOpen = pcall(nexoInfWindow)
                                        if okW and isOpen == false then
                                            hardT = os.clock()
                                            skip = true
                                            task.wait(1)
                                        end
                                    end
                                end
                                if not skip then
                                doQueue()
                                -- the pad spawns a moment after the remote answers: grab it and TP the
                                -- INSTANT it appears (this is where the old code just stood still).
                                local t2 = os.clock()
                                while isOn() and NEXOG.NexoHubSession == SESSION and (os.clock() - t2) < 4 do
                                    local np = getPad()
                                    if np then
                                        local npp = nexoRaidPadPos(np)
                                        if npp then nexoPadHold(npp, 4) end
                                        break
                                    end
                                    if findBoss() then break end
                                    task.wait(0.05)
                                end
                                stallT = os.clock()
                                end
                            end
                        end
                    end
                end
            end
        end
        end)
        if not ok then
            NexoRaidLastErr = tostring(err) -- keep the last fault for debugging, never rethrow
            clearIsle()
            task.wait(0.5) -- backoff, then the supervisor restarts the whole flow
        end
      end
    end)

    -- Auto-click this raid's popups (safety net)
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION do
            if isOn() then
                clickPopup("next")
                clickPopup("close")
            end
            task.wait(isOn() and 0.3 or NEXO_IDLE) -- ORIGINAL speed while running, slow while idle
        end
    end)
end

