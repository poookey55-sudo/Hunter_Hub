end
function nexoValidNpc(m)
    if not m then return false end
    local h = m:FindFirstChild("HumanoidRootPart")
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not h or not hum or hum.Health <= 0 then return false end
    if nexoIsPlayerModel(m) then return false end
    if nexoIsPetModel(m) then return false end
    local bag = false
    pcall(function() if isPunchingBag and isPunchingBag(m) then bag = true end end)
    if bag then return false end
    return true
end
function nexoStrictNpcNear(pos, tags, radius)
    if not NPCsF or not pos then return nil end
    local r = radius or 25
    local best, bestD
    for _, m in ipairs(NPCsF:GetChildren()) do
        if nexoValidNpc(m) and nexoTextMatchesAnyTag(m.Name, tags) then
            local h = m:FindFirstChild("HumanoidRootPart")
            local dd = (h.Position - pos).Magnitude
            if dd <= r and (not bestD or dd < bestD) then best, bestD = m, dd end
        end
    end
    return best
end
-- ===================== BOSS / NPC DETECTION (hardened) =====================
-- Resolve the live, damageable SERVER model for a set of client name-tags.
--
-- What changed and why it is more reliable:
--   * NEAREST-WINS SCORING -- the old version returned the FIRST match it stumbled over, so with
--     two copies of a boss up (a respawn overlapping its corpse, or another player's instance)
--     it could lock onto the wrong one and sit there hitting nothing. Every candidate is now
--     scored by distance to YOU and the closest live one wins.
--   * SHORT-LIVED MEMO -- boss loops call this many times a second. A 0.25s memo returns the same
--     validated target instead of re-walking the folder, which is both faster and stops the target
--     flickering between frames. The memo is dropped the instant the model stops being valid, so a
--     death/respawn is picked up immediately rather than being cached.
--   * CACHED CLIENT WALK -- step 3 now uses the shared clientDesc() cache instead of a fresh
--     GetDescendants() walk on every single call (that walk was the detection lag).
--   * ALWAYS RE-VALIDATED -- health > 0 and a live parent are re-checked before anything is
--     returned, so a corpse can never be handed back as "the boss".
-- Search order is cheapest + most accurate first: server model name -> nameplate inside the server
-- model -> client rig nameplate mapped back to the nearest server NPC.
-- LEAK FIX: weak VALUES. This memo used to hold the last targeted NPC model with a strong
-- reference, so a despawned boss/NPC stayed resident until the next successful scan replaced
-- it. Over a multi-hour farm that pinned a long tail of dead rigs. Weak values let the GC
-- reclaim the model the instant the game drops it; the guards below already re-scan on miss.
NexoNpcMemo = setmetatable({ key = "", t = 0, m = nil }, { __mode = "v" })
function nexoNpcFromTags(tags)
    if not NPCsF or not tags or #tags == 0 then return nil end
    local key = table.concat(tags, "\1")
    local memo = NexoNpcMemo
    if memo.m and memo.key == key and (os.clock() - memo.t) < 0.25 and nexoValidNpc(memo.m) then
        return memo.m -- same target, still alive: no rescan needed
    end
    local myPos
    pcall(function()
        local m = getModel()
        local h = m and m:FindFirstChild("HumanoidRootPart")
        if h then myPos = h.Position end
    end)
    local best, bestD
    local function consider(m)
        if not m or not nexoValidNpc(m) then return end
        local h = m:FindFirstChild("HumanoidRootPart")
        if not h then return end
        local d = myPos and (h.Position - myPos).Magnitude or 0
        if not bestD or d < bestD then best, bestD = m, d end
    end
    -- 1) server model name match
    for _, m in ipairs(NPCsF:GetChildren()) do
        if nexoTextMatchesAnyTag(m.Name, tags) then consider(m) end
    end
    -- 2) nameplate carried inside the server model
    if not best then
        pcall(function()
            for _, m in ipairs(NPCsF:GetChildren()) do
                if nexoValidNpc(m) then
                    for _, d in ipairs(m:GetDescendants()) do
                        if d:IsA("TextLabel") and nexoTextMatchesAnyTag(d.Text, tags) then
                            consider(m)
                            break
                        end
                    end
                end
            end
        end)
    end
    -- 3) client rig nameplate -> nearest live server NPC to that rig
    if not best then
        pcall(function()
            local cf = Characters:FindFirstChild("Client")
            if not cf then return end
            for _, d in ipairs(clientLabels(cf)) do
                if d:IsA("TextLabel") and nexoTextMatchesAnyTag(d.Text, tags) then
                    local rig = d:FindFirstAncestorOfClass("Model")
                    if rig and not nexoIsPetModel(rig) then
                        if nexoValidNpc(rig) then
                            consider(rig)
                        else
                            local h = rig:FindFirstChild("HumanoidRootPart")
                            if h then consider(nexoStrictNpcNear(h.Position, tags, 25)) end
                        end
                    end
                end
            end
        end)
    end
    memo.key, memo.t, memo.m = key, os.clock(), best
    return best
end
-- Force the next detection to be a full rescan (used by the stall/respawn recovery paths).
function nexoForgetNpcMemo()
    NexoNpcMemo.key, NexoNpcMemo.m = "", nil
end
