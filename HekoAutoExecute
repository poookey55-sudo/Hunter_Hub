-- ROOT CAUSE (verified live in-game):
--   * Rigs in workspace.Characters.Server.Players are named with RANDOM ids
--     ("X74X26Nys86q_Server"), so nothing about a rig says which player owns it.
--   * The game passes its character as a TABLE (CharacterController.LocalCharacter),
--     never as an Instance. The __namecall hook below required
--     `typeof(info.LocalCharacter) == "Instance"`, which is NEVER true -> MyModel stayed nil.
--   * LocalPlayer.Character is also nil in this game.
--   * So getModel() ALWAYS fell through to "the rig closest to the camera" -- which is
--     frequently ANOTHER PLAYER. That single wrong value caused BOTH bugs:
--       - teleports (hrp.CFrame = goal) moved that other player instead of you
--       - DamageCharacter was sent with LocalCharacter = someone else's rig, so the
--         server rejected every hit => "NPC takes no damage".
-- FIX: ask the GAME who you are. CharacterController.LocalCharacter.ServerModel is the
-- authoritative rig. Two identity-anchored fallbacks follow, and only then the old
-- proximity guess (kept so nothing can stop working).
-- All new names are GLOBAL on purpose: the main chunk is near Luau's 200 local-register cap.

NexoCC = NexoCC or { t = -1, mod = nil }
-- the game's own CharacterController (require is cached by Roblox; re-checked every 5s)
function NexoCharacterController()
    local now = os.clock()
    if NexoCC.mod and (now - NexoCC.t) < 5 then return NexoCC.mod end
    local ok, mod = pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local cl = ps and ps:FindFirstChild("Client")
        local ct = cl and cl:FindFirstChild("Controllers")
        local cc = ct and ct:FindFirstChild("CharacterController")
        if cc then return require(cc) end
        return nil
    end)
    NexoCC.t = now
    if ok and type(mod) == "table" then NexoCC.mod = mod end
    return NexoCC.mod
end

-- the game's LocalCharacter object (a TABLE, not an Instance)
function NexoLocalChar()
    local cc = NexoCharacterController()
    if not cc then return nil end
    local ok, lc = pcall(function() return cc.LocalCharacter end)
    if ok and type(lc) == "table" then return lc end
    return nil
end

NexoOwnMemo = NexoOwnMemo or { m = nil, t = -1 }
-- YOUR server rig, resolved by identity. Memoized ~0.25s and revalidated, so the
-- RenderStepped loops stay as cheap as before.
function NexoOwnServerModel()
    local now = os.clock()
    local c = NexoOwnMemo
    if c.m and c.m.Parent == PlayersF and (now - c.t) < 0.25 then return c.m end
    local m

    -- A) AUTHORITATIVE: the game itself tells us which rig is ours
    local lc = NexoLocalChar()
    if lc then
        pcall(function()
            local sm = lc.ServerModel
            if typeof(sm) == "Instance" and sm.Parent == PlayersF then m = sm end
        end)
    end

    -- B) your CLIENT rig IS name-tagged ("<YourName>_Client") and your server rig sits
    --    exactly on top of it (measured distance ~0.000015 studs), so this is an exact,
    --    identity-anchored match -- not a "nearest to camera" guess.
    if not m then
        pcall(function()
            local cf = workspace:FindFirstChild("Characters")
            local clientF = cf and cf:FindFirstChild("Client")
            local myC = clientF and (clientF:FindFirstChild(LocalPlayer.Name .. "_Client")
                or clientF:FindFirstChild((LocalPlayer.DisplayName or LocalPlayer.Name) .. "_Client"))
            local ch = myC and myC:FindFirstChild("HumanoidRootPart")
            if not ch then return end
            local best, bd
            for _, sm in ipairs(PlayersF:GetChildren()) do
                local sh = sm:FindFirstChild("HumanoidRootPart")
                if sh then
                    local d = (sh.Position - ch.Position).Magnitude
                    if not bd or d < bd then best, bd = sm, d end
                end
            end
            if best and bd and bd <= 8 then m = best end -- must be ON your client rig
        end)
    end

    if m then c.m, c.t = m, now return m end
    return nil
end

NexoModelMemo = NexoModelMemo or { m = nil, t = -1 } -- see the fallback note below
local function getModel()
    -- 1) IDENTITY (correct in this game). This is the fix.
    local mine = NexoOwnServerModel()
    if mine then MyModel = mine return mine end

    -- 2) previously captured model / normal Roblox character
    if MyModel and MyModel.Parent == PlayersF then return MyModel end
    local char = LocalPlayer.Character
    if char and char.Parent == PlayersF then MyModel = char return char end

    local refPos
    if char and char:FindFirstChild("HumanoidRootPart") then
        refPos = char.HumanoidRootPart.Position
    elseif workspace.CurrentCamera then
        refPos = workspace.CurrentCamera.CFrame.Position
    end
    if refPos then
        -- LAST RESORT ONLY (steps 1 and 2 now succeed in normal play). Unchanged behaviour,
        -- memoized for one frame-window exactly as before.
        local now = os.clock()
        local mc = NexoModelMemo
        if mc.m and mc.m.Parent and (now - mc.t) < 0.05 then return mc.m end
        local best, bestD
        for _, m2 in ipairs(PlayersF:GetChildren()) do
            local hrp = m2:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = hrp.Position -- squared distance: same winner, no sqrt per rig
                local dx, dy, dz = p.X - refPos.X, p.Y - refPos.Y, p.Z - refPos.Z
                local d = dx * dx + dy * dy + dz * dz
                if not bestD or d < bestD then best, bestD = m2, d end
            end
        end
        mc.m, mc.t = best, now
        return best
    end
    return nil
end

--========================================================--
--  MY ISLAND FILTER  (only hit NPCs on YOUR boss island)
--========================================================--
-- In SummerSiege / boss-island raids, every player is teleported to their OWN copy of the island
-- (see workspace.Map.Geometry.BossIslands -> several SummerSiege models). The summer-NPC name-tags
-- are IDENTICAL on every island, so name-matching alone ALSO grabs other players' NPCs. This filter
-- assigns each NPC (and YOU) to the nearest island model, then only keeps NPCs sitting on the SAME
-- island you're standing on. NPCs that aren't on any island (normal open world) are left untouched,
-- so nothing else about your targeting changes.
MY_ISLAND_ONLY = true      -- master switch (also wired to a GUI toggle in the Summer Raid section)
local ISLAND_MARGIN = 60   -- studs of slack added around each island's bounding sphere

-- locate workspace.Map.Geometry.BossIslands (cached ~3s; falls back to a name scan)
IslandFolderCache = { t = -1, folder = nil }
local function getBossIslandsFolder()
    local now = os.clock()
    local f = IslandFolderCache.folder
    if f and f.Parent and (now - IslandFolderCache.t) < 3 then return f end
    f = nil
    local map = workspace:FindFirstChild("Map")
    local geo = map and map:FindFirstChild("Geometry")
    if geo then f = geo:FindFirstChild("BossIslands") end
    if not f then
        for _, d in ipairs(wsDesc()) do
            if d.Name == "BossIslands" and (d:IsA("Folder") or d:IsA("Model")) then f = d break end
        end
    end
    IslandFolderCache.folder = f
    IslandFolderCache.t = now
    return f
end

-- center + radius of every island model (cached ~2s; islands don't move but new ones can spawn)
IslandListCache = { t = -1, list = {} }
local function getIslandList()
    local now = os.clock()
    if IslandListCache.t >= 0 and (now - IslandListCache.t) < 2 then return IslandListCache.list end
    local list = {}
    local folder = getBossIslandsFolder()
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") then
                local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
                if ok and cf and size then
                    table.insert(list, {
                        model  = m,
                        cf     = cf,
                        center = cf.Position,
                        half   = (size * 0.5) + Vector3.new(ISLAND_MARGIN, ISLAND_MARGIN, ISLAND_MARGIN),
                    })
                end
            end
        end
    end
    IslandListCache.list = list
    IslandListCache.t = now
    return list
end

-- nearest island (by center) to a world position + that distance
local function nearestIsland(pos)
    local best, bestD
    for _, isl in ipairs(getIslandList()) do
        local d = (isl.center - pos).Magnitude
        if not bestD or d < bestD then best, bestD = isl, d end
    end
    return best, bestD
end

-- which island a position actually SITS INSIDE (oriented bounding box), or nil if it's open-world.
-- The box test is far more precise than a sphere, so an NPC on a NEIGHBOURING island is never
-- mistaken for yours even when the islands are packed close together.
local function islandOf(pos)
    local best, bestD
    for _, isl in ipairs(getIslandList()) do
        local rel = isl.cf:PointToObjectSpace(pos)
        if math.abs(rel.X) <= isl.half.X and math.abs(rel.Y) <= isl.half.Y and math.abs(rel.Z) <= isl.half.Z then
            local d = (isl.center - pos).Magnitude
            if not bestD or d < bestD then best, bestD = isl, d end
        end
    end
    return best
end

-- YOUR island = the one you're standing on (fallback: the nearest one). Cached ~0.4s.
MyIslandCache = { t = -1, isl = nil }
local function myIsland()
    local now = os.clock()
    if MyIslandCache.t >= 0 and (now - MyIslandCache.t) < 0.4 then return MyIslandCache.isl end
    local isl = nil
    local mdl = getModel()
    local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
    if hrp then
        isl = islandOf(hrp.Position) or (nearestIsland(hrp.Position))
    end
    MyIslandCache.isl = isl
    MyIslandCache.t = now
    return isl
end

-- TRUE if a target at `pos` is allowed: same island as you, OR not on any island (open world).
-- If there are 0/1 islands, or we can't resolve your island, allow everything (acts as a no-op).
function onMyIsland(pos)
    if not MY_ISLAND_ONLY then return true end
    local islands = getIslandList()
    if #islands <= 1 then return true end        -- nothing to separate
    local mine = myIsland()
    if not mine then return true end
    local here = islandOf(pos)
    if not here then return true end             -- open-world NPC -> unaffected
    return here.model == mine.model
end

--========================================================--
--  TARGETING + ATTACK
--========================================================--
-- Ignore this practice-dummy NPC EVERYWHERE targets/bring/attack lists are built (Bring Inf Range,
-- Bring Gojo, Bring Boss, Auto Summer NPC, Kill Aura / general Bring, Fast Attack, raids, etc.) --
-- it should never be pulled to you or attacked. Declared GLOBAL so every collection function can use
-- it. Uses the SAME 3-strategy name check as Boss Hunter (the server model's raw Name is often NOT
-- the display name, so we also read the nameplate text, same as how bosses are identified):
--   A) the server model's own .Name
--   B) a TextLabel nameplate attached directly under the server model itself
--   C) a TextLabel nameplate in the separate client-side "Client" replica folder, matched to the
--      server model by proximity (cached ~0.2s so every NPC check stays cheap in tight loops)
IGNORED_NPC_NAMES = { "lv.1 punching bag", "punching bag" }
local function textMatchesIgnored(txt)
    local low = string.lower(txt)
    for _, ig in ipairs(IGNORED_NPC_NAMES) do
        if string.find(low, ig, 1, true) then return true end
    end
    return false
end
PunchingBagPosCache = { t = -1, list = {} }
function refreshPunchingBagPositions()
    local now = os.clock()
    if PunchingBagPosCache.t >= 0 and (now - PunchingBagPosCache.t) < 0.2 then
        return PunchingBagPosCache.list
    end
    local list = {}
    local ok = pcall(function()
        local ClientF = Characters:FindFirstChild("Client")
        if not ClientF then return end
        for _, d in ipairs(clientLabels(ClientF)) do
            if d:IsA("TextLabel") and textMatchesIgnored(d.Text) then
                local rig = d:FindFirstAncestorWhichIsA("Model")
                local h = rig and rig:FindFirstChild("HumanoidRootPart")
                if h then table.insert(list, h.Position) end
            end
        end
    end)
    if ok then
        PunchingBagPosCache.list = list
        PunchingBagPosCache.t = now
    end
    return PunchingBagPosCache.list
end
-- Characters > Server > Shikigami holds OTHER PLAYERS pet shikigami. Nothing in this folder may
-- ever be attacked or teleported to, by ANY feature.
NEXO_PET_FOLDER = "Shikigami"
NexoPetSet = {}      -- [model] = true and [base name] = true, refreshed twice a second
NexoPetScanAt = 0
function nexoBaseName(n)
    n = string.lower(tostring(n or ""))
    n = string.gsub(n, "_server$", "")
    n = string.gsub(n, "_client$", "")
    return n
end
function nexoRefreshPets()
    if os.clock() - NexoPetScanAt < 0.5 then return end
    NexoPetScanAt = os.clock()
    local set = {}
    pcall(function()
        local sf = Characters:FindFirstChild("Server")
        local pf = sf and sf:FindFirstChild(NEXO_PET_FOLDER)
        if not pf then return end
        for _, m in ipairs(pf:GetChildren()) do
            set[m] = true
            local b = nexoBaseName(m.Name)
            if #b > 0 then set[b] = true end
        end
    end)
    NexoPetSet = set
end
function nexoIsPetModel(m)
    if not m then return false end
    nexoRefreshPets()
    local pet = false
    pcall(function()
        if NexoPetSet[m] then pet = true return end
        if m:FindFirstAncestor(NEXO_PET_FOLDER) then pet = true return end
        local par = m.Parent
        while par do
            if par.Name == NEXO_PET_FOLDER then pet = true return end
            par = par.Parent
        end
        if NexoPetSet[nexoBaseName(m.Name)] then pet = true end
    end)
    return pet
end
-- LAST LINE OF DEFENCE: strip pets out of any target list right before damage is sent, so it
-- does not matter which feature picked the target -- a pet can never be hit.
function nexoFilterPets(targets)
    if type(targets) ~= "table" then return targets end
    local out = {}
    for _, m in ipairs(targets) do
        if not nexoIsPetModel(m) then out[#out + 1] = m end
    end
    return out
end
-- Reads the highest "Lv.<n>" found on a model (own name first, then its nameplates).
-- Returns nil when no level is shown anywhere.
NexoLvCache = NexoLvCache or {}
NexoLvCacheAt = NexoLvCacheAt or 0
function nexoLevelOf(m)
    if not m then return nil end
    local now = os.clock()
    if (now - NexoLvCacheAt) > 1 then NexoLvCache, NexoLvCacheAt = {}, now end
    local hit = NexoLvCache[m]
    if hit ~= nil then
        if hit == false then return nil end
        return hit
    end
    local lv
    local function grab(s)
        if not s then return end
        local n = string.match(string.lower(tostring(s)), "lv%.?%s*(%d+)")
        n = n and tonumber(n)
        if n and (not lv or n > lv) then lv = n end
    end
    pcall(function()
        grab(m.Name)
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("TextLabel") then grab(d.Text) end
        end
    end)
    NexoLvCache[m] = (lv == nil) and false or lv
    return lv
end
-- Only a Lv.1 shikigami is a real target. Anything Lv.2+ is another player pet.
function nexoIsLv1(m)
    local lv = nexoLevelOf(m)
    return lv == nil or lv <= 1
end
function isPunchingBag(m)
    if not m then return false end
    -- Strategy A: the server model's own Name
    local ok, nm = pcall(function() return m.Name end)
    if ok and nm and textMatchesIgnored(nm) then return true end
    -- Strategy B: a nameplate TextLabel attached directly under this server model
    local ok2, hitB = pcall(function()
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("TextLabel") and textMatchesIgnored(d.Text) then return true end
        end
        return false
    end)
    if ok2 and hitB then return true end
    -- Strategy C: separate client-side nameplate folder, matched to this model by proximity
    local ok3, hitC = pcall(function()
        local h = m:FindFirstChild("HumanoidRootPart")
        if not h then return false end
        for _, pos in ipairs(refreshPunchingBagPositions()) do
            if (h.Position - pos).Magnitude < 25 then return true end
        end
        return false
    end)
    if ok3 and hitC then return true end
    return false
end
function computeTargets(range)
    range = range or ATTACK_RANGE
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {}, nil, nil end
    -- OUTER RAID SEQUENCE: while we're voiding the boss, return NO targets so EVERY fast attack / fast
    -- skill / Black Flash and the engine all pause for a beat. Sequence = attacks OFF -> boss TP'd to
    -- the void -> attacks resume (start killing the NPCs). Also stops anything chasing the boss out.
    if outerVoidPausing then return {}, myModel, myHRP end
    local myPos = myHRP.Position
    local targets = {}
    local function scan(folder)
        if not folder then return end
        for _, m in ipairs(folder:GetChildren()) do
            if m ~= myModel and not isPunchingBag(m) and not nexoIsPetModel(m) then
                local h = m:FindFirstChild("HumanoidRootPart")
                local hum = m:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 and (h.Position - myPos).Magnitude <= range and onMyIsland(h.Position) then
                    table.insert(targets, m)
                end
            end
        end
    end
    scan(NPCsF)
    if HIT_PLAYERS then scan(PlayersF) end
    -- Outer World raid PRIORITY: while any "Star Remnant" add is alive, force EVERY skill/attack
    -- (Fast Attack, Black Flash, Inf Aura, Copy, Star Rage, etc.) to target ONLY the adds, so nothing
    -- stays locked on the Awakened Star boss. Falls back to normal targeting once the adds are dead.
    if AutoOuterRaidOn then
        -- PERF: the heavy scan (client name-tag descendants + every server folder) is done by a
        -- background refresher ~10x/sec that fills outerAddCache. Here we only do a CHEAP liveness
        -- re-check + nearest-first sort on that small cached list, so every skill still fires every
        -- frame at full speed instead of rescanning the whole workspace dozens of times per frame.
        -- Identical targeting logic -- just cached so it isn't recomputed on every call. The boss
        -- (outerBossModel) is maintained by the same refresher.
        local cached = outerAddCache
        if cached and #cached > 0 then
            local adds = {}
            for _, m in ipairs(cached) do
                if m and m.Parent and not isPunchingBag(m) and not nexoIsPetModel(m) then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then table.insert(adds, m) end -- NPCs AND parts (no Humanoid)
                end
            end
            if #adds > 0 then
                local function posOf(x)
                    local p = x:FindFirstChild("HumanoidRootPart") or (x:IsA("Model") and x.PrimaryPart)
                    return p and p.Position or nil
                end
                table.sort(adds, function(a, b)
                    local ap, bp = posOf(a), posOf(b)
                    local ad = ap and (ap - myPos).Magnitude or math.huge
                    local bd = bp and (bp - myPos).Magnitude or math.huge
                    return ad < bd
                end)
                return adds, myModel, myHRP
            end
        end
    end
    -- SHADOW RAID PRIORITY: force EVERY skill/attack (Fast Attack, Black Flash, Inf Aura, Copy,
    -- Star Rage, ...) onto the models the Shadow Raid picked for the current phase -- the adds, the
    -- 350-radius wipe list, or the boss only while it is actually killable. This is what stops
    -- everything from staying locked on the [Immune] Lv.1 Shadow Sorcerer.
    if AutoShadowRaidOn and (shadowRaidBossLocked or (type(shadowRaidAddCache) == "table" and #shadowRaidAddCache > 0)) then
        local lock = {}
        for _, m in ipairs(shadowRaidAddCache) do
            if m and m.Parent and m ~= myModel and not isPunchingBag(m) and not nexoIsPetModel(m) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health > 0 then table.insert(lock, m) end
            end
        end
        if #lock > 0 then
            local function shPos(x)
                local p = x:FindFirstChild("HumanoidRootPart") or (x:IsA("Model") and x.PrimaryPart)
                return p and p.Position or nil
            end
            table.sort(lock, function(a, b)
                local ap, bp = shPos(a), shPos(b)
                local ad = ap and (ap - myPos).Magnitude or math.huge
                local bd = bp and (bp - myPos).Magnitude or math.huge
                return ad < bd
            end)
            return lock, myModel, myHRP
        end
        -- [Immune] HARD BLOCK: the HUD says the boss is immune but we have no add picked yet ->
        -- return NOTHING. Every attack/skill goes silent for that tick instead of falling back to
        -- normal targeting (which is what kept snapping back onto the immune boss).
        if shadowRaidBossLocked then return {}, myModel, myHRP end
    end
    return targets, myModel, myHRP
end
-- PERF (no logic change): 30+ fast-skill / attack loops call collectTargets() with NO range every
-- frame, and each call rescans every NPC -- that redundant scanning is the main cause of Fast-*
-- lag. This wrapper reuses the result computed within the last frame (~25ms) for the default-range
-- (no-arg) calls, so targeting is IDENTICAL but the NPC scan runs once per frame instead of dozens
-- of times. Calls that pass an explicit range (e.g. getNearest) always compute fresh and never
-- touch the cache. Cache is global to avoid using scarce main-chunk local registers.
TgtCache = TgtCache or {}
local function collectTargets(range)
    if range == nil then
        local now = os.clock()
        if TgtCache.a and (now - (TgtCache.t or 0)) < TGT_CACHE_SEC then
            return TgtCache.a, TgtCache.b, TgtCache.c
        end
        local a, b, c = computeTargets(nil)
        -- Only cache a REAL result. If we momentarily have no character (b == nil, e.g. mid-respawn)
        -- skip caching so the very next call recomputes instead of returning "no targets" -- this
        -- guarantees the cache can never briefly starve attacks/skills.
        if b then
            TgtCache.a, TgtCache.b, TgtCache.c, TgtCache.t = a, b, c, now
        end
        return a, b, c
    end
    return computeTargets(range)
end

-- PERF (no behaviour change): every fast-skill / attack loop used to allocate TWO closures AND a
-- coroutine on EVERY tick -- 30+ loops x 20 Hz is well over a thousand short-lived objects per
-- second, which is pure GC churn and the source of the periodic micro-stutter. The loops now hand
-- their work to these pre-allocated dispatchers and pass the target function / skill id as an
-- ARGUMENT, so only the thread itself is created. Same functions, same order, same rate gates,
-- same pcall protection, same yielding behaviour.
function NexoRunList(fn) fn(collectTargets()) end
function NexoListJob(fn) NexoBusyT = os.clock() pcall(NexoRunList, fn) end
function NexoRunNamed(fn, name) fn(name, collectTargets()) end
function NexoNamedJob(fn, name) NexoBusyT = os.clock() pcall(NexoRunNamed, fn, name) end
-- Idle throttle: while ANY hot feature is dispatching, every loop keeps its original LOOP_GAP
-- cadence (identical timing, identical rate gates, identical remote pacing). Once nothing has
-- dispatched for a full second (all toggles off), those loops park at 5 Hz instead of 20 Hz so
-- an idle NexoHub stops waking the scheduler hundreds of times a second. The first dispatch
-- after a toggle re-arms full speed immediately.
NexoBusyT = 0
NEXO_IDLE_GAP = 0.2
function NexoGap()
    return (os.clock() - NexoBusyT < 1) and LOOP_GAP or NEXO_IDLE_GAP
end

local function getNearest(range)
    local targets, myModel, myHRP = collectTargets(range)
    if not myHRP or #targets == 0 then return nil, myModel, myHRP end
    local nearest, nd
    for _, m in ipairs(targets) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local d = (h.Position - myHRP.Position).Magnitude
            if not nd or d < nd then nearest, nd = m, d end
        end
    end
    return nearest, myModel, myHRP
end

local combo = 1
-- StartSkill (the animation/cast trigger) throttle: spamming StartSkill for the SAME move dozens of
-- times per second is a big chunk of the remote flood that trips the anti-spam (damage stops after a
-- while). We keep DamageCharacter firing EVERY cast (so attack speed / damage cadence is UNCHANGED)
-- but only re-trigger StartSkill ~7x/sec per move. Shared across every loop, so Fast Attack + Kill
-- Aura no longer double-fire the same StartSkill.
startLast = {}
START_GAP = 0.15
function startReady(key)
    if NEXO_RAMPAGE_ON then return true end -- MAX POTENTIAL: re-trigger the cast every time
    local now = os.clock()
    local last = startLast[key]
    if last and (now - last) < START_GAP then return false end
    startLast[key] = now
    return true
end
-- DAMAGE-RATE CAP: the server rate-limits the damage remote; spamming it 30-60x/sec makes it STOP
-- registering hits after a while. Cap each move's damage remote to ~20x/sec (still near-instant kills)
-- so the server keeps accepting our hits indefinitely. Per-move key so moves never starve each other.
dmgLast = {}
DMG_GAP = 0.05
function damageReady(key)
    if NEXO_RAMPAGE_ON then return true end -- MAX POTENTIAL: uncapped damage remote
    local now = os.clock()
    local last = dmgLast[key]
    if last and (now - last) < DMG_GAP then return false end
    dmgLast[key] = now
