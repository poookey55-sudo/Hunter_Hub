local QuestOn = false

-- The quest mob's NAME tag lives on its CLIENT rig (workspace.Characters.Client),
-- NOT the server model we attack. So we read names from client rigs, then match the
-- server NPCs to them by position. This targets ONLY the quest mobs.
-- read the current quest's target enemy from the quest tracker text ("Defeat X (n/m)")
-- ANTI-LAG (Auto Quest / Fast Quest stutter fix): these three scans used to run
-- ~33x/sec and each one walked EVERY PlayerGui / Client-rig descendant, which is
-- what caused the "smooth -> lag -> smooth" hitching. They are now cached, so the
-- heavy walks happen a few times per second. Results are identical.
-- ANTI-LAG (Auto Quest, biggest remaining CPU cost): all three scans are CACHED now.
-- BEFORE: questTarget() walked EVERY PlayerGui descendant and ran a pattern match on each label --
-- and it was called TWICE per collectQuestNPCs(), which itself ran 33x/sec from the quest loop plus
-- the two bring loops = ~100 full GUI walks per second, every one of them a lag spike.
-- NOW (identical results, a small fraction of the work):
--   * tracker name : re-read from the ONE remembered tracker TextLabel; a full GUI walk happens at
--                    most once per second (and instantly whenever that label goes away)
--   * name-tags    : one pass per CLIENT_SCAN_SEC window, shared by every caller
--   * NPC match    : one pass per TGT_CACHE_SEC window (the SAME window Kill Aura already uses),
--                    cheapest test first, squared distances (no sqrt), island/bag checks only for
--                    the NPCs that already matched a name-tag
-- Kept GLOBAL so it costs no main-chunk local register (near Luau's 200 cap).
QuestScanCache = QuestScanCache or {
    nameT = -1, fullT = -1, name = "", lbl = nil,   -- quest tracker text
    posT = -1, posKey = nil, pos = {},              -- name-tag positions
    npcT = -1, a = nil, b = nil, c = nil,           -- matched NPC list
}
function questParseName(txt) -- EXACTLY the original parse, just factored out
    local nm = string.match(txt, "([%a%s]+)%s*%(%d+/%d+%)")
    if not nm or #nm <= 2 then return nil end
    nm = nm:gsub("^%s+", ""):gsub("%s+$", "")
    nm = nm:gsub("^[Dd]efeat%s+the%s+", ""):gsub("^[Dd]efeat%s+", ""):gsub("^[Kk]ill%s+", ""):gsub("^[Cc]ollect%s+", "")
    nm = nm:gsub("s$", "") -- singularize (Students -> Student)
    return nm
end
-- ===== QUEST SOURCE OF TRUTH (replaces the quest-tracker GUI text scrape) =====
-- BEFORE: the only source of the quest target was the HUD text ("Defeat X (n/m)"), which meant
-- walking every PlayerGui descendant and pattern-matching labels, plus guessing at plurals and
-- "Defeat the " prefixes. The game already knows the answer, so ask it directly:
--   QuestController:GetActiveQuest() -> QuestConfig.Quests[id] -> NPCConfig.NPCs[EnemyID].Name
-- Zero GUI walks, exact IDs, works before the HUD even renders. The old GUI path is kept below
-- as a last-resort fallback so nothing can regress.
NexoQMods = NexoQMods or { t = -1 }
function NexoQuestMods()
    local m, now = NexoQMods, os.clock()
    if m.ok and (now - m.t) < 5 then return m end
    m.t = now
    local Ctrl = LocalPlayer:FindFirstChild("PlayerScripts")
    Ctrl = Ctrl and Ctrl:FindFirstChild("Client")
    Ctrl = Ctrl and Ctrl:FindFirstChild("Controllers")
    if not Ctrl then return m end
    pcall(function() m.QC = require(Ctrl.QuestController) end)
    pcall(function() m.QCfg = require(RepStorage.Configs.QuestConfig) end)
    pcall(function() m.NPCc = require(RepStorage.Configs.NPCConfig) end)
    pcall(function() m.Interact = require(Ctrl.InterfaceController.Interfaces.Interact) end)
    -- AIController.ActiveAIs is the authoritative live NPC list: every entry carries the
    -- NPC ServerModel, which is the object the server actually scores. See NexoAIBring.
    pcall(function() m.AIC = require(Ctrl.AIController) end)
    m.ok = (m.QC ~= nil and m.QCfg ~= nil)
    return m
end

-- Active quest -> { id, kind = "Enemies" | "Fetch" | other, name = enemy display name }
-- Cached 0.5s: the quest can only change on an accept/turn-in, so this is plenty fresh.
NexoQInfo = NexoQInfo or { t = -1, id = nil, kind = "", name = "" }
function NexoQuestInfo()
    local q, now = NexoQInfo, os.clock()
    if (now - q.t) < 0.5 then return q end
    q.t = now
    local m = NexoQuestMods()
    if not m.ok then q.id, q.kind, q.name = nil, "", "" return q end
    local id
    pcall(function() id = m.QC:GetActiveQuest() end)
    -- fall back to the focused RCT/INF quest, then YOUR hub selection -- never a guess
    if not id then id = NexoRctQuestId() or currentQuestId() end
    q.id = id
    local cfg = id and m.QCfg.Quests and m.QCfg.Quests[id]
    if not cfg then q.kind, q.name = "", "" return q end
    local ty = cfg.Type
    if ty == "Fetch" or ty == "NewFetch" then
        q.kind, q.name = "Fetch", ""
    elseif ty == "Enemies" then
        local eid = cfg.EnemyID
        pcall(function()
            local s = m.QC:GetSavedQuest(id)
            if s and s.EnemyID then eid = s.EnemyID end -- saved data wins (scaled/rerolled quests)
        end)
        local e = eid and m.NPCc and m.NPCc.NPCs and m.NPCc.NPCs[eid]
        q.kind, q.name = "Enemies", (e and e.Name) or ""
    else
        q.kind, q.name = tostring(ty), ""
    end
    return q
end

-- ===== PROGRESS / POINT QUESTS ("Obtain 300 Points (0/300)") =====
-- These are Type == "Capture". The required amount is NEVER assumed: it is read from
-- QuestConfig.Quests[id].PointRequirement, so 100 / 300 / 500 / 1500 all work automatically.
-- Live score is SavedQuest.Points. The area is resolved the exact way the game does it:
--   workspace.Container.QuestAreas.Capture[SavedQuest.CaptureID]
-- The CaptureID on the SAVED quest is a RUNTIME id (e.g. "RffW96D65P3g"), NOT the config's
-- "CapQuest3" -- looking up the config id would never find the area.
NexoSkipCap = NexoSkipCap or false
NexoCapI = NexoCapI or { t = -1 }
function NexoCapInfo()
    local c, now = NexoCapI, os.clock()
    if (now - c.t) < 0.3 then return c end -- cached: the hot path is one clock compare
    c.t = now
    c.on, c.pos, c.rad, c.need, c.pts, c.done = false, nil, 0, 0, 0, false
    local m = NexoQuestMods()
    if not m.ok then return c end
    local id
    pcall(function() id = m.QC:GetActiveQuest() end)
    if not id then id = NexoRctQuestId() or currentQuestId() end
    local cfg = id and m.QCfg.Quests and m.QCfg.Quests[id]
    if not cfg or cfg.Type ~= "Capture" then c.names = nil return c end
    c.on, c.id = true, id
    c.need = tonumber(cfg.PointRequirement) or 0
    local saved
    pcall(function() saved = m.QC:GetSavedQuest(id) end)
    c.pts  = (saved and tonumber(saved.Points)) or 0
    c.done = (c.need > 0 and c.pts >= c.need)
    local capId = (saved and saved.CaptureID) or cfg.CaptureID
    if capId then
        local area
        pcall(function()
            area = workspace.Container.QuestAreas.Capture:FindFirstChild(capId)
        end)
        if area then
            local pp = area.PrimaryPart or area:FindFirstChildWhichIsA("BasePart")
            if pp then c.pos, c.rad = pp.Position, pp.Size.X * 0.45 end
        end
    end
    local names, seen = {}, {}
    local function add(eid)
        local e = eid and m.NPCc and m.NPCc.NPCs and m.NPCc.NPCs[eid]
        local nm = e and e.Name and string.lower(e.Name)
        -- TRIM: several configs carry a trailing space (q2mob2.Name == "Cursed Camper ").
        -- The name-tag test is a plain substring find, so an untrimmed needle matches nothing
        -- and that enemy type is silently skipped by both targeting and bring.
        if nm then nm = string.match(nm, "^%s*(.-)%s*$") end
        if nm and nm ~= "" and not seen[nm] then seen[nm] = true names[#names + 1] = nm end
    end
    if type(cfg.EnemyIDs) == "table" then for _, eid in pairs(cfg.EnemyIDs) do add(eid) end end
    add(cfg.EnemyID)
    if saved then add(saved.EnemyID) end
    c.names = names
    return c
end


-- ---------------------------------------------------------------------------------------------
-- CAPTURE-QUEST SCORING FIX (Train I-III / Endurance I-III / StarCult2_1 / GojoInf1 / all Capture)
-- ---------------------------------------------------------------------------------------------
-- Symptom that this fixes: the quest tracker sat at 0/1000 forever even though quest NPCs were
-- being brought in and killed nonstop.
--
-- ROOT CAUSE (read live from the game, not guessed):
--   ReplicatedStorage.Configs.QuestConfig.CaptureQuest = {
--       EnemyInAreaPoints = 1,    -- +1 point per quest enemy that is INSIDE the area ...
--       PointsInterval    = 2,    -- ... awarded every 2 seconds
--       EnemyKilledPoints = 15,   -- +15 points per quest enemy KILLED INSIDE the area
--   }
-- The server only scores enemies that are standing inside
--   workspace.Container.QuestAreas.Capture[SavedQuest.CaptureID].Bounds
-- (an ~82 stud cube, so a usable radius of ~37 studs from the centre).
--
-- Every "bring" loop in this hub stacks the quest NPCs in a ring around the PLAYER. That is
-- correct for Enemies/kill-count quests, but for a Capture quest it means the NPCs get dragged to
-- wherever the player happens to be. If the player is not standing inside the Bounds, then every
-- single NPC is pulled OUT of the scoring volume, so the server awards 0 in-area points and 0 kill
-- points -- the kills are real, they just do not belong to the quest. Hence a permanent 0/1000.
--
-- THE FIX: while a Capture quest is active and unfinished, keep the PLAYER inside the Bounds.
-- Because the bring loops ring the NPCs around the player (BRING_OFFSET = 4 studs, far smaller
-- than the ~37 stud radius), anchoring the player inside the area automatically drops every
-- brought NPC inside the scoring volume too. Points then tick from BOTH sources: +1 per NPC every
-- 2s just for holding them there, and +15 for each one killed.
--
-- Nothing here fires a remote, so there is no remote spam and nothing to desync: it is purely a
-- position correction on our own character, which is exactly what the existing bring loops already
-- do. Non-Capture quests are untouched -- NexoCapPoint() returns nil for them and every hook below
-- becomes a single nil check.
-- Declared GLOBAL (no `local`) to avoid consuming main-chunk local registers (near Luau's 200 cap).

NEXO_CAP_DRIFT = 0.45   -- re-centre once we are past 45% of the area radius (bring loops)
NEXO_CAP_LEASH = 0.75   -- the background leash is looser so it never fights Fast Quest / tweens
NEXO_CAP_LIFT  = 6      -- stand this far above the area centre so we never spawn inside terrain
NEXO_CAP_TICK  = 0.2    -- background leash cadence

-- Returns centre, radius for the ACTIVE, UNFINISHED capture area -- or nil for anything else.
-- NexoCapInfo() is already cached (0.3s), so this is cheap enough to call every bring frame.
function NexoCapPoint()
    local c = NexoCapInfo()
    if not c.on or c.done then return nil end
    if not c.pos or (c.rad or 0) <= 0 then return nil end
    return c.pos, c.rad
end

-- Put/keep the character inside the capture Bounds. `slack` is the fraction of the radius we
-- tolerate before snapping back to the centre. Returns true if a correction was applied.
function NexoCapKeepInside(hrp, slack)
    if not hrp then return false end
    local pos, rad = NexoCapPoint()
    if not pos then return false end
    -- While the supervisor is off fetching mobs from a spawn node, do NOT drag us back to the
    -- area -- that is what made the quest unwinnable: pinned in an empty volume forever.
    if NexoCapPhase == "gather" then return false end
    -- ROAM: the hunt worker is walking us around inside the volume on purpose. Re-centring
    -- us every pass is exactly the "standing still in one spot" behaviour we are replacing,
    -- and the roam worker already clamps itself inside the area, so stay out of its way.
    if NexoCapPhase == "roam" then return false end
    local d = hrp.Position - pos
    local flat = Vector3.new(d.X, 0, d.Z).Magnitude
    if flat <= rad * (slack or NEXO_CAP_DRIFT) and math.abs(d.Y) <= rad * 0.5 then
        return false -- already comfortably inside the scoring volume: leave the player alone
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, NEXO_CAP_LIFT, 0))
    end)
    return true
end

local function questTarget()
    if QUEST_TARGET ~= "" then return QUEST_TARGET end
    local cap = NexoCapInfo()
    if cap.on then return (cap.names and cap.names[1]) or "" end -- point quest: use its enemy set
    local qi = NexoQuestInfo() -- authoritative name straight from the game data
    if qi.name ~= "" then return qi.name end
    if qi.kind == "Fetch" then return "" end -- collectible quest: there is no enemy to match
    local qc, now = QuestScanCache, os.clock()
