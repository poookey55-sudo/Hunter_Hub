--   FireDelay 0.383, InitialDelay 0.2, ProjectileSpeed 140, MaxCursorDistance 500,
--   ProjectileHitboxSize Vector3(75, 35, 35), AutoTargetMaxDistance 125.
--   The game's own AI sends (targetPrimaryPart.Position - myPrimaryPart.Position) * Vector3(1,0,1).
-- So a FIXED vector always sends the slash the same way in world space, which is exactly why it
-- flew off and never hit anything. NexoSMAim() below builds that same direction to the nearest
-- target instead, and it is only kept as the last-resort fallback.
NEXO_SM_RANGE = 500   -- live MaxCursorDistance of ShrineSlash (how far the projectile travels)

-- your rig, same path as your capture: workspace.Characters.Server.Players.<your model>
function NexoSMModel()
    local m = NexoOwnServerModel()
    if m and m.Parent then return m end
    local ok, r = pcall(function()
        local f = workspace:WaitForChild("Characters"):WaitForChild("Server"):WaitForChild("Players")
        local lc = NexoLocalChar()
        local sm = lc and lc.ServerModel
        if typeof(sm) == "Instance" and sm.Parent == f then return sm end
        return nil
    end)
    if ok then return r end
    return nil
end

-- aim: direction from you to the closest target, flattened on Y exactly like the game's own
-- AttackTarget component does ((target.Position - my.Position) * Vector3(1,0,1)), plus the same
-- tiny epsilon SkillController adds before it sends the call so the vector is never zero-length.
function NexoSMAim(model)
    local targets, myModel, myHRP = collectTargets()
    local origin = (myHRP and myHRP.Position)
        or (model and model.PrimaryPart and model.PrimaryPart.Position)
    if not origin then return nil end
    local best, bd
    for _, m in ipairs(targets or {}) do
        local h = m and m:FindFirstChild("HumanoidRootPart")
        if h then
            local d = (h.Position - origin).Magnitude
            if d <= NEXO_SM_RANGE and (not bd or d < bd) then best, bd = h.Position, d end
        end
    end
    local dir
    if best then
        dir = (best - origin) * Vector3.new(1, 0, 1)
    elseif model and model.PrimaryPart then
        dir = model.PrimaryPart.CFrame.LookVector * Vector3.new(1, 0, 1)  -- nothing in range: forward
    end
    if not dir or dir.Magnitude < 0.001 then return nil end
    return dir + Vector3.new(1e-4, 1e-4, 1e-4), targets, myModel, myHRP
end

-- one cast: same remote, same argument order (skillID, your server model, DIRECTION, options)
function NexoSMFire()
    local model = NexoSMModel()
    if not model then return end
    local dir, targets, myModel, myHRP = NexoSMAim(model)
    if not dir then dir = NexoSMVec end  -- last resort only
    StartSkill:InvokeServer("ShrineSlash", model, dir, {})
    -- paired damage, the same proven path every other hub skill uses (StartSkill activation +
    -- DamageCharacter on the target list). SkillID stays "ShrineSlash" so the game reads the real
    -- ShrineSlash damage entry.
