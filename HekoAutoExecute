--========================================================--
--  STAND-STILL TARGET LOCK  (shared by every quest kill loop)
--  OLD behaviour: the quest loops re-teleported you onto the nearest NPC EVERY tick, while
--  the bring loops kept pushing that NPC around -> you and the NPC shoved each other and
--  you slowly drifted further and further away from the quest area.
--  NEW behaviour: you TP onto ONE locked NPC exactly once, then you are PINNED to that saved
--  spot (you stand perfectly still while attacking). A new lock + a single new TP only happens
--  when that NPC dies, despawns, or travels further than NEXO_STICK_DROP studs.
--========================================================--
NEXO_STICK_DROP = 60   -- studs the locked NPC may move before you re-TP onto it
NexoAnchors = NexoAnchors or {}

function NexoDropAnchor(key)
    if key then NexoAnchors[key] = nil else NexoAnchors = {} end
end

function NexoStickTo(key, hrp, targetHRP)
    if not hrp then return false end
    local a = NexoAnchors[key]
    if a then
        local t, ok = a.tgt, true
        if not (t and t.Parent) then ok = false end
        if ok then
            local hum = t.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then ok = false end                                  -- target dead
            if ok and (t.Position - a.home).Magnitude > NEXO_STICK_DROP then ok = false end -- teleported away
        end
        if not ok then a = nil NexoAnchors[key] = nil end
    end
    if not a then
        if not targetHRP then return false end
        a = { tgt = targetHRP } -- the SPOT itself is recomputed live just below
        NexoAnchors[key] = a
    end
    -- LIVE SPOT (fixes the Position selector): the spot used to be computed ONCE and cached, so it
    -- never followed the NPC and changing the selector mid-farm did nothing. Recompute against the
    -- NPC's CURRENT position and facing every call, so Front / Back / Top / Bottom keep tracking it
    -- as it walks and turns. The write-guard below still prevents any redundant CFrame writes.
    a.cf = auraGoal(a.tgt)
    a.home = a.tgt.Position
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero -- ANTI-SPIKE: land/hold dead-still
        -- ANTI-SPIKE: this runs EVERY FRAME while auto-moving. Re-writing the CFrame when
        -- you are already on the anchor forced a full assembly re-simulation each frame
        -- (the jitter + spikes). Same spot, same lock, just no redundant writes.
        local p, g = hrp.Position, a.cf.Position
        local dx, dy, dz = p.X - g.X, p.Y - g.Y, p.Z - g.Z
        if (dx * dx + dy * dy + dz * dz) > 0.01 then hrp.CFrame = a.cf end
    end)
    return true
end

