-- ============== INFINITY RAID: LIVE WINDOW + DAMAGE FEED + NOTIFICATION ==============
-- The Infinite Raid is only OPEN for part of every hour. The game computes it in
-- Client.Controllers.RaidController with the LIVE numbers from ReplicatedStorage.Configs.RaidsConfig:
--     t    = math.floor(workspace:GetServerTimeNow())
--     into = t % RaidsConfig.InfiniteRaidOpenInterval        -- live value: 3600s (every 60 min)
--     open = into < RaidsConfig.InfiniteRaidOpenDuration     -- live value: 1200s (open 20 min)
-- Read STRAIGHT from the config (same numbers kept as fallback), so a retune follows automatically.
-- ANTI-LAG: everything below is either event-driven or cached. There is not a single workspace or
-- PlayerGui walk in this section, and the only per-tick work while idle is integer math on a clock.
NexoInfW = NexoInfW or { interval = 3600, duration = 1200, mult = nil, read = false }
function nexoInfCfg()
    if NexoInfW.read then return end
    pcall(function()
        local m = require(RepStorage:WaitForChild("Configs"):WaitForChild("RaidsConfig"))
        NexoInfW.interval = tonumber(m.InfiniteRaidOpenInterval) or NexoInfW.interval
        NexoInfW.duration = tonumber(m.InfiniteRaidOpenDuration) or NexoInfW.duration
        NexoInfW.mult     = m.InfiniteRaid_DMGRewardMultiplier
        NexoInfW.read     = true
    end)
end
-- returns: isOpen, secondsLeft (until it closes when open / until it opens when closed)
function nexoInfWindow()
    nexoInfCfg()
    local iv, du = NexoInfW.interval, NexoInfW.duration
    local now = math.floor(workspace:GetServerTimeNow())
    local into = now - math.floor(now / iv) * iv
    if into < du then return true, du - into end
    return false, iv - into
end
function nexoInfClock(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    return string.format("%02d:%02d", math.floor(sec / 60), sec % 60)
end
function nexoInfNum(n)
    n = tonumber(n) or 0
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return string.format("%d", n)
end

