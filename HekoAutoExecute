-- ============================ SHARED SELF-HEALING SUPERVISOR ============================
-- One helper reused by every long-running worker that was previously a bare task.spawn. If the
-- body throws (a part destroyed mid-teleport, a nil index after a respawn, a remote that errors)
-- the thread used to die PERMANENTLY and the feature silently stopped until you toggled it off
-- and on again. Now the body runs inside pcall and is restarted automatically with a short backoff
-- so a persistent fault can never hot-spin the CPU. This is the exact pattern the raid engine
-- already proved out -- it is just lifted here so every system can share it.
function NexoSupervise(name, fn)
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION do
            local ok = pcall(fn)
            if ok then break end -- returned normally: the worker finished on purpose
            task.wait(0.5)       -- crashed: back off briefly, then bring it straight back up
        end
    end)
end

