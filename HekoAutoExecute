            -- 2:30 STUCK-WATCHDOG: if the boss still isn't dead after 150s in the SAME run, force a
            -- retry so we never get stuck on a bugged / permanently-immune boss. The timer resets on
            -- every retry/ready below and whenever the raid is turned off.
            if os.clock() - outerRunStart > 150 then
                clickPopup("next"); clickPopup("close")
                if outerBossHome and outerBossModel and outerBossModel.Parent then
                    local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                    if br then pcall(function() br.CFrame = outerBossHome end) end
                end
                outerBossHome = nil
                outerBossWasAlive = false
                pcall(function() RetrySignal:InvokeServer() end)
                outerRunStart = os.clock()
            end
            local mdl = getModel()
            local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Any non-boss NPC/aura is auto-prioritized by collectTargets: while one is alive we
                -- hit ONLY the adds/auras (and move to the nearest), then return to the boss once
                -- they're all dead. Boss out of aura range falls back to a name-tag lookup.
                local list = collectTargets(AURA_RANGE)
                if outerBossModel ~= nil then outerBossWasAlive = true end -- boss engaged this run
                local target = getNearest(AURA_RANGE)
                local th = target and target:FindFirstChild("HumanoidRootPart")
                -- IMPORTANT: while the boss is parked in the VOID (outerBossHome ~= nil) NEVER fall back
                -- to the name-tag boss lookup -- it would find the boss out in the void and snap YOU onto
                -- it, teleporting your character into the void. Only chase the tagged boss when it's home.
                if not (target and th) and outerBossHome == nil then
                    target, th = outerFindByTag(OUTER_BOSS_TAG)
                    if target and th then list = { target } end
                end
                if target and th then
                    inOuterRaid = true
                    outerTick = outerTick + 1
                    -- Only re-snap onto the target when we're actually far from it. Rewriting CFrame
                    -- every frame (or teleporting long distances) trips the game's anti-cheat, which
                    -- then rejects your hits and leaves the NPCs just standing there frozen.
                    pcall(function()
                        local goal = auraGoal(th)
                        if (hrp.Position - goal.Position).Magnitude > STICK_OFFSET + 3 then
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.CFrame = goal
                        end
                    end)
                    -- Deal damage ourselves ONLY if the user isn't already running Fast Attack / Black
                    -- Flash. Firing our own Punch/Black Flash on top of those DOUBLES the remote
                    -- traffic and trips the server anti-spam (works for a bit, then all damage stops).
                    -- The governed Fast skills already auto-target these adds via collectTargets.
                    if not (FastOn or BlackFlashOn) then
                        if outerTick % 2 == 0 then
                            enableBlackFlash()
                            task.spawn(pcall, blackFlashList, list, mdl, hrp)
                        else
                            task.spawn(pcall, attackList, list, mdl, hrp)
                        end
                    end
                    task.wait(0.05)
                else
                    -- Nothing alive. Fire the RETRY remote ONLY after the Awakened Star boss has been
                    -- engaged and DIED -- never at the start and never during the fight (the boss is
                    -- always a target while alive). Before the very first boss, ready up once per
                    -- second to start the raid.
                    clickPopup("next"); clickPopup("close")
                    if outerBossHome ~= nil then
                        task.wait(0.3) -- boss is only VOIDED mid-fight (adds keep spawning); never retry now
                    elseif outerBossWasAlive then
                        -- The boss sometimes DESPAWNS for a check or two between phases without being
                        -- dead. Don't retry on that false alarm: confirm it's really gone by checking
                        -- 2 times over 2 seconds. If a boss OR any add/part reappears at ANY check,
                        -- bail out and keep fighting. Only retry if it's absent all 2 checks.
                        local gone = true
                        for _ = 1, 2 do
                            task.wait(1)
                            if not AutoOuterRaidOn then gone = false break end
                            local t2 = getNearest(AURA_RANGE)
                            local b2 = outerFindByTag(OUTER_BOSS_TAG)
                            local bossLive = false
                            if outerBossModel and outerBossModel.Parent then
                                local bhum = outerBossModel:FindFirstChildOfClass("Humanoid")
                                bossLive = (not bhum) or (bhum.Health > 0)
                            end
                            if t2 or b2 or bossLive then gone = false break end
                        end
                        if gone and AutoOuterRaidOn then
                            pcall(function() RetrySignal:InvokeServer() end)
                            outerRunStart = os.clock() -- new run started; reset the 2:30 watchdog
                        end
                    else
                        pcall(function() ReadySignal:FireServer() end)
                        outerRunStart = os.clock() -- new run started; reset the 2:30 watchdog
                        task.wait(1)
                    end
                end
            else
                task.wait(NEXO_IDLE)
            end
        else
            inOuterRaid = false
            outerRunStart = os.clock() -- raid off: keep timer fresh so 2:30 counts from when it turns on
            task.wait(NEXO_IDLE)
        end
    end
end)

-- ==================== UNLOCK MAX POTENTIAL (absolute rampage mode) ====================
-- One switch on Combat > Auto Skills. Turning it ON asks for confirmation first, then strips
-- EVERY pacing gate the hub normally uses so fast attack, fast black flash and above all the
-- fast skills fire with no delay and no cooldown of our own. While it is on, every
-- delay / speed setting in the menu is locked, because those sliders would fight the override.
-- Turning it OFF puts every saved value back, wipes the stale timers and unlocks the sliders,
-- so the hub behaves exactly as it did before the switch was ever touched.
NEXO_RAMPAGE_ON    = false
NEXO_RAMPAGE_BUSY  = false -- guard: our own :Set calls must not re-enter a callback
NEXO_RAMPAGE_SPEED = 0.0001
NEXO_RAMPAGE_SAVED = nil
NEXO_DELAY_CONTROLS = {}
NexoMaxPotentialToggle = nil

function NexoRampageNotify(msg, kind)
    pcall(function()
        Library:Notify({ Title = "NEXO HUB", Content = tostring(msg), Type = kind or "Info", Duration = 6 })
    end)
end

-- Sliders that control a delay / rate register themselves here so rampage mode can lock them.
function NexoDelaySlider(section, opts)
    opts = opts or {}
    local cb = opts.Callback
    local last = tonumber(opts.CurrentValue)
    local handle
    local o = {}
    for k, v in pairs(opts) do o[k] = v end
    o.Callback = function(v)
        if NEXO_RAMPAGE_BUSY then return end -- our own snap-back, not a real user change
        if NEXO_RAMPAGE_ON then
            -- BLOCKED: put the knob straight back where it was and say why
            NEXO_RAMPAGE_BUSY = true
            pcall(function() if handle then handle:Set(last) end end)
            NEXO_RAMPAGE_BUSY = false
            NexoRampageNotify("Unlock Max Potential is ON -- " .. tostring(opts.Name)
                .. " is locked. Turn Max Potential off to change it.", "Warning")
            return
        end
        last = tonumber(v) or last
        if cb then cb(v) end
    end
    handle = section:CreateSlider(o)
    NEXO_DELAY_CONTROLS[#NEXO_DELAY_CONTROLS + 1] = {
        handle = handle,
        name   = tostring(opts.Name or "Setting"),
        value  = function() return last end,
    }
    return handle
end

-- Push every registered slider back to the value the user had before rampage mode.
function NexoRampageResyncControls()
    NEXO_RAMPAGE_BUSY = true
    for _, c in ipairs(NEXO_DELAY_CONTROLS) do
        pcall(function()
            local v = c.value()
            if v ~= nil and c.handle then c.handle:Set(v) end
        end)
    end
    NEXO_RAMPAGE_BUSY = false
end

-- Wipe every per-move / per-skill timer so the new speed takes effect on the very next tick
-- instead of waiting out a gate that was started under the old timing. This is the "refresh".
function NexoRampageClearGates()
    pcall(function() if NexoClearMoveGates then NexoClearMoveGates() end end)
    pcall(function() if NexoClearSkillGates then NexoClearSkillGates() end end)
    pcall(function() startLast = {} end)
    pcall(function() dmgLast = {} end)
    pcall(function() TgtCache = {} end)
end

function NexoSetRampage(on)
    on = on and true or false
    if on == NEXO_RAMPAGE_ON then return end
    if on then
        -- remember the exact timing the hub is running with right now
        NEXO_RAMPAGE_SAVED = {
            LOOP_GAP         = LOOP_GAP,
            NEXO_IDLE_GAP    = NEXO_IDLE_GAP,
            TGT_CACHE_SEC    = TGT_CACHE_SEC,
            SKILL_GAP        = SKILL_GAP,
            TOTAL_GAP        = TOTAL_GAP,
            GLOBAL_SKILL_GAP = GLOBAL_SKILL_GAP,
            START_GAP        = START_GAP,
            DMG_GAP          = DMG_GAP,
            SKILL_BUDGET     = SKILL_BUDGET,
            BRING_GAP        = BRING_GAP,
        }
        local s = NEXO_RAMPAGE_SPEED
        LOOP_GAP, NEXO_IDLE_GAP, TGT_CACHE_SEC = s, s, s
        SKILL_GAP, TOTAL_GAP, GLOBAL_SKILL_GAP = s, s, s
        START_GAP, DMG_GAP, BRING_GAP = s, s, s
        SKILL_BUDGET = 9999
        NEXO_RAMPAGE_ON = true -- set LAST: the *Ready gates read this to bypass themselves
        NexoRampageClearGates()
        NexoRampageNotify("MAX POTENTIAL UNLOCKED  -  no delay, no cooldown. Delay settings are locked.", "Warning")
    else
        NEXO_RAMPAGE_ON = false -- clear FIRST so the gates start pacing again immediately
        local sv = NEXO_RAMPAGE_SAVED
        if sv then
            LOOP_GAP         = sv.LOOP_GAP
            NEXO_IDLE_GAP    = sv.NEXO_IDLE_GAP
            TGT_CACHE_SEC    = sv.TGT_CACHE_SEC
            SKILL_GAP        = sv.SKILL_GAP
            TOTAL_GAP        = sv.TOTAL_GAP
            GLOBAL_SKILL_GAP = sv.GLOBAL_SKILL_GAP
            START_GAP        = sv.START_GAP
            DMG_GAP          = sv.DMG_GAP
            SKILL_BUDGET     = sv.SKILL_BUDGET
            BRING_GAP        = sv.BRING_GAP
        end
        NEXO_RAMPAGE_SAVED = nil
        NexoRampageClearGates()
        NexoRampageResyncControls() -- sliders usable again, showing their real values
        NexoRampageNotify("Max Potential off  -  normal speed restored and settings unlocked.", "Success")
    end
end

