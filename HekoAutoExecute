-- attack the cached quest NPCs. ANTI-LAG: this used to run at RenderStepped (~60/sec) against the
-- WHOLE list -- that flooded the game (SUPER lag) and wasted the capped damage budget on far NPCs
-- that can't be hit yet (so the quest NPCs never died). Now it runs at 0.03s ALTERNATING punch/black-
-- flash (the SAME proven pattern as Kill Aura) and only targets NPCs within ATTACK_RANGE, so the
-- quest NPCs actually take damage and it stays smooth.
local questBFtick = 0
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if (NexoQuestEngineOn() or SummerEventOn or AutoGojoOn or SummerWaterOn or SummerSunOn) and #questNPCs > 0 and questMyModel and questMyHRP then
            local inRange = {}
            local mp = questMyHRP.Position
            local r2 = ATTACK_RANGE * ATTACK_RANGE -- ANTI-LAG: compare squared distances (no sqrt)
            for _, m in ipairs(questNPCs) do
                local h = m:FindFirstChild("HumanoidRootPart")
                if h then
                    local hp = h.Position
                    local dx, dy, dz = hp.X - mp.X, hp.Y - mp.Y, hp.Z - mp.Z
                    if (dx * dx + dy * dy + dz * dz) <= r2 then inRange[#inRange + 1] = m end
