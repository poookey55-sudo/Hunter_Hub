--------------------- chunked sweep ---------------------
-- ~117,000 instances live in workspace here. Doing them in one pass would freeze
-- you for a second, which is the exact thing we are removing, so we yield between
-- chunks and the boost fades in over about two seconds with no hitch.
function NexoSmSweep(lvl)
    if NexoSmBusy then return end
    NexoSmBusy = true
    task.spawn(function()
        local list = workspace:GetDescendants()
        local total = #list
        for i = 1, total do
            if NEXOG.NexoHubSession ~= SESSION or NexoSmLevel ~= lvl then break end
            local inst = list[i]
            if inst.Parent then pcall(NexoSmApply, inst, lvl) end
            if i % SM_CHUNK == 0 then
                NexoSmProg = math.floor(i / total * 100)
                task.wait()
            end
        end
        NexoSmProg = 100
        NexoSmBusy = false
    end)
end

--------------------- live queue for newly spawned effects ---------------------
-- No per-frame listener doing work: things that appear get pushed into a list and
-- the list is drained a few times a second, and only while the booster is on.
NexoSmQueue, NexoSmQN, NexoSmQConn = {}, 0, nil

function NexoSmQStart()
    if NexoSmQConn then return end
    NexoSmQConn = workspace.DescendantAdded:Connect(function(inst)
        NexoSmQN = NexoSmQN + 1
        NexoSmQueue[NexoSmQN] = inst
    end)
end

function NexoSmQStop()
    if NexoSmQConn then
        pcall(function() NexoSmQConn:Disconnect() end)
        NexoSmQConn = nil
    end
    NexoSmQueue, NexoSmQN = {}, 0
end

--------------------- fps meter (lazy: only while the booster is used) ---------------------
NexoSmFrames, NexoSmLastT, NexoSmFpsConn = 0, os.clock(), nil

function NexoSmMeterOn()
    if NexoSmFpsConn then return end
    -- one integer add per frame, the cheapest possible way to read real fps
    NexoSmFpsConn = game:GetService("RunService").RenderStepped:Connect(function()
        NexoSmFrames = NexoSmFrames + 1
    end)
end

function NexoSmMeterOff()
    if NexoSmFpsConn then
        pcall(function() NexoSmFpsConn:Disconnect() end)
        NexoSmFpsConn = nil
    end
    NexoSmFps, NexoSmAvg = 0, 0
end

--------------------- level switching ---------------------
function NexoSmSetLevel(lvl, why)
    lvl = math.clamp(tonumber(lvl) or 0, 0, 4)
    if lvl == NexoSmLevel then return end
    local old = NexoSmLevel
    NexoSmLevel = lvl
    NexoSmNote = why or "manual"

    if lvl == 0 then
        NexoSmQStop()
        NexoSmRestoreInst()
        NexoSmRestoreFx()
        NexoSmLightUp()
        NexoSmProg = 0
        if not NexoSmAuto then NexoSmMeterOff() end
        return
    end

    -- stepping DOWN (e.g. extreme -> fast): hand everything back first, then
    -- re-apply the lighter level. Always correct, costs one sweep.
    if lvl < old then NexoSmRestoreInst() end

    NexoSmMeterOn()
    NexoSmLightDown()
    NexoSmKillFx()
    NexoSmQStart()
    NexoSmSweep(lvl)
    if lvl >= 3 or NexoSmHideOthers then NexoSmHideAll() end
    if lvl >= 4 or NexoSmMute then
        pcall(function() UserSettings():GetService("UserGameSettings").MasterVolume = 0 end)
    end
end

