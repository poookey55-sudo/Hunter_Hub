-- ROOT-CAUSE FIX  --  CTGacha:452 "attempt to index nil with '4'"   (read live from the game)
--
-- The game's own PlayerDataController (line 85) handles that remote like this:
--     DataChanged.OnClientEvent -> PlayerData[key] = value ; PlayerDataController.DataChanged:Fire(key)
-- so firing it with ("Flags", { CanBlackFlash = true, BlackFlashSkill = ... }) did NOT set two
-- flags -- it REPLACED the whole Flags table with that two-key table. Every other flag
-- (GachaPullPity, GachaUniquePullPity, CratePity, BossIslandLimits, TowerDayCompletions,
-- ClaimedEventDays, TrialCTsCompleted, ArenaOpponents, AutoQuestingEnabled, ...) was wiped from
-- the client, and the very same handler then fired DataChanged("Flags"), which runs
-- CTGacha.UpdateStates ->  PlayerData.Flags.GachaPullPity["4"]  ->  index nil with '4'.
-- Kill Aura / Black Flash re-armed that once per second, so the error repeated every second and
-- every Flags-driven Fusion UI was torn down and rebuilt with it (a real, measurable lag source).
--
-- THE FIX: set the flag exactly the way the GAME sets flags. PlayerDataController line 108
-- (FlagChanged) does `PlayerData.Flags[name] = value` -- one key, table preserved, no signal
-- storm. Black flash is unchanged: SkillController:1104 reads Flags.CanBlackFlash and
-- BlackFlash.lua:94 reads Flags.BlackFlashSkill, and both still see exactly what they saw before.
-- =====================================================================
function NexoFlags()
    if type(NexoPDC) ~= "table" then
        pcall(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local cl = ps and ps:FindFirstChild("Client")
            local ct = cl and cl:FindFirstChild("Controllers")
            local md = ct and ct:FindFirstChild("PlayerDataController")
            if md then NexoPDC = require(md) end -- already required by the game: cached, no yield
        end)
    end
    if type(NexoPDC) ~= "table" then return nil end
    local data = NexoPDC.PlayerData
    if type(data) ~= "table" then return nil end
    local flags = data.Flags
    if type(flags) ~= "table" then return nil end
    return flags
end
-- Writes ONE key, never the container, and only when the value actually differs -- so the 1x/sec
-- re-arm below costs two table reads in the common case and produces zero UI churn.
function NexoSetFlag(name, value)
    local flags = NexoFlags()
    if not flags then return false end
    if flags[name] == value then return true end
    flags[name] = value
    return true
end
-- SESSION REPAIR: if an older copy of this script already replaced Flags earlier in this session,
-- the containers the game indexes without a nil check are restored as empty tables -- exactly what
-- the server sends for a player with no progress on them, and what every reader already falls back
-- to ("... or 0"). Missing keys ONLY: a healthy session is left completely untouched.
