CLIENT_SCAN_SEC = 0.05 -- de-dupes the dozen name-tag walks fired in the SAME instant only

-- SHARED workspace:GetDescendants() cache. Every zone/collectible/boss
-- fallback scan used to walk the whole workspace independently -- with
-- several toggles on that was a dozen full walks per second. They now
-- share ONE walk per SCAN_CACHE window. Same list, same results.
WsCache = WsCache or { t = -1, list = nil }
function wsDesc()
    local now = os.clock()
    if WsCache.list and (now - WsCache.t) < SCAN_CACHE then return WsCache.list end
    local ok, l = pcall(function() return workspace:GetDescendants() end)
    if not ok or type(l) ~= "table" then return WsCache.list or {} end
    WsCache.list, WsCache.t = l, now
    return l
end

-- SHARED workspace.Characters.Client:GetDescendants() cache. Name tags live on the
-- client rigs, so a DOZEN different scans (quest, boss, raid, lumen, TP-to-player,
-- essence, crate...) each walked that whole folder on their own loop tick. They now
-- share ONE walk per CLIENT_SCAN_SEC window. Same list, same results, no lag spikes.
ClientDescCache = ClientDescCache or { t = -1, folder = nil, list = {} }
function clientDesc(folder)
    if not folder then return {} end
    local now = os.clock()
    if ClientDescCache.folder == folder and (now - ClientDescCache.t) < CLIENT_SCAN_SEC then
        return ClientDescCache.list
    end
    local ok, l = pcall(function() return folder:GetDescendants() end)
    if not ok or type(l) ~= "table" then return ClientDescCache.list or {} end
    ClientDescCache.folder, ClientDescCache.list, ClientDescCache.t = folder, l, now
    return l
end

-- =====================================================================
-- SHARED NAME-TAG (TextLabel) INDEX  -- the single biggest CPU win in the script.
-- PROFILED ON THE LIVE CLIENT, not guessed:
--     workspace.Characters.Client descendants ....... 3,890
--     TextLabels among them ......................... 9
--     one clientDesc() walk + :IsA("TextLabel") ..... 2.066 ms
--     of which the :IsA() calls alone ............... 1.887 ms  (91%)
-- Fifteen different features (quest NPC lookup, quest target position, bring,
-- boss finders, trials, summer, shadow) each ran that walk on their own loop tick.
-- At ~8 active consumers x 20 Hz that is 330 ms of CPU burned EVERY SECOND --
-- a third of a core -- purely to rediscover the same 9 labels, 99.8% of each pass
-- being wasted iterations over non-label instances.
--
-- This index keeps the TextLabel list itself. It is maintained by two events on the
-- Client folder (add/remove), so in steady state there is NO walk at all, and it
-- fully rebuilds at most every NEXO_LABEL_RESYNC seconds as a correctness net in case
-- an event is ever missed. Consumers keep their existing inner
-- `if d:IsA("TextLabel")` / `d.ClassName == "TextLabel"` guard, so the matching logic,
-- the tags, the ordering and the results are all byte-for-byte identical -- the loop
-- just no longer iterates 3,881 instances that could never match.
-- =====================================================================
NEXO_LABEL_RESYNC = 2.0
NexoLabelCache = NexoLabelCache or { folder = nil, set = nil, arr = nil, t = -1, dirty = true }

function clientLabels(folder)
    if not folder then return {} end
    local C = NexoLabelCache
    local now = os.clock()

    if C.folder ~= folder then
        -- Folder swapped (rejoin / respawn): drop the old hooks so they cannot leak or
        -- keep feeding a stale list, then hook the new one exactly once.
        if C.conns then
            for _, c in ipairs(C.conns) do pcall(function() c:Disconnect() end) end
        end
        C.folder, C.set, C.arr, C.dirty, C.conns = folder, nil, nil, true, {}
        local added = folder.DescendantAdded:Connect(function(d)
            if d.ClassName == "TextLabel" then
                local S = NexoLabelCache
                if S.folder == folder and S.set and not S.set[d] then
                    S.set[d] = true
                    S.arr[#S.arr + 1] = d
                end
            end
        end)
        local removing = folder.DescendantRemoving:Connect(function(d)
            local S = NexoLabelCache
            if S.folder == folder and S.set and S.set[d] then
                S.set[d] = nil
                -- Rebuild the array from the set: it holds single digits, so this is far
                -- cheaper than flagging a full 3,890-instance rescan on every NPC despawn.
                local arr = {}
                for lbl in pairs(S.set) do arr[#arr + 1] = lbl end
                S.arr = arr
            end
        end)
        C.conns = { added, removing }
        CONNS[#CONNS + 1] = added
        CONNS[#CONNS + 1] = removing
    end

    if (not C.arr) or C.dirty or (now - C.t) >= NEXO_LABEL_RESYNC then
        local set, arr = {}, {}
        -- MUST be clientDesc(): this is the rebuild that PRODUCES the label list.
        -- Calling clientLabels() here would recurse into itself forever.
        for _, d in ipairs(clientDesc(folder)) do
            if d.ClassName == "TextLabel" then
                set[d] = true
                arr[#arr + 1] = d
            end
        end
        C.set, C.arr, C.t, C.dirty = set, arr, now, false
    end
    return C.arr
end

-- =====================================================================
-- LONG-SESSION MEMORY JANITOR  (fixes "smooth at first, laggy later")
-- Several features remember NPCs by INSTANCE key (bring origins, Fast Quest
-- bring flags, blocked remotes, cached parts). NPCs despawn constantly while
-- farming, but those keys stayed forever: after an hour the tables held
-- thousands of dead instances, so memory kept climbing, every pairs() walk over
-- them got slower, and the Roblox GC had to sweep more each cycle -- which is
-- exactly what makes the client fall back to a locked 30/60 FPS.
-- ONE tiny thread (every 5s) now drops keys whose instance is already gone and
-- releases the big shared descendant lists once nothing has asked for them for
-- 5s. Nothing here changes behavior: every consumer already skips dead
-- instances, and a released cache list is simply rebuilt on the next request.
-- =====================================================================
NEXO_PRUNE = NEXO_PRUNE or {}   -- list of getters returning instance-keyed tables
function NexoPruneRegister(getter) NEXO_PRUNE[#NEXO_PRUNE + 1] = getter end
NEXO_PruneRuns, NEXO_PruneDropped = 0, 0 -- shown in the Status tab
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        task.wait(5) -- idle-cheap: 12 runs per minute, only dead keys are touched
        local now = os.clock()
        for _, getter in ipairs(NEXO_PRUNE) do
            local ok, t = pcall(getter)
            if ok and type(t) == "table" then
                for k in pairs(t) do
                    if typeof(k) == "Instance" and not k.Parent then
                        t[k] = nil -- despawned NPC / destroyed remote: nobody can use it again
                        NEXO_PruneDropped = NEXO_PruneDropped + 1
                    end
                end
            end
        end
        if type(NexoPartCache) == "table" then -- cached quest parts that already despawned
            for nm, obj in pairs(NexoPartCache) do
                if not (typeof(obj) == "Instance" and obj.Parent) then NexoPartCache[nm] = nil end
            end
        end
        -- release the two BIG lists (a full workspace / Client walk can be tens of
        -- thousands of entries) once they are stale and unused. Rebuilt on demand.
        if WsCache.list and (now - WsCache.t) > 5 then WsCache.list = nil end
        if ClientDescCache.list and #ClientDescCache.list > 0 and (now - ClientDescCache.t) > 5 then
            ClientDescCache.list, ClientDescCache.folder, ClientDescCache.t = {}, nil, -1
        end
        NEXO_PruneRuns = NEXO_PruneRuns + 1
    end
end)

