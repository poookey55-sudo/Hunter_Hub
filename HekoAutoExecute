function nexoEssenceCount()
    if (os.clock() - ShikiEssCache.t) < 0.5 then return ShikiEssCache.n end
    local n = nil
    local cc = NexoCharacterController()
    if cc then
        pcall(function()
            local lc = cc.LocalCharacter
