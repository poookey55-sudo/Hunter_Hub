-- ANTI-TELEPORT / ANTI-REJOIN: installed ONCE per executor session.
-- EXACT-CASE method lookup so the hot path never calls string.lower().
--   1 = block outright (teleport / kick)   2 = remote send, check the remote name
NEXO_TP_METHODS = {
    Teleport = 1, TeleportAsync = 1, TeleportToPlaceInstance = 1,
    TeleportToSpawnByName = 1, TeleportToPrivateServer = 1,
    TeleportPartyAsync = 1,
    Kick = 3, -- blocked by Anti-TP *or* Anti-AFK (an idle kick is still a kick),
              -- except when NexoAllowTp is set, which is how Safety kicks itself out
    FireServer = 2, InvokeServer = 2,
}
NEXO_NameMemo = {} -- remote name -> true/false, so each name is analysed only ONCE
-- IDLE-LAG FIX: verdict per REMOTE INSTANCE. The guard below runs on every single
-- FireServer/InvokeServer in the entire game, so it must not do a .Name property read
-- plus a function call each time. Weak keys, so destroyed remotes are collected.
NEXO_TpInstMemo = setmetatable({}, { __mode = "k" })
NEXO_TP_NAMES = {
    "rejoin", "serverhop", "changeserver", "switchserver", "newserver",
    "teleporttoplace", "teleportgame", "teleportplayer", "sendtogame",
    "lobbyteleport", "gotolobby", "returntolobby", "kickplayer",
    "afkkick", "idlekick", "kickidle", "idletimeout", "afktimeout",
}
function NEXO_IsBlockedName(n)
    local memo = NEXO_NameMemo[n]
    if memo ~= nil then return memo end -- already decided: zero work
    local clean = string.gsub(string.lower(tostring(n)), "[^a-z]", "")
    local hit = false
    for _, bad in ipairs(NEXO_TP_NAMES) do
        if string.find(clean, bad, 1, true) then hit = true break end
    end
    NEXO_NameMemo[n] = hit
    return hit
end

if not NEXOG.NexoTpGuard then
    NEXOG.NexoTpGuard = true

    -- a) hook TeleportService's own methods
    pcall(function()
        local TS = game:GetService("TeleportService")
        for _, name in ipairs({ "Teleport", "TeleportAsync", "TeleportToPlaceInstance",
                                "TeleportToSpawnByName", "TeleportToPrivateServer",
                                "TeleportPartyAsync" }) do
            pcall(function()
                local original = TS[name]
                if type(original) ~= "function" or not hookfunction then return end
                local hooked
                hooked = hookfunction(original, function(...)
                    if AntiTpOn and not NexoAllowTp then
                        warn("[NEXO HUB] blocked TeleportService:" .. name .. " (Anti Teleport ON)")
                        return nil
                    end
                    return hooked(...)
                end)
            end)
        end
    end)

    -- b) chain a __namecall guard: kills teleport calls AND any remote whose name
    --    looks like a rejoin / teleport-to-another-game trigger, plus Kick.
    pcall(function()
        if not hookmetamethod then return end
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            -- HOT PATH -- this runs on EVERY method call in the whole game, so it must be
            -- almost free: one boolean, then ONE raw table lookup. No tostring, no
            -- string.lower, no pcall, no string concat unless something is actually blocked.
            local guardTp = AntiTpOn and not NexoAllowTp
            if guardTp or AntiAfkOn then
                local kind = NEXO_TP_METHODS[getnamecallmethod()]
                if kind == 3 and not NexoAllowTp then
                    -- Kick refused (this is what "never idle-kicked" means).
                    -- NexoAllowTp is the hub's own pass: the Safety section sets it
                    -- when WE want to leave, otherwise our own guard ate our own kick.
                    return nil
                elseif guardTp then
                    if kind == 1 then
                        return nil -- teleport to another game blocked
                    elseif kind == 2 then
                        local v = NEXO_TpInstMemo[self]
                        if v == nil then
                            v = NEXO_IsBlockedName(self.Name) and true or false
                            NEXO_TpInstMemo[self] = v
                        end
                        if v then return nil end -- rejoin / teleport-style remote blocked
                    end
                end
            end
            return oldNC(self, ...)
        end)
    end)

    -- c) block incoming server-side teleport/rejoin remotes before they can fire
    pcall(function()
        if not getconnections then return end
        -- IDLE-LAG FIX: no polling loop at all. This used to re-walk the tree every few
        -- seconds forever, which is a periodic spike even with every switch off. Remotes
        -- are created once, so we do ONE pass now and then react to new ones via events.
        NEXO_TpSeen = NEXO_TpSeen or {}
        NexoPruneRegister(function() return NEXO_TpSeen end) -- LEAK FIX: forget destroyed remotes
        local function nexoGuardRemote(d)
            if NEXO_TpSeen[d] then return end
            if not (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then return end
            if not NEXO_IsBlockedName(d.Name) then return end
            NEXO_TpSeen[d] = true
            local sig = d:IsA("RemoteEvent") and d.OnClientEvent or d.OnClientInvoke
            pcall(function()
                for _, c in ipairs(getconnections(sig)) do pcall(function() c:Disable() end) end
            end)
        end
        for _, root in ipairs({ game:GetService("ReplicatedStorage"), game:GetService("ReplicatedFirst") }) do
            if root then
                for _, d in ipairs(root:GetDescendants()) do pcall(nexoGuardRemote, d) end
                CONNS[#CONNS+1] = root.DescendantAdded:Connect(function(d)
                    if AntiTpOn then pcall(nexoGuardRemote, d) end
                end)
            end
        end
    end)
end

