-- NOCLIP: controlled by ONE switch only -- the "Noclip" toggle in the Misc tab (NoclipOn).
-- ON  = you pass through everything.
-- OFF = original collision restored immediately and NOTHING can re-enable it, no matter
--       which other feature (Kill Aura / Auto Quest / Reach / Event) is running.
NoclipOn = false -- GLOBAL: the ONLY thing that enables noclip
local noclipCache, noclipModel = {}, nil
local noclipActive = false
CONNS[#CONNS+1] = RunService.Stepped:Connect(function()
    if NEXOG.NexoHubSession ~= SESSION then return end
    local shouldNoclip = NoclipOn -- switch ONLY. no feature can force this on.
    if not shouldNoclip then
        -- everything off: restore original collision ONCE, then stop noclipping
        if noclipActive then
            for _, e in ipairs(noclipCache) do
                if e.part and e.part.Parent then pcall(function() e.part.CanCollide = e.orig end) end
            end
            noclipActive = false
        end
        return
    end
    local mdl = getModel()
    if not mdl then noclipCache = {} noclipModel = nil noclipActive = false return end
    if mdl ~= noclipModel then -- rebuild cache only when character changes
        noclipModel = mdl
        noclipCache = {}
        for _, p in ipairs(mdl:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(noclipCache, { part = p, orig = p.CanCollide }) end
        end
    end
    -- ANTI-LAG: only WRITE the property when it is actually true. Re-assigning CanCollide
    -- on every part every physics frame forces constant collision-geometry rebuilds.
    for _, e in ipairs(noclipCache) do
        if e.part and e.part.Parent and e.part.CanCollide then e.part.CanCollide = false end
    end
    noclipActive = true
end)

