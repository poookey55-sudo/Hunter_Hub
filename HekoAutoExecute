-- ============================ SERVER-SIDE NPC BRING (THE CAPTURE FIX) ============================
-- This is the fix for "the NPCs get brought in but the server still thinks they are outside the
-- area", and it is exactly right: every NPC in this game exists TWICE.
--
--   workspace.Characters.Client.<name>_Client   <- visual model, purely local
--   workspace.Characters.Server.NPCs.<id>_Server <- the model the SERVER reads (31 live)
--
-- Every bring loop in this hub found its targets by scanning name-tag TextLabels under
-- Characters.Client and then set the CFrame of THOSE models. That moves the puppet, not the NPC.
-- The server keeps scoring the untouched _Server model back at the spawn point, so
-- EnemyInAreaPoints never ticked and a kill only ever paid out if the mob happened to already be
-- standing in the volume. That is the whole reason the counter crawled or sat still.
--
-- HOW THE GAME ITSELF MOVES NPCs (read from the live client, then reproduced here):
--   AIController.AIBase runs the NPC brains ON THE CLIENT and adds a "FollowTarget" component when
--   NPCConfig.FollowTarget is set. FollowTarget.Update walks the NPC by driving
--   Character.MovementComponent toward Target.ServerModel.PrimaryPart.Position -- i.e. the game
--   moves NPCs by writing to the ServerModel from the client, because the client that hosts the AI
--   owns those parts. So a client CAN legitimately reposition an NPC; it just has to write to the
--   ServerModel, which is what a pull/grab skill effectively does.
--
-- VERIFIED LIVE before shipping: PivotTo on an NPC ServerModel held its new position at +0.3s,
-- +1.3s and +2.8s with no snap-back and no despawn. The write replicates and the server accepts it.
-- (Nudge them, do not fling them: a ~26k-stud jump destroyed the NPC outright in testing, so the
-- ring is always built around the capture area / the player, never across the map.)
--
-- Matching is done on AIStates.NPCConfig.Name instead of scraped name-tag text: it is the real
-- config name, so it needs no "Lv.5 " prefix handling and no HP-label filtering.
-- Live quest NPCs, matched off AIStates.NPCConfig.Name, returned with their SERVER models.
-- Shared by the bring (NexoAIBring) and the roam/hunt worker at the end of the file.
function NexoAIQuestList()
    local out = {}
    local m = NexoQuestMods()
    local AIC = m and m.AIC
    if not AIC or type(AIC.ActiveAIs) ~= "table" then return out end
    local c = NexoCapInfo()
    local names = c and c.names
    if not names or #names == 0 then return out end
    for _, ai in pairs(AIC.ActiveAIs) do
        local st = ai and ai.AIStates
        local cfg = st and st.NPCConfig
        local nm = cfg and cfg.Name
        local hit = false
        if type(nm) == "string" then
            nm = string.lower(string.match(nm, "^%s*(.-)%s*$") or "")
            for i = 1, #names do
                if nm == names[i] or string.find(nm, names[i], 1, true) then hit = true break end
            end
        end
        if hit then
            local sm = ai.ServerModel or (ai.Character and ai.Character.ServerModel)
            local pp = sm and sm.Parent and sm.PrimaryPart
            if pp then out[#out + 1] = { sm = sm, pp = pp } end
        end
    end
    return out
end

function NexoAIBring(anchor)
    local m = NexoQuestMods()
    local AIC = m and m.AIC
    if not AIC or type(AIC.ActiveAIs) ~= "table" then return 0, 0 end
    local c = NexoCapInfo()
    local names = c and c.names
    if not names or #names == 0 then return 0, 0 end
    local capC, capR = NexoCapPoint()
    local center = capC or anchor
    if not center then return 0, 0 end
    local rad = capR or 30
    local list = NexoAIQuestList()
    local n = #list
    if n == 0 then return 0, 0 end
    local moved = 0
    for i = 1, n do
        local e = list[i]
        -- Already parked inside the scoring volume? Leave it alone. Re-slamming a settled NPC
        -- every pass resets it on the server and the 2s in-area tick never credits it.
        local d = e.pp.Position - center
        local settled = capC ~= nil
            and Vector3.new(d.X, 0, d.Z).Magnitude <= rad * 0.8
            and math.abs(d.Y) <= rad * 0.5
        if not settled then
            local angle = (i / n) * math.pi * 2
            local off = Vector3.new(math.cos(angle) * BRING_OFFSET, 2, math.sin(angle) * BRING_OFFSET)
            pcall(function()
                e.sm:PivotTo(CFrame.new(center + off))
                e.pp.AssemblyLinearVelocity = Vector3.zero
            end)
            moved = moved + 1
        end
    end
    return n, moved
end

local function collectQuestNPCs()
    local qc, now = QuestScanCache, os.clock()
    if qc.a and (now - qc.npcT) < TGT_CACHE_SEC and qc.c and qc.c.Parent then
        return qc.a, qc.b, qc.c -- reused within the same target-cache window (same list Kill Aura uses)
    end
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    if not myHRP or not NPCsF then return {}, nil, nil end
    if questTarget() == "" then return {}, myModel, myHRP end
    local hits = questTargetPositions()
    local targets = {}
    local nh = #hits
    if nh > 0 then
        for _, m in ipairs(NPCsF:GetChildren()) do
            if m ~= myModel then
                local h = m:FindFirstChild("HumanoidRootPart")
                if h then
                    local hp = h.Position
                    local near = false
                    for i = 1, nh do -- cheapest test FIRST: squared distance, no sqrt (<10 studs)
                        local p = hits[i]
                        local dx, dy, dz = hp.X - p.X, hp.Y - p.Y, hp.Z - p.Z
                        if (dx * dx + dy * dy + dz * dz) < 100 then near = true break end
                    end
                    if near then -- only now pay for the humanoid / island / punching-bag checks
                        local hum = m:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 and onMyIsland(hp) and not isPunchingBag(m) then
                            targets[#targets + 1] = m
                        end
                    end
                end
            end
        end
    end
    qc.a, qc.b, qc.c, qc.npcT = targets, myModel, myHRP, now
    return targets, myModel, myHRP
end

