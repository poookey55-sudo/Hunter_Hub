-- Auto Quest movement + air hover between waves + player freeze during Fast Quest multi-bring
local questHoverPos = nil -- last player CFrame; used to freeze mid-air between quest waves
CONNS[#CONNS+1] = RunService.RenderStepped:Connect(function(dt)
    if NEXOG.NexoHubSession ~= SESSION then return end
    if not (NexoQuestEngineOn() or SummerEventOn or AutoGojoOn or SummerWaterOn or SummerSunOn) then questHoverPos = nil return end
    local mdl = getModel()
    local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    -- Collect quest in progress: the fetch loop owns movement, so do not fight it with the freeze
    if NexoFetchBusy then questHoverPos = nil return end
    -- Point/progress quest: stand INSIDE the area (points only score there) and drag the
    -- required NPCs in. Active only while such a quest is unfinished -- once it reaches
    -- 300/300 this block stops matching and the normal Auto Quest flow resumes untouched.
    local cap = NexoCapInfo()
    if cap.on and cap.pos and not cap.done then
        local ax, ay, az = cap.pos.X, cap.pos.Y, cap.pos.Z
        local anchor = CFrame.new(ax, ay + 4, az)
        local mp = hrp.Position
        local dx, dy, dz = mp.X - ax, mp.Y - ay, mp.Z - az
        local r2 = cap.rad * cap.rad
        if (dx * dx + dy * dy + dz * dz) > r2 then -- outside: travel to the quest area
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = anchor
            end)
            questHoverPos = anchor
            return
        end
        local n = #questNPCs
        if n > 0 then
            local ring = 0
            for i = 1, n do
                local h = questNPCs[i] and questNPCs[i]:FindFirstChild("HumanoidRootPart")
                if h then
                    local hp = h.Position
                    local ex, ey, ez = hp.X - ax, hp.Y - ay, hp.Z - az
                    if (ex * ex + ey * ey + ez * ez) > r2 then -- only move the ones still outside
                        local sx, sy, sz = hp.X - mp.X, hp.Y - mp.Y, hp.Z - mp.Z
                        if (sx * sx + sy * sy + sz * sz) <= (BRING_RANGE * BRING_RANGE) then
                            ring = ring + 1
                            local a = (ring / n) * 6.2831853
                            pcall(function()
                                h.AssemblyLinearVelocity = Vector3.zero
                                h.CFrame = CFrame.new(ax + math.cos(a) * STICK_OFFSET, ay + 3, az + math.sin(a) * STICK_OFFSET)
                            end)
                        end
                    end
                end
            end
        end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = anchor
        end)
        questHoverPos = anchor
        return
    end
    -- No quest NPCs (between waves / respawning): freeze at last position so player doesn't fall
    if #questNPCs == 0 then
        if questHoverPos then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = questHoverPos
            end)
        end
        return
    end
    -- Fast Quest + multiple NPCs: hold player frozen where the bring happened
    if FastQuestOn and fastQuestFrozenPos and #questNPCs > 1 then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = fastQuestFrozenPos
        end)
        questHoverPos = fastQuestFrozenPos
        return
    end
    -- SUMMER FAST QUEST: hold the player at the spot they were standing on when it was
    -- switched on, and RETURN so the normal Auto Quest tween never touches the character.
    if FastSummerQuestOn and (SummerWaterOn or SummerSunOn) then
        if not fastSummerAnchor then fastSummerAnchor = hrp.CFrame end -- capture the spot ONCE
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = fastSummerAnchor
        end)
        questHoverPos = fastSummerAnchor
        return
    end
    -- Fast Summer Event: BRING like Fast Raid -- hold position and let the cache loop pull the quest
    -- NPCs into a ring around you. If the nearest NPC is beyond the 500 bring range, TP onto it first
    -- to close the gap (the rest get brought next frame). A DEDICATED anchor avoids stranding.
    if FastSummerEventOn and (SummerEventOn or SummerWaterOn or SummerSunOn) then
        local fnearest, fnd
        for _, m in ipairs(questNPCs) do
            local h = m:FindFirstChild("HumanoidRootPart")
            if h then
                local d = (h.Position - hrp.Position).Magnitude
                if not fnd or d < fnd then fnearest, fnd = h, d end
            end
        end
        if fnearest and fnd <= SUMMER_EVENT_BRING_RANGE then
            if not fastEventAnchor then fastEventAnchor = hrp.CFrame end -- capture a FRESH anchor here
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = fastEventAnchor
            end)
            questHoverPos = fastEventAnchor
        elseif fnearest then
            fastEventAnchor = nil
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = auraGoal(fnearest) -- nearest NPC out of range: TP onto it to close the gap
            end)
            questHoverPos = hrp.CFrame
        else
            fastEventAnchor = nil
        end
        return
    end
    -- Normal Auto Quest: lerp smoothly toward the nearest quest NPC
    -- ANTI-LAG: squared distances pick the SAME nearest NPC without a sqrt per NPC per frame.
    local nearest, nd
    local mp = hrp.Position
    for _, m in ipairs(questNPCs) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local hp = h.Position
            local dx, dy, dz = hp.X - mp.X, hp.Y - mp.Y, hp.Z - mp.Z
            local d = dx * dx + dy * dy + dz * dz
            if not nd or d < nd then nearest, nd = h, d end
        end
    end
    if nearest then
        -- STAND STILL: lock onto ONE quest NPC, TP onto it once, then stay pinned on that
        -- spot while killing it (no more per-frame chasing / drifting away from the area).
        NexoStickTo("quest", hrp, nearest)
        questHoverPos = hrp.CFrame -- save every frame for hover when NPCs die
    end
end)

-- === NEXO: BRING STATE HELPER =================================================================
-- anyBringActive() is true whenever a "bring to you" mode is on. It is used to stop Kill Nearest Aura
-- from tweening/teleporting you while a bring is running (otherwise the two features fight over your
-- position). IMPORTANT: we deliberately DO NOT freeze the player here -- you can walk around freely
-- during a bring; only the NPCs are held still (their velocity is zeroed inside each bring loop).
-- Global (no `local`) to avoid consuming scarce main-chunk local registers (near Luau's 200 cap).
function anyBringActive()
    return BringOn or BringAllOn or BringQuestOn or BringGojoOn
        or SummerLifeguardOn or AutoSummerNPCOn or BringSummerRaidOn
