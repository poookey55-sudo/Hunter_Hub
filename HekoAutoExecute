-- ==================== SHOP TAB (exchange NPC shops) ====================
-- Everything here is read LIVE from the game's own EventConfig / PlayerData, so shop list,
-- item names, prices, stock caps and timers are always the real current values.
--   shops    : EventConfig.ActiveEvents -> EventConfig.Events[key] (Type == "EventShop")
--   currency : CharacterController.LocalCharacter.Inventory:GetSupply(cur).Count
--   stock    : item.MaxStock - PlayerData.EventPurchases[shop][item]
--   buying   : InventoryController:BuyEventItem(shop, item)  (the same call the game's own
--              shop UI makes, so no duplicate purchase system is invented here)
NexoShopState = {}
NexoShopBusy = false
NexoShopLoopOn = false
NexoShopStatusOn = false
local NexoShopMods = nil

local function NexoShopM()
    if NexoShopMods then return NexoShopMods end
    local ok, m = pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local C = Players.LocalPlayer.PlayerScripts.Client.Controllers
        local npc
        pcall(function() npc = require(RS.Configs.NPCConfig.StaticNPCs.Shops) end)
        return {
            Event = require(RS.Configs.EventConfig),
            Item  = require(RS.Configs.ItemConfig),
            Inv   = require(C.InventoryController),
            Data  = require(C.PlayerDataController),
            Char  = require(C.CharacterController),
            Npc   = npc,
        }
    end)
    if ok then NexoShopMods = m end
    return NexoShopMods
end

local function NexoComma(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

function NexoShopNotify(msg, kind)
    pcall(function()
        Library:Notify({ Title = "NEXO SHOP", Content = tostring(msg), Type = kind or "Info", Duration = 6 })
    end)
end

-- display name: the game's own NPC shop name when it has one
local function NexoShopName(key)
    local M = NexoShopM()
    local n = M and M.Npc and M.Npc[key] and M.Npc[key].Name
    return tostring(n or key)
end

local function NexoCurName(id)
    local M = NexoShopM()
    local it = M and M.Item and M.Item.Items and M.Item.Items[id]
    return tostring((it and it.Name) or id)
end

local function NexoCurCount(id)
    local M = NexoShopM()
    if not M then return 0 end
    local c = 0
    pcall(function()
        local ch = M.Char.LocalCharacter
        if ch and ch.Inventory then
            local s = ch.Inventory:GetSupply(id)
            c = (s and s.Count) or 0
        end
    end)
    return c or 0
end

local function NexoBought(shopKey, itemKey)
    local M = NexoShopM()
    if not M then return 0 end
    local n = 0
    pcall(function()
        local p = M.Data.PlayerData and M.Data.PlayerData.EventPurchases
        n = (p and p[shopKey] and p[shopKey][itemKey]) or 0
    end)
    return n or 0
end

local function NexoShopTimer(cfg)
    local e = tonumber(cfg and cfg.EndTimeStamp)
    if not e then return "n/a" end
    local left = e - workspace:GetServerTimeNow()
    if left <= 0 then return "restocking" end
    local d = math.floor(left / 86400)
    local h = math.floor(left % 86400 / 3600)
    local m = math.floor(left % 3600 / 60)
    local s = math.floor(left % 60)
    if d > 0 then return string.format("%dd %dh", d, h) end
    if h > 0 then return string.format("%dh %dm", h, m) end
    return string.format("%dm %ds", m, s)
end

-- status text: ONLY this shop's own currency, nothing unrelated
local function NexoShopStatus(st)
    local cfg = st.cfg
    local cur = cfg.Currency
    local have = NexoCurCount(cur)
    local line = NexoCurName(cur) .. ": " .. NexoComma(have)
    local key = st.sel
    if not key then
        return line .. "  |  no item selected  |  Restock: " .. NexoShopTimer(cfg)
    end
    local it = cfg.Shop[key]
    local price = (it.Price and it.Price[2]) or 0
    local bought = NexoBought(st.key, key)
    local stock = math.max((it.MaxStock or 0) - bought, 0)
    local afford = price > 0 and math.floor(have / price) or 0
    local canBuy = math.min(afford, stock)
    return line
        .. "  |  " .. tostring(it.Title)
        .. "  |  can buy now: " .. NexoComma(canBuy)
        .. "  |  stock: " .. NexoComma(stock) .. "/" .. NexoComma(it.MaxStock or 0)
        .. "  |  bought " .. NexoComma(st.done) .. "/" .. NexoComma(st.target)
        .. "  |  Restock: " .. NexoShopTimer(cfg)
end

local function NexoShopRefresh(st)
    local txt = NexoShopStatus(st)
    if txt == st.lastText then return end -- never touch the GUI when nothing changed
    st.lastText = txt
    pcall(function()
        if st.label.SetText then st.label:SetText(txt) else st.label:Set(txt) end
    end)
end

-- one status loop for every shop, 1s, and it only writes labels that actually changed
local function NexoShopStatusLoop()
    if NexoShopStatusOn then return end
    NexoShopStatusOn = true
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION do
            for _, st in pairs(NexoShopState) do NexoShopRefresh(st) end
            task.wait(1)
        end
        NexoShopStatusOn = false
    end)
end

local function NexoShopStopAuto(st, msg, kind)
    st.auto = false
    NexoShopBusy = true
    pcall(function() if st.autoToggle then st.autoToggle:Set(false) end end)
    NexoShopBusy = false
    if msg then NexoShopNotify(msg, kind) end
end

-- returns false when auto buy should stop, plus the reason
local function NexoShopCheck(st)
    local key = st.sel
    if not key then return false, "Select an item first.", "Warning" end
    local it = st.cfg.Shop[key]
    if not it then return false, "That item is gone from the shop.", "Error" end
    if st.done >= st.target then
        return false, ("Auto Buy finished: %s x%d."):format(it.Title, st.done), "Success"
    end
    local bought = NexoBought(st.key, key)
    if it.MaxStock and bought >= it.MaxStock then
        return false, ("%s is out of stock (%d/%d)."):format(it.Title, bought, it.MaxStock), "Warning"
    end
    local price = (it.Price and it.Price[2]) or 0
    local have = NexoCurCount(st.cfg.Currency)
    if have < price then
        return false, ("You need %s more %s to buy this item.")
            :format(NexoComma(price - have), NexoCurName(st.cfg.Currency)), "Warning"
    end
    return true
end

-- one buy = the game's own purchase call
local function NexoShopBuyOnce(shopKey, itemKey)
    local M = NexoShopM()
    if not M then return false end
    return (pcall(function()
        local p = M.Inv:BuyEventItem(shopKey, itemKey)
        if type(p) == "table" then
            if p.await then p:await() elseif p.Await then p:Await() end
        end
    end))
end

-- ONE auto buy loop for every shop; it exits by itself when no shop is buying
local function NexoShopAutoLoop()
    if NexoShopLoopOn then return end
    NexoShopLoopOn = true
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION do
            local any = false
            for _, st in pairs(NexoShopState) do
                if st.auto then
                    any = true
                    local ok, msg, kind = NexoShopCheck(st)
                    if not ok then
                        NexoShopStopAuto(st, msg, kind)
                    elseif NexoShopBuyOnce(st.key, st.sel) then
                        st.done = st.done + 1
                        st.lastText = nil -- force one status redraw
                    end
                end
            end
            if not any then break end
            task.wait(0.2)
        end
        NexoShopLoopOn = false
    end)
end

-- ==================== ABILITY EXCHANGER (Shop tab) ====================
-- Everything here was read LIVE from the running game over MCP, nothing is guessed:
--   NPC      : NPCConfig.StaticNPCs.PassiveAbilityExchange   (Name = "Passive Ability Exchange")
--   Options  : NPC.Interaction.Dialogue.Main[1].Dialogue.Options -> { Text = ..., QuestID = ... }
--              live right now: RCTExchange, InfinityAuraExchange, SukunaMarkExchange
--   Cost     : QuestConfig.Quests[QuestID].Requirements -> .Level and .Items = { {ConfigID, Count}, ... }
--   Reward   : QuestConfig.Quests[QuestID].Rewards[1].ConfigID  (RCT / InfinityAura / SukunaPassive)
--   Owned    : CharacterController.LocalCharacter.Inventory:GetSupply(id).Count
--   Level    : PlayerDataController.PlayerData.Stats.Level
--   Exchange : QuestController:AcceptQuest(QuestID) -> QuestService.AcceptQuest, the exact call the
--              game's own confirmation dialogue fires, so no made-up purchase path is used.
-- The list is rebuilt from the config, so a new exchange on that NPC shows up with no script change.
--
-- LOCAL-REGISTER NOTE: the main chunk is already close to Luau's 200 local limit, so this whole
-- block lives inside ONE table (NexoAbx) and declares NO new top-level locals.
NexoAbx = NexoAbx or {}
NexoAbx.state    = { sel = nil, auto = false, toggles = {}, lastText = nil, label = nil, autoToggle = nil }
NexoAbx.busy     = false
NexoAbx.loopOn   = false
NexoAbx.statusOn = false
NexoAbx.mods     = nil

function NexoAbx.M()
    if NexoAbx.mods then return NexoAbx.mods end
    local ok, m = pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local C = Players.LocalPlayer.PlayerScripts.Client.Controllers
        return {
            Npc   = require(RS.Configs.NPCConfig).StaticNPCs.PassiveAbilityExchange,
            Quest = require(RS.Configs.QuestConfig),
            Item  = require(RS.Configs.ItemConfig),
            QC    = require(C.QuestController),
            Data  = require(C.PlayerDataController),
            Char  = require(C.CharacterController),
        }
    end)
    if ok then NexoAbx.mods = m end
    return NexoAbx.mods
end

function NexoAbx.Num(n)
    -- same thousands formatting the shop sections use
    local s = tostring(math.floor(tonumber(n) or 0))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

function NexoAbx.Notify(msg, kind)
    pcall(function()
        Library:Notify({ Title = "NEXO EXCHANGE", Content = tostring(msg), Type = kind or "Info", Duration = 6 })
    end)
end

function NexoAbx.ItemName(id)
    local M = NexoAbx.M()
    local it = M and M.Item and M.Item.Items and M.Item.Items[id]
    return tostring((it and it.Name) or id)
end

function NexoAbx.Have(id)
    local M = NexoAbx.M()
    if not M or not id then return 0 end
    local n = 0
    pcall(function()
        local ch = M.Char.LocalCharacter
        if ch and ch.Inventory then
            local s = ch.Inventory:GetSupply(id)
            n = (s and s.Count) or 0
        end
    end)
    return n or 0
end

function NexoAbx.Level()
    local M = NexoAbx.M()
    if not M then return 0 end
    local lv = 0
    pcall(function()
        local s = M.Data.PlayerData and M.Data.PlayerData.Stats
        lv = tonumber(s and s.Level) or 0
    end)
    return lv or 0
end

-- every exchange the NPC offers right now, in its own dialogue order
function NexoAbx.List()
    local M = NexoAbx.M()
    local out = {}
    if not M or not M.Npc then return out end
    pcall(function()
        local main = M.Npc.Interaction and M.Npc.Interaction.Dialogue and M.Npc.Interaction.Dialogue.Main
        for _, entry in ipairs(main or {}) do
            local d = entry.Dialogue
            for _, o in ipairs((d and d.Options) or {}) do
                if o.QuestID then
                    local q = M.Quest.Quests[o.QuestID]
                    if q then
                        out[#out + 1] = {
                            id     = o.QuestID,
                            title  = tostring(q.Name or o.Text or o.QuestID),
                            level  = tonumber(q.Requirements and q.Requirements.Level) or 0,
                            items  = (q.Requirements and q.Requirements.Items) or {},
                            reward = q.Rewards and q.Rewards[1] and q.Rewards[1].ConfigID,
                        }
                    end
                end
            end
        end
    end)
    return out
end

function NexoAbx.CostText(e)
    local parts = {}
    for _, it in ipairs(e.items) do
        parts[#parts + 1] = NexoAbx.Num(it[2]) .. " " .. NexoAbx.ItemName(it[1])
    end
    return table.concat(parts, ", ")
end

-- true when the level and every material are there, false + the reason when not
function NexoAbx.Check(e)
    local lv = NexoAbx.Level()
    if e.level > 0 and lv < e.level then
        return false, ("needs Lv %s (you are %s)"):format(NexoAbx.Num(e.level), NexoAbx.Num(lv))
    end
    for _, it in ipairs(e.items) do
        local have = NexoAbx.Have(it[1])
        if have < (tonumber(it[2]) or 0) then
            return false, ("needs %s more %s"):format(NexoAbx.Num(it[2] - have), NexoAbx.ItemName(it[1]))
        end
    end
    return true, ""
end

function NexoAbx.Status()
    local st = NexoAbx.state
    local head = "Level: " .. NexoAbx.Num(NexoAbx.Level())
    local e = st.sel
    if not e then return head .. "  |  no ability selected" end
    local mats = {}
    for _, it in ipairs(e.items) do
        mats[#mats + 1] = ("%s %s/%s"):format(NexoAbx.ItemName(it[1]), NexoAbx.Num(NexoAbx.Have(it[1])), NexoAbx.Num(it[2]))
    end
    local ok, why = NexoAbx.Check(e)
    local owned = NexoAbx.Have(e.reward)
    return head
        .. "  |  " .. e.title
        .. "  |  " .. table.concat(mats, ", ")
        .. "  |  " .. (ok and "ready to exchange" or why)
        .. (owned > 0 and ("  |  already owned: " .. NexoAbx.Num(owned)) or "")
end

function NexoAbx.Refresh()
    local st = NexoAbx.state
    if not st.label then return end
    local txt = NexoAbx.Status()
    if txt == st.lastText then return end -- never touch the GUI when nothing changed
    st.lastText = txt
    pcall(function()
        if st.label.SetText then st.label:SetText(txt) else st.label:Set(txt) end
    end)
end

function NexoAbx.StatusLoop()
    if NexoAbx.statusOn then return end
    NexoAbx.statusOn = true
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION do
            NexoAbx.Refresh()
            task.wait(1)
        end
        NexoAbx.statusOn = false
    end)
end

function NexoAbx.StopAuto(msg, kind)
    NexoAbx.state.auto = false
    NexoAbx.busy = true
    pcall(function() if NexoAbx.state.autoToggle then NexoAbx.state.autoToggle:Set(false) end end)
    NexoAbx.busy = false
    if msg then NexoAbx.Notify(msg, kind) end
end

-- one exchange = the game's own AcceptQuest call
function NexoAbx.ExchangeOnce(e)
    local M = NexoAbx.M()
    if not M then return false end
    return (pcall(function() M.QC:AcceptQuest(e.id) end))
end

-- keeps trying the picked exchange until it goes through or a requirement is missing
function NexoAbx.AutoLoop()
    if NexoAbx.loopOn then return end
    NexoAbx.loopOn = true
    task.spawn(function()
        while NEXOG.NexoHubSession == SESSION and NexoAbx.state.auto do
            local e = NexoAbx.state.sel
            if not e then
                NexoAbx.StopAuto("Auto Exchange stopped: nothing selected.", "Warning")
                break
            end
            local ok, why = NexoAbx.Check(e)
            if not ok then
                NexoAbx.StopAuto(("Auto Exchange stopped: %s %s."):format(e.title, why), "Warning")
                break
            end
            local before = NexoAbx.Have(e.reward)
            NexoAbx.ExchangeOnce(e)
            NexoAbx.state.lastText = nil
            task.wait(1)
            if e.reward and NexoAbx.Have(e.reward) > before then
                NexoAbx.StopAuto(("Exchange done: %s."):format(e.title), "Success")
                break
            end
        end
        NexoAbx.loopOn = false
    end)
end

-- built exactly like the other shop sections: one switch per item, then the action controls
function NexoBuildAbilityExchange(tab)
    local M = NexoAbx.M()
    local list = NexoAbx.List()
    tab:CreateSection("Ability Exchanger")
    if #list == 0 then
        tab:CreateLabel("No passive ability exchanges found in this game.")
        return
    end
    local st = NexoAbx.state
    st.sel, st.auto, st.toggles, st.lastText = nil, false, {}, nil
    st.label = tab:CreateParagraph({
        Title = ((M and M.Npc and tostring(M.Npc.Name)) or "Passive Ability Exchange") .. " \u{2014} Live Status",
        Text  = "loading...",
    })

    for _, e in ipairs(list) do
        local entry = e
        st.toggles[entry.id] = tab:CreateToggle({
            Name = ("Select %s \u{2014} %s"):format(entry.title, NexoAbx.CostText(entry)),
            CurrentValue = false,
            Callback = function(on)
                if NexoAbx.busy then return end
                if on then
                    -- one ability at a time: picking this one clears the others
                    NexoAbx.busy = true
                    for k, h in pairs(st.toggles) do
                        if k ~= entry.id then pcall(function() h:Set(false) end) end
                    end
                    NexoAbx.busy = false
                    st.sel = entry
                elseif st.sel and st.sel.id == entry.id then
                    st.sel = nil
                    if st.auto then NexoAbx.StopAuto("Auto Exchange stopped: ability deselected.", "Warning") end
                end
                st.lastText = nil
                NexoAbx.Refresh()
            end,
        })
    end

    tab:CreateButton({
        Name = "Exchange Selected Ability",
        Callback = function()
            local e = st.sel
            if not e then
                NexoAbx.Notify("Select an ability first.", "Warning")
                return
            end
            local ok, why = NexoAbx.Check(e)
            if not ok then
                NexoAbx.Notify(("%s: %s."):format(e.title, why), "Warning")
                return
            end
            if NexoAbx.ExchangeOnce(e) then
                NexoAbx.Notify(("Exchange sent: %s."):format(e.title), "Success")
            else
                NexoAbx.Notify(("Exchange failed: %s."):format(e.title), "Error")
            end
            st.lastText = nil
            NexoAbx.Refresh()
        end,
    })

    st.autoToggle = tab:CreateToggle({
        Name = "Auto Exchange",
        CurrentValue = false,
        Callback = function(on)
            if NexoAbx.busy then return end
            if not on then
                st.auto = false
                return
            end
            local e = st.sel
            if not e then
                NexoAbx.StopAuto("Select an ability first.", "Warning")
                return
            end
            local ok, why = NexoAbx.Check(e)
            if not ok then
                NexoAbx.StopAuto(("%s: %s."):format(e.title, why), "Warning")
                return
            end
            st.auto = true
            NexoAbx.AutoLoop()
        end,
    })

    st.lastText = nil
    NexoAbx.Refresh()
    NexoAbx.StatusLoop()
end

function NexoBuildShopTab(tab)
    local M = NexoShopM()
    if not M or not M.Event or not M.Event.ActiveEvents then
        tab:CreateSection("Shop")
        tab:CreateLabel("No exchange shops found in this game.")
        pcall(function() NexoBuildAbilityExchange(tab) end)
        return
    end
    local shops = {}
    for _, key in pairs(M.Event.ActiveEvents) do
        local cfg = M.Event.Events[key]
        if cfg and cfg.Type == "EventShop" and type(cfg.Shop) == "table" then
            shops[#shops + 1] = { key = key, cfg = cfg }
        end
    end
    table.sort(shops, function(a, b) return NexoShopName(a.key) < NexoShopName(b.key) end)
    if #shops == 0 then
        tab:CreateSection("Shop")
        tab:CreateLabel("No exchange shops are active right now.")
        pcall(function() NexoBuildAbilityExchange(tab) end)
        return
    end

    for _, s in ipairs(shops) do
        local cfg = s.cfg
        local st = { key = s.key, cfg = cfg, sel = nil, target = 1, done = 0, auto = false, toggles = {} }
        NexoShopState[s.key] = st

        tab:CreateSection(NexoShopName(s.key))
        st.label = tab:CreateParagraph({ Title = "Live Status", Text = "loading..." })

        -- items in the shop's own display order
        local items = {}
        for k, it in pairs(cfg.Shop) do items[#items + 1] = { k = k, it = it } end
        table.sort(items, function(a, b)
            local ao, bo = a.it.LayoutOrder or 999, b.it.LayoutOrder or 999
            if ao ~= bo then return ao < bo end
            return tostring(a.it.Title) < tostring(b.it.Title)
        end)

        for _, e in ipairs(items) do
            local key, it = e.k, e.it
            local price = (it.Price and it.Price[2]) or 0
            local label = ("Select %s \u{2014} %s %s"):format(
                tostring(it.Title), NexoComma(price), NexoCurName((it.Price and it.Price[1]) or cfg.Currency))
            st.toggles[key] = tab:CreateToggle({
                Name = label,
                CurrentValue = false,
                Callback = function(on)
                    if NexoShopBusy then return end
                    if on then
                        -- one item per shop: selecting this clears the others
                        NexoShopBusy = true
                        for k2, h in pairs(st.toggles) do
                            if k2 ~= key then pcall(function() h:Set(false) end) end
                        end
                        NexoShopBusy = false
                        st.sel, st.done = key, 0
                        pcall(function() st.input:SetTitle("How many to buy \u{2014} " .. tostring(it.Title)) end)
                    elseif st.sel == key then
                        st.sel = nil
                        pcall(function() st.input:SetTitle("How many to buy (select an item first)") end)
                        if st.auto then NexoShopStopAuto(st, "Auto Buy stopped: item deselected.", "Warning") end
                    end
                    st.lastText = nil
                    NexoShopRefresh(st)
                end,
            })
        end

        -- the amount box sits right under the item switches and retitles itself to the picked item
        st.input = tab:CreateInput({
            Name = "How many to buy (select an item first)",
            CurrentValue = "1",
            PlaceholderText = "amount",
            Callback = function(txt)
                local n = math.floor(tonumber(txt) or 1)
                st.target = math.max(1, n)
                st.done = 0
                st.lastText = nil
            end,
        })

        st.autoToggle = tab:CreateToggle({
            Name = "Auto Buy",
            CurrentValue = false,
            Callback = function(on)
                if NexoShopBusy then return end
                if not on then
                    st.auto = false
                    return
                end
                local ok, msg, kind = NexoShopCheck(st)
                if not ok then
                    st.done = 0
                    NexoShopStopAuto(st, msg, kind)
                    return
                end
                st.done = 0
                st.auto = true
                NexoShopAutoLoop()
            end,
        })

        NexoShopRefresh(st)
    end

    pcall(function() NexoBuildAbilityExchange(tab) end)

    NexoShopStatusLoop()
end

-- ==================== AUTO EXECUTE (Settings tab) ====================
-- Two covers:
--   1) queue_on_teleport  -> in game teleports, server hops, place to place teleports
--   2) autoexec file      -> closing Roblox and joining again by hand
-- The code is built fresh every time it is handed over, so the delay you picked is
-- always the one that runs, and nothing is ever queued while the switch is off.
NEXO_LOADER_URL = "https://raw.githubusercontent.com/YOUR_GITHUB_NAME/YOUR_REPO/main/HekoAutoExecute_Source.lua"
AutoExecOn       = false
AutoExecDelayOn  = false
AutoExecDelaySec = 0
NEXO_DELAY_OPTIONS = { 5, 10, 15, 20, 30, 40, 50, 60 }
NexoDelayToggles = {}
NexoDelayBusy    = false

-- The dropped file is written with BOTH extensions, because some executors only pick up
-- .lua from their autoexec folder and others only pick up .txt.
NEXO_AUTOEXEC_NAME = "NexoHub_AutoExec"
NEXO_AUTOEXEC_EXTS = { ".lua", ".txt" }
NEXO_AUTOEXEC_DIRS = {
    "autoexec", "Autoexec", "AutoExec", "AUTOEXEC", "autoexecute", "auto_exec", "autoexecs",
    "scripts/autoexec", "Scripts/autoexec", "workspace/autoexec", "Workspace/autoexec",
    "../autoexec", "../Autoexec", "../AutoExec", "../autoexecute", "../workspace/autoexec",
}
NEXO_AUTOEXEC_WROTE = {}
NexoQueueTeleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or queueteleport or queue_teleport
NexoQueueArmed = false

-- The delay currently picked on the Settings tab, in seconds. 0 means no wait.
function NexoAutoExecDelaySec()
    local sec = tonumber(AutoExecDelaySec) or 0
    if not AutoExecDelayOn then sec = 0 end
    if sec < 0 then sec = 0 end
    return sec
end

-- The generated file is COMPLETELY standalone: it waits the delay you picked and then
-- loads the hub from the URL. Nothing is shared with the running hub any more, so a
-- stale flag or an older copy of the hub can never swallow or double the wait.
function NexoAutoExecCode()
    local url = NEXO_LOADER_URL
    if type(url) ~= "string" or #url == 0 then return nil end
    local sec = NexoAutoExecDelaySec()
    local out = "-- NexoHub auto execute (auto generated, delay " .. tostring(sec) .. " sec)\n"
    if sec > 0 then
        -- task.wait when the executor has it, plain wait otherwise
        out = out .. "if task and task.wait then task.wait(" .. sec .. ") else wait(" .. sec .. ") end\n"
    end
    out = out .. "loadstring(game:HttpGet(\"" .. url .. "\"))()\n"
    return out
end

-- Handed to the next server at the moment you leave, never in advance, so switching
-- off or changing the delay a second before the hop is still respected.
function NexoAutoExecArm()
    if NexoQueueArmed or not NexoQueueTeleport then return false end
    if not AutoExecOn then return false end
    local code = NexoAutoExecCode()
    if not code then return false end
    local ok = pcall(NexoQueueTeleport, code)
    if ok then NexoQueueArmed = true end
    return ok
end

function NexoAutoExecDisarm()
    NexoQueueArmed = false
    pcall(function()
        if NexoQueueTeleport then NexoQueueTeleport("") end
    end)
end

-- Manual leave and rejoin cover: the same standalone line dropped as a .lua AND a .txt
-- file inside every autoexec folder name executors are known to use. Folders that do not
-- exist yet are created when the executor allows it.
function NexoAutoExecSave()
    local code = NexoAutoExecCode()
    if not (code and writefile) then return false end
    local wrote = false
    NEXO_AUTOEXEC_WROTE = {}
    for _, d in ipairs(NEXO_AUTOEXEC_DIRS) do
        pcall(function()
            if isfolder and makefolder and not isfolder(d) then pcall(makefolder, d) end
            if (not isfolder) or isfolder(d) then
                for _, ext in ipairs(NEXO_AUTOEXEC_EXTS) do
                    local path = d .. "/" .. NEXO_AUTOEXEC_NAME .. ext
                    local ok = pcall(writefile, path, code)
                    if ok and ((not isfile) or isfile(path)) then
                        wrote = true
                        NEXO_AUTOEXEC_WROTE[#NEXO_AUTOEXEC_WROTE + 1] = path
                    end
                end
            end
        end)
    end
    -- Last resort for executors with no folder api at all: drop it in the workspace root.
    if not wrote then
        for _, ext in ipairs(NEXO_AUTOEXEC_EXTS) do
            pcall(function()
                local path = NEXO_AUTOEXEC_NAME .. ext
                writefile(path, code)
                wrote = true
                NEXO_AUTOEXEC_WROTE[#NEXO_AUTOEXEC_WROTE + 1] = path
            end)
        end
    end
    return wrote
end

-- Delete every copy, both extensions. If the executor has no delfile, blank them instead.
function NexoAutoExecRemove()
    for _, d in ipairs(NEXO_AUTOEXEC_DIRS) do
        for _, ext in ipairs(NEXO_AUTOEXEC_EXTS) do
            pcall(function()
                local path = d .. "/" .. NEXO_AUTOEXEC_NAME .. ext
                if isfile and isfile(path) then
                    if delfile then pcall(delfile, path) end
                    if isfile(path) and writefile then pcall(writefile, path, "") end
                end
            end)
        end
    end
    for _, ext in ipairs(NEXO_AUTOEXEC_EXTS) do
        pcall(function()
            local path = NEXO_AUTOEXEC_NAME .. ext
            if isfile and isfile(path) then
                if delfile then pcall(delfile, path) end
                if isfile(path) and writefile then pcall(writefile, path, "") end
            end
        end)
    end
    NEXO_AUTOEXEC_WROTE = {}
end

-- DUPLICATE REMOVED: this file defined NexoAutoExecApply TWICE and hooked OnTeleport +
-- TeleportInitFailed twice, so both hooks fired for every teleport and the dead first
-- definition was overwritten before it was ever reached. The surviving block below keeps
-- the exact same behaviour with half the connections and one less startup thread.

-- One switch per delay. Only one can be on: turning one on turns the rest off,
-- on screen and in the saved settings.
function NexoAddDelaySwitch(section, sec)
    local key = "AutoExecDelay" .. tostring(sec)
    local v = S(key, false)
    if v and AutoExecDelaySec == 0 then
        AutoExecDelaySec = sec
        AutoExecDelayOn  = true
    elseif v then
        v = false
        Settings[key] = false
    end
    NexoDelayToggles[sec] = section:CreateToggle({
        Name = tostring(sec) .. " Sec Auto execute delay",
        CurrentValue = v,
        Callback = function(on)
            if NexoDelayBusy then return end
            if on then
                NexoDelayBusy = true
                for s2, o2 in pairs(NexoDelayToggles) do
                    if s2 ~= sec then
                        pcall(function() o2:Set(false) end)
                        Settings["AutoExecDelay" .. tostring(s2)] = false
                    end
                end
                NexoDelayBusy = false
                AutoExecDelaySec = sec
                AutoExecDelayOn  = true
            elseif AutoExecDelaySec == sec then
                AutoExecDelaySec = 0
                AutoExecDelayOn  = false
            end
            Settings[key] = on
            saveSettings()
            task.spawn(function() pcall(NexoAutoExecApply) end)
        end,
    }, "NEXO_" .. key)
end

function NexoAutoExecApply()
    if AutoExecOn then
        NexoAutoExecSave()
        NexoAutoExecArm()
    else
        NexoAutoExecRemove()
        NexoAutoExecDisarm()
    end
end

-- Re arm right before leaving, and again if a teleport fails and retries.
pcall(function()
    CONNS[#CONNS + 1] = Players.LocalPlayer.OnTeleport:Connect(function(State)
        if not AutoExecOn then return end
        if State == Enum.TeleportState.Failed then NexoQueueArmed = false end
        NexoAutoExecArm()
    end)
end)
pcall(function()
    CONNS[#CONNS + 1] = game:GetService("TeleportService").TeleportInitFailed:Connect(function()
        NexoQueueArmed = false
        if AutoExecOn then NexoAutoExecArm() end
    end)
end)

-- Arm as soon as the hub loads, so even a teleport we never see is covered. Unguarded on purpose:
-- when the switch is OFF this is what clears the autoexec file left on disk (the removed duplicate
-- block above used to do that), so switching off still stops the hub from auto-running next join.
task.spawn(function()
    task.wait(2)
    pcall(NexoAutoExecApply)
end)

-- The old "Auto Evolution - INFO" popup (a hand-written, hardcoded list of item totals and quest
-- names in a draggable ScreenGui) has been REMOVED along with its INFO button. Everything it used
-- to show now lives in the live "Evolution Requirements" panel built in the requirement-panel
-- engine above -- same place, same look and feel as the RCT / Infinity Aura / Ascension panels,
-- except every number is read from the game instead of being typed in by hand, so it stays correct
-- and updates by itself as your inventory and quest progress change.

-- ==================== AUTO EVOLUTION (Farm tab) ====================
-- Trainer quest engine. Same proven path as Auto Star Rage / Auto RCT:
--   * re-firing AcceptQuest on a finished quest turns it in AND restarts it
--   * item quests: TP onto the named part, then fire FetchedItem_Signal
--   * npc quests: nameplate detection (exact "Lv.1 ..." text) -> stick + kill
-- ALL GLOBAL: the main chunk is near Luau's 200 local-register cap.
EvoQ1On, EvoQ3On            = false, false
OffQ1On, OffQ2On, OffQ3On   = false, false, false
VitQ1On, VitQ2On, VitQ3On   = false, false, false
