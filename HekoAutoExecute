-- ===================== SHIKIGAMI ROSTER (config-driven) =====================
-- Built from the game's own ShikigamiConfig instead of a hardcoded list, so EVERY shikigami the
-- game knows about is covered automatically. Live check of ShikigamiConfig.Shikigami returns:
--   Bunny, Kuro, Mahoraga, MaxElephant, Nue, Rika, Shiro, Totality
-- The old five-name list silently ignored MaxElephant, Rika and Totality -- those bosses could
-- never be selected and were never detected. If the config is ever unavailable the known five are
-- used as a fallback, so detection can never end up with an empty roster.
NEXO_SHIKI_BASES = nil
NEXO_SHIKI_DISP  = {}

function nexoShikiRoster()
    if NEXO_SHIKI_BASES then return NEXO_SHIKI_BASES end
    local bases = {}
    pcall(function()
        local sc = require(game:GetService("ReplicatedStorage").Configs.ShikigamiConfig)
        for id, v in pairs(sc.Shikigami or {}) do
            local disp = (type(v) == "table" and v.Name) or tostring(id)
            local base = string.lower(tostring(disp))
            bases[#bases + 1] = base
            NEXO_SHIKI_DISP[base] = tostring(disp)
        end
    end)
    if #bases == 0 then
        for _, b in ipairs({ "bunny", "kuro", "nue", "shiro", "mahoraga" }) do
            bases[#bases + 1] = b
            NEXO_SHIKI_DISP[b] = string.upper(string.sub(b, 1, 1)) .. string.sub(b, 2)
        end
    end
    table.sort(bases)
    NEXO_SHIKI_BASES = bases
    return bases
end

-- "lv.1 <name>" for every roster entry: what the boss models / nameplates actually read.
SHADOW_EXACT_NAMES = {}
for _, b in ipairs(nexoShikiRoster()) do
    SHADOW_EXACT_NAMES[#SHADOW_EXACT_NAMES + 1] = "lv.1 " .. b
end
function shadowNorm(v)
    local t = string.lower(tostring(v or ""))
    t = string.gsub(t, "%s+", " ")
    t = string.gsub(t, "^ ", "")
    t = string.gsub(t, " $", "")
    return t
end
function shadowExact(text, names)
    if not text or not names then return false end
    local t = shadowNorm(text)
    if t == "" then return false end
    for _, n in ipairs(names) do
        if t == n then return true end
    end
    return false
end
-- HARD BLACKLIST: anything sitting inside a "Shikigami" folder (at ANY depth)
-- is another player's summon and can never be targeted by this tab.
function shadowInShikiFolder(m)
    if not m then return true end
