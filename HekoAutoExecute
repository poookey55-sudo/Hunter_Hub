-- ===================== SHIKIGAMI DETECTION (event-driven registry) =====================
-- The old selector was a hardcoded list and every kill tick re-walked workspace.Characters looking
-- for nameplates -- that walk was the Shadow Island lag. The NPC folder is now watched with
-- ChildAdded / ChildRemoved, so a spawn is registered on the frame it happens, the dropdown is
-- rebuilt only when the available set actually CHANGES, and the kill loop reads a table instead of
-- scanning. A slow 5s resync repairs the registry if an event is ever missed (streaming, folder
-- swap) -- that is the automatic recovery path. Entries are keyed by base name, so the selector can
-- never contain duplicates no matter how many copies of a boss are alive.
SHIKI_BASE_NAMES = nexoShikiRoster() -- config-driven: every shikigami the game defines
ShikiSeen        = {}
ShikiOptDirty    = false
ShikiHooked      = false
nxShikiDrop      = nil

function nexoShikiLabel(base)
    -- proper display casing straight from the config ("MaxElephant", not "Maxelephant")
    return "Lv.1 " .. (NEXO_SHIKI_DISP[base]
        or (string.upper(string.sub(base, 1, 1)) .. string.sub(base, 2)))
end

function nexoShikiBaseOf(m)
    if not m or shadowInShikiFolder(m) then return nil end
    -- resolves via the memo, so a boss whose model is named generically but whose NAMEPLATE reads
    -- "Lv.1 Mahoraga" is still registered -- the old version only ever looked at m.Name
    local nm = nexoShikiModelName(m) or shadowNorm(m.Name)
    if string.sub(nm, 1, 5) ~= "lv.1 " then return nil end
    local base = string.sub(nm, 6)
    for _, b in ipairs(SHIKI_BASE_NAMES) do
        if base == b then return b end
    end
    return nil
end

function nexoShikiRegister(m)
    local b = nexoShikiBaseOf(m)
    if b and not ShikiSeen[b] then
        ShikiSeen[b] = true
        ShikiOptDirty = true
    end
end

function nexoShikiResync()
    if not NPCsF then return end
    local fresh = {}
    for _, m in ipairs(NPCsF:GetChildren()) do
        local b = nexoShikiBaseOf(m)
        if b then fresh[b] = true end
    end
    for _, b in ipairs(SHIKI_BASE_NAMES) do
        if (fresh[b] or false) ~= (ShikiSeen[b] or false) then ShikiOptDirty = true end
        ShikiSeen[b] = fresh[b] or nil
    end
end

function nexoShikiOptions()
    local out = { "All" }
    for _, b in ipairs(SHIKI_BASE_NAMES) do
        if ShikiSeen[b] then out[#out + 1] = nexoShikiLabel(b) end
    end
    -- never hand back an empty selector: with nothing spawned, offer the full known set
    if #out == 1 then
        for _, b in ipairs(SHIKI_BASE_NAMES) do out[#out + 1] = nexoShikiLabel(b) end
    end
    return out
end

