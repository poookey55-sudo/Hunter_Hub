-- ==================== SW USE S'M  (auto swap -> World Ending Slash -> swap back) ====================
-- Watches the Sukuna's Mark passive bar. The moment the bar is FULL and World Ending Slash is off
-- cooldown it focuses whichever hotbar slot holds SukunaPassive, fires the move, then puts back the
-- exact slot you were on (slot 1, a CT, whatever) so your attacking never changes.
--
-- Verified live in game before writing this (nothing here is guessed):
--   InventoryController.CurrentInventory.EquippedItems[1..5] = the hotbar, values are item IDs
--   InventoryController.CurrentInventory.FocusedItem          = item ID of the slot you are on
--   InventoryService.FocusItem_Method takes the hotbar INDEX  (same call the game HUD makes)
--   CharacterStates.SukunaPassivePowerUpPercent = the mark bar, 0..100 (+12.5 per hit taken)
--   CharacterStates.Cooldowns.ShrineSlash       = { TimeElapsed, Duration }; nil = ready
-- GLOBALS on purpose: the main chunk is on Luau's 200 local-register ceiling.
NexoSWSMOn   = false
NexoSWBusy   = false -- while true the Auto Equip Slot holder above stands down
NEXO_SW_HOLD = 0.55  -- mark slot stays focused this long (ShrineSlash FireDelay is 0.383)
NexoSWFillOn = false -- CHARGE MODE: hold the mark slot focused so auto-punches are Sukuna M1s
NexoSWHold   = false -- true while charge mode owns the hotbar
NexoSWBack   = 0     -- slot to hand back when charging ends

NexoSWInvMemo = NexoSWInvMemo or { c = nil, t = -1 }
function NexoSWInv()
    local m = NexoSWInvMemo
    if m.c then return m.c end
    if os.clock() - m.t < 2 then return nil end -- do not re-require in a tight loop
    m.t = os.clock()
    pcall(function() m.c = require(LocalPlayer.PlayerScripts.Client.Controllers.InventoryController) end)
    return m.c
end

-- hotbar read, memoized 0.5s: returns the SukunaPassive slot and the slot you are currently on
NexoSWSlots = NexoSWSlots or { t = -1, mark = 0, focused = 0 }
function NexoSWScan()
    local s = NexoSWSlots
    local now = os.clock()
    if now - s.t < 0.5 then return s.mark, s.focused end
    s.t = now
    local mark, focused = 0, 0
    pcall(function()
        local ic = NexoSWInv()
        local ci = ic and ic.CurrentInventory
        if not ci then return end
        local eq  = ci.EquippedItems
        local fid = ci.FocusedItem
        for i = 1, 5 do
            local id = eq and eq[i]
            if id then
                if fid == id then focused = i end
                if mark == 0 then
                    local it = ci:GetItem(id)
                    if it and tostring(it.ConfigID) == "SukunaPassive" then mark = i end
                end
            end
        end
    end)
    s.mark, s.focused = mark, focused
    return mark, focused
end

-- bar full AND World Ending Slash off cooldown
function NexoSWReady()
    local ok, ready = pcall(function()
        local lc = NexoLocalChar()
        local cs = lc and lc.CharacterStates
        if not cs then return false end
        if (tonumber(cs.SukunaPassivePowerUpPercent) or 0) < 100 then return false end
        local cd = cs.Cooldowns and cs.Cooldowns["ShrineSlash"]
        if cd == nil then return true end
        if type(cd) == "table" then
            return (tonumber(cd.TimeElapsed) or 0) >= (tonumber(cd.Duration) or 0)
        end
        return false
    end)
    return (ok and ready) and true or false
end

-- hand the hotbar back to whatever slot you were on before charge mode took it
function NexoSWRelease()
    local back = NexoSWBack
    NexoSWBack = 0
    NexoSWHold = false
    if back > 0 then pcall(NexoFocusSlot, back) end
    NexoSWSlots.t = -1
end

