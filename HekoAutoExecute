    while NEXOG.NexoHubSession == SESSION do
      -- IDLE-LAG FIX: nine requirement panels used to be rebuilt (each one an
      -- inventory pass) 2x per second forever. They now rebuild every pass while
      -- anything is changing and every 4th pass once everything has gone quiet.
      if NexoUiPass("req", NexoReqCh) then
