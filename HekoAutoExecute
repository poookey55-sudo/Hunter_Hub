-- ===== AUTO QUEST: COLLECT-ITEM QUESTS (Fetch / NewFetch) =====
-- Kill quests already had a full pipeline (find NPC -> go -> attack). Collect quests had NONE,
-- so Auto Quest just hovered in place on them. Same toggle, same quest selection: when the active
-- quest is a Fetch quest we walk the spawned pickups instead of chasing NPCs.
-- COLLECTION (corrected): the earlier note here claimed the ProximityPrompt had no listener and
-- that Interact.Interacted alone was enough. That was WRONG and is why progress never registered.
-- The game's own QuestController does:
--     InterfaceHandler:OnInteracted(ProximityPrompt, function() ... u10:Destroy(); u102:Fire(p2) end)
-- i.e. the handler is bound THROUGH the prompt, and it is the only code that both despawns the
-- pickup and tells the server. NexoFetchGrab now fires the real prompt AND Interacted on every
-- attempt, so the handler runs whichever signal it is actually bound to.
NexoFetchBusy = false
-- How long to stand on the pickup before firing the collect. The teleport itself is
-- instant (one CFrame snap, no walking), then we settle here so the server has
-- registered the new position before the prompt fires. Raise it if pickups are missed
-- on a laggy server, lower it for faster farming.
NEXO_FETCH_SETTLE = 0.5
function NexoFetchItems()
    local c = workspace:FindFirstChild("Container")
    local f = c and c:FindFirstChild("QuestFetch")
    local out = {}
    if f then
        for _, m in ipairs(f:GetChildren()) do
            local ok, piv = pcall(function() return m:GetPivot().Position end)
            if ok then out[#out + 1] = { model = m, pos = piv } end
        end
    end
    return out
end
function NexoFetchPrompt(m)
    local n = m:FindFirstChild("_INTERACTOR") -- fast path: the standard pickup layout
    local pp = n and n:FindFirstChildWhichIsA("ProximityPrompt")
    if pp then return pp end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
end
function NexoFetchGrab(pp)
    if not pp then return end
    -- ROOT CAUSE OF THE MISSING PROGRESS:
    -- The game binds its collect handler via InterfaceHandler:OnInteracted(ProximityPrompt, fn).
    -- That handler is the ONLY code that destroys the pickup and fires FetchedItem to the server.
    -- Firing Interact.Interacted alone made the item disappear without ever running it, so the
    -- quest counted nothing. Fire BOTH the real prompt and Interacted on every attempt: whichever
    -- signal the handler is bound to, it runs. Both are cheap and harmless if one is redundant.
    pcall(function() pp.RequiresLineOfSight = false end)
    pcall(function() pp.MaxActivationDistance = math.max(pp.MaxActivationDistance, 60) end)
    if fireproximityprompt then
        pcall(function() fireproximityprompt(pp, 1) end)
    end
    local m = NexoQuestMods()
    if m.Interact and m.Interact.Interacted then
        pcall(function() m.Interact.Interacted:Fire(pp) end)
    end
end

-- ===== COLLECT CREDIT (last-resort remote, matching the old script) =====
-- Firing the real prompt above is the correct path and normally credits the quest by itself.
-- This remains only as a safety net for the case where the pickup survives the prompt.
-- The server is told via QuestService.FetchedItem_Signal. The value it expects is the RUNTIME
-- SavedQuest.ItemID (what the game itself passes), NOT the QuestConfig ItemIDs entry -- using the
-- config value was why the earlier attempt still registered nothing. Config is kept as a fallback.
NexoFetchIdCache = { t = -1, id = nil, ids = nil }
function NexoFetchQuestItemIds()
    local c, now = NexoFetchIdCache, os.clock()
    local qi = NexoQuestInfo()
    if c.id == qi.id and (now - c.t) < 2 then return c.ids end
    c.t, c.id, c.ids = now, qi.id, nil
    local m = NexoQuestMods()
    local out = {}
    -- Runtime id first: the pickup is spawned from SavedQuest.ItemID and the game fires that exact
    -- value back to the server, so it is the authoritative one.
    local saved
    pcall(function() saved = m.QC and qi.id and m.QC:GetSavedQuest(qi.id) end)
    if type(saved) == "table" and type(saved.ItemID) == "string" then out[#out + 1] = saved.ItemID end
    local cfg = qi.id and m.QCfg and m.QCfg.Quests and m.QCfg.Quests[qi.id]
    local list = cfg and cfg.ItemIDs
    if type(list) == "table" then
        for _, v in pairs(list) do
            if type(v) == "string" and v ~= out[1] then out[#out + 1] = v end
        end
    end
    if #out > 0 then c.ids = out end
    return c.ids
end

-- Fire the collect signal for every ItemID of the active fetch quest.
function NexoFetchCredit(times)
    local ids = NexoFetchQuestItemIds()
    if not ids then return end
    for _, id in ipairs(ids) do NexoFetchItem(id, times or 1) end
end

-- ===== AIR HOLD WHILE COLLECTING =====
-- Keep the character suspended on the pickup so it cannot fall away mid-collect, then hand
-- control straight back. One shared Heartbeat connection: no per-item churn, no lag.
NexoFetchPin = nil
NexoFetchPinConn = nil
function NexoFetchHold(pos)
    NexoFetchPin = pos
    -- Snap RIGHT NOW rather than on the next Heartbeat: the teleport is instant and the
    -- settle wait below starts counting from the moment we are actually on the pickup.
    pcall(function()
        local hrp = NexoMyHRP and NexoMyHRP()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(pos)
        end
    end)
    if NexoFetchPinConn then return end
    NexoFetchPinConn = game:GetService("RunService").Heartbeat:Connect(function()
        if NEXOG.NexoHubSession ~= SESSION then
            if NexoFetchPinConn then
                NexoFetchPinConn:Disconnect()
                NexoFetchPinConn = nil
            end
            return
        end
        local p = NexoFetchPin
        if not p then return end -- released: character falls/moves normally again
        local hrp = NexoMyHRP and NexoMyHRP()
        if hrp then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(p)
            end)
        end
    end)
    pcall(function() table.insert(CONNS, NexoFetchPinConn) end)
end

function NexoFetchRelease()
    NexoFetchPin = nil -- normal movement restored; the connection idles at near-zero cost
end

