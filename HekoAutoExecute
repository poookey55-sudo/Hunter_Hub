-- ANTI-AFK: replaced with the JJZ_CT_NC_SW_ implementation.
--   a) blocks the client's own *TPAFK* remote (and TeleportService calls) at
--      __namecall, so the game can never yank you out for being idle;
--   b) VirtualUser right-click the moment Roblox reports Idled;
--   c) a fake Insert keypress every 25s so the idle timer keeps resetting.
-- The hub's own Find-Boss hop stays whitelisted through NexoAllowTp.
NEXO_AfkNudges  = 0   -- how many nudges landed (shown in the Status tab)
NEXO_AfkMethod  = "-" -- which trick is doing the work
NEXO_AfkBlocked = 0   -- afk-teleport attempts refused

