            task.wait(0.4) -- not a collect quest: near-zero cost
        end
        task.wait(0.05)
    end
end)

-- ===== AUTO SELECT NEXT QUEST =====
-- Picks the highest quest you actually qualify for and keeps it locked to your level.
-- Level comes from the game's own stat table and the REQUIRED level comes from
-- QuestConfig.Requirements.Level -- not from the "Lv300" text in the selector -- so a mislabeled
-- entry can never send you to the wrong quest. The label is only a fallback.
-- Automatically SKIPPED: one-time quests (IsOneTime) and collectable / turn-in quests
-- (Fetch / NewFetch / Exchange). Those cannot be farmed on repeat, so it falls back to the next
-- highest REPEATABLE quest.
AutoPickOn = false
NexoPickList = nil -- built once: { { i = QUEST_DATA index, lv = required level }, ... } ascending
NexoQuestSync = false -- set while WE drive the dropdown, so its callback does not re-fire

function NexoQuestReqLevel(id, label)
    local m = NexoQuestMods()
    local cfg = m.ok and m.QCfg.Quests and m.QCfg.Quests[id]
    if cfg then
        local r = cfg.Requirements
        if type(r) == "table" and tonumber(r.Level) then return tonumber(r.Level), cfg end
    end
    return tonumber(tostring(label):match("(%d+)")) or 0, cfg -- fallback: the "Lv300" selector text
end

function NexoQuestFarmable(cfg)
    if not cfg then return true end -- unknown to the config: stay selectable, never hide a quest
    if cfg.IsOneTime == true then return false end
    local t = cfg.Type
    if t == "Fetch" or t == "NewFetch" or t == "Exchange" then return false end
    if NexoSkipCap and t == "Capture" then return false end -- Skip Progress Area Quests
    return true
end

-- Built ONCE (the quest list never changes at runtime), so the watcher is just a backwards scan
-- over a small pre-sorted array -- zero config lookups in the hot path.
function NexoBuildPickList()
    if NexoPickList then return NexoPickList end
    local m = NexoQuestMods()
    if not m.ok then return nil end -- config not ready yet; retry next tick
    local list = {}
    for i, q in ipairs(QUEST_DATA) do
        local lv, cfg = NexoQuestReqLevel(q[1], q[2])
        if NexoQuestFarmable(cfg) then list[#list + 1] = { i = i, lv = lv } end
    end
    table.sort(list, function(a, b) if a.lv == b.lv then return a.i < b.i end return a.lv < b.lv end)
    NexoPickList = list
    return list
end

function NexoMyLevel()
    local lv = 0
    pcall(function()
        local PD = require(LocalPlayer.PlayerScripts.Client.Controllers.PlayerDataController)
        lv = tonumber(PD:GetStats().Level) or 0
    end)
    return lv
end

function NexoBestQuestIndex(level)
    local list = NexoBuildPickList()
    if not list or #list == 0 then return nil end
    for k = #list, 1, -1 do -- highest first: the first match IS the answer
        if list[k].lv <= level then return list[k].i end
    end
    return list[1].i -- under-levelled for everything: lowest repeatable quest
end

function NexoApplyQuestIndex(idx)
    if not idx or idx == selQuest or not QUEST_DATA[idx] then return end
    local prevId = currentQuestId() -- remember what we owned before the selection moves
    selQuest = idx
    if updateQuestLabel then pcall(updateQuestLabel) end
    if nxQuestDrop and NexoQuestOptions and NexoQuestOptions[idx] then
        NexoQuestSync = true -- keep the selector visually in sync without re-entering its callback
        pcall(function() nxQuestDrop:Set(NexoQuestOptions[idx]) end)
        NexoQuestSync = false
    end
    -- Only accept when Auto Quest is genuinely running. Auto Select Next Quest on its own just
    -- moves the selector. The previously auto-accepted quest is cancelled first so exactly one
    -- hub-owned quest is ever active and no duplicates pile up.
    if QuestOn then
        task.spawn(function()
            local newId = currentQuestId()
            if prevId and prevId ~= newId then pcall(NexoReleaseOwnedId, prevId) end
            NexoOwnAccept(newId)
        end)
    end
end

task.spawn(function()
    task.wait(1)
    local lastLv = -1
    while NEXOG.NexoHubSession == SESSION do
        if AutoPickOn then
            local lv = NexoMyLevel()
            if lv > 0 and lv ~= lastLv then -- only does real work when your level ACTUALLY changes
                lastLv = lv
                NexoApplyQuestIndex(NexoBestQuestIndex(lv))
            end
            task.wait(0.5)
        else
            lastLv = -1
            task.wait(1) -- toggle off: effectively free
        end
    end
end)

-- ===== AUTO ASCENSION (Grade Ascension) =====
-- Verified live against the running game, so it can never drift from the real requirements:
--   next  = StatsConfig.SubGrades[StatsConfig.GetSubGradeFromLevel(Level)].NextGrade
--   reqs  = StatsConfig.GradeRankUpRequirements[next].Requirements
--           (Special Grade = Yen x1,000,000 / Lumen x15,000 / Heavenly Fragment x1 / Level 999)
--   accept= ReplicatedStorage.NetworkComm.PlayerService.GradeRankUp_Method:InvokeServer()
--   NPC   = workspace.Map.StaticNPCs.GradeRankUp
--
-- Performance design (this is the "fast + no lag" part):
--   * Event driven. Refreshes off PlayerDataController.DataChanged / .StatChanged
--     instead of rebuilding on a timer.
--   * Event bursts are coalesced through a dirty flag, so 200 loot events in one
--     frame still cost exactly ONE rebuild.
--   * ONE single pass over the inventory counts EVERY required ConfigID at once.
--     (The old code walked all ~200 inventory entries once per requirement.)
--   * The requirement list + display names are cached per grade and only re-resolved
--     when the grade actually changes.
--   * The panel is only redrawn when the rendered text actually changes.
--   * The idle tick is a single boolean test, so an idle panel is effectively free.

NexoAscOn          = false
NexoAscBusy        = false
NexoAscReady       = false
NexoAscPanel       = nil
NexoAscLastText    = nil
NexoAscDirty       = true
NexoAscNextAttempt = 0
NexoAscM           = NexoAscM or { t = -1 }
NexoAscReqCache    = NexoAscReqCache or {}
NexoAscUICache     = nil

function NexoAscMods()
    local m, now = NexoAscM, os.clock()
    if m.ok and (now - m.t) < 5 then return m end
    m.t = now
    local Ctrl = LocalPlayer:FindFirstChild("PlayerScripts")
    Ctrl = Ctrl and Ctrl:FindFirstChild("Client")
    Ctrl = Ctrl and Ctrl:FindFirstChild("Controllers")
    if not Ctrl then return m end
    pcall(function() m.PD  = require(Ctrl.PlayerDataController) end)
    pcall(function() m.SC  = require(RepStorage.Configs.StatsConfig) end)
    pcall(function() m.IC  = require(RepStorage.Configs.ItemConfig) end)
    pcall(function() m.Rem = RepStorage.NetworkComm.PlayerService.GradeRankUp_Method end)
    m.ok = (m.PD ~= nil and m.SC ~= nil)
    return m
end

-- 1234567 -> "1,234,567"
function NexoComma(n)
    n = math.floor(tonumber(n) or 0)
    local neg = n < 0
    local s = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    s = s:gsub("^,", "")
    return neg and ("-" .. s) or s
end

-- Mark the panel as needing a rebuild. Deliberately as cheap as possible: the data
-- signals can fire in bursts, so they must never do real work themselves.
function NexoAscTouch() NexoAscDirty = true end

-- The next grade step and its requirement list, resolved exactly the way the game does it.
-- Caches the parsed requirements per grade so repeated refreshes cost nothing.
function NexoAscNext()
    local m = NexoAscMods()
    if not m.ok then return nil, nil, nil end
    local nxt
    pcall(function()
        local lv = m.PD.PlayerData.Stats.Level
        nxt = m.SC.SubGrades[m.SC.GetSubGradeFromLevel(lv)].NextGrade
    end)
    if not nxt then return nil, nil, nil end
    local sg = m.SC.SubGrades[nxt]
    if not sg or sg.CannotGradeTo then return nil, nxt, sg end

    local c = NexoAscReqCache
    if c.grade ~= nxt then
        local entry
        pcall(function() entry = m.SC.GradeRankUpRequirements[nxt] end)
        c.grade   = nxt
        c.reqs    = entry and entry.Requirements
        c.needIds = {}
        c.names   = {}
        for _, r in ipairs(c.reqs or {}) do
            if r.Type == "Item" and r.Item then
                c.needIds[r.Item] = true
                local ic
                pcall(function() ic = m.IC and m.IC.Items and m.IC.Items[r.Item] end)
                c.names[r.Item] = (ic and ic.Name) or tostring(r.Item)
            end
        end
    end
    return c.reqs, nxt, sg
end

-- Counts EVERY required ConfigID in a single pass over the inventory.
-- Currencies (Yen / Lumen) live in the same Items table keyed by ConfigID.
function NexoAscCountMany(needIds)
    local m, have = NexoAscMods(), {}
    if not needIds then return have end
    for id in pairs(needIds) do have[id] = 0 end
    pcall(function()
        for _, it in pairs(m.PD.PlayerData.Inventory.Items) do
            if type(it) == "table" then
                local id = it.ConfigID
                if id ~= nil then
                    local cur = have[id]
                    if cur then have[id] = cur + (tonumber(it.Count) or 1) end
                end
            end
        end
    end)
    return have
end

-- Kept for compatibility with anything else that calls it.
function NexoAscCount(cfgId)
    return NexoAscCountMany({ [cfgId] = true })[cfgId] or 0
end

function NexoAscStat(m, name)
    local v
    pcall(function() v = m.PD.PlayerData.Stats[name] end)
    if v == nil then pcall(function() v = m.PD:GetStats()[name] end) end
    return tonumber(v) or 0
end

-- Builds the live panel text and reports whether every requirement is met.
function NexoAscBuild()
    local m = NexoAscMods()
    if not m.ok then return "Loading grade data...", false end

    local reqs, nxt, sg = NexoAscNext()
    if not reqs then
        if sg and sg.CannotGradeTo then return "Max grade reached - nothing left to ascend to.", false end
        return "No ascension available right now.", false
    end

    local c    = NexoAscReqCache
    local have = NexoAscCountMany(c.needIds)
    local RULE = string.rep("\226\148\128", 30)

    local missItems, missLevel, missOther, metLines = {}, nil, {}, {}
    local shortCount = 0

    for _, r in ipairs(reqs) do
        local name, hv, nd
        if r.Type == "Item" then
            name = (c.names and c.names[r.Item]) or tostring(r.Item)
            nd   = tonumber(r.Amount) or 0
            hv   = have[r.Item] or 0
        elseif r.Type == "Stat" then
            name = tostring(r.Stat)
            nd   = tonumber(r.Value) or 0
            hv   = NexoAscStat(m, r.Stat)
        else
            name, nd, hv = tostring(r.Type), 1, 0
        end

        if hv >= nd then
            metLines[#metLines + 1] = "\226\128\162  " .. name .. "  \194\183  " .. NexoComma(hv) .. " / " .. NexoComma(nd)
        else
            shortCount = shortCount + 1
            local gap = nd - hv
            if r.Type == "Item" then
                missItems[#missItems + 1] = "\226\128\162  " .. name .. "  =  " .. NexoComma(gap)
            elseif r.Type == "Stat" and r.Stat == "Level" then
                missLevel = "\226\128\162  Levels Needed  =  " .. NexoComma(gap)
            else
                missOther[#missOther + 1] = "\226\128\162  " .. name .. "  =  " .. NexoComma(gap)
            end
        end
    end

    local ready = (shortCount == 0)
    local L = {}
    L[#L + 1] = "Next Grade  \194\183  " .. tostring((sg and sg.Name) or nxt)
    L[#L + 1] = RULE

    if ready then
        L[#L + 1] = "ALL REQUIREMENTS MET"
        for _, s in ipairs(metLines) do L[#L + 1] = s end
        L[#L + 1] = RULE
        L[#L + 1] = NexoAscOn
            and "Status  \194\183  Ready - ascending now"
            or  "Status  \194\183  Ready - enable Auto Ascension"
    else
        if #missItems > 0 then
            L[#L + 1] = "ITEMS MISSING"
            for _, s in ipairs(missItems) do L[#L + 1] = s end
        end
        if missLevel then
            if #missItems > 0 then L[#L + 1] = "" end
            L[#L + 1] = "LEVEL REQUIREMENT"
            L[#L + 1] = missLevel
        end
        if #missOther > 0 then
            L[#L + 1] = ""
            L[#L + 1] = "OTHER REQUIREMENTS"
            for _, s in ipairs(missOther) do L[#L + 1] = s end
        end
        if #metLines > 0 then
            L[#L + 1] = ""
            L[#L + 1] = "COMPLETED"
            for _, s in ipairs(metLines) do L[#L + 1] = s end
        end
        L[#L + 1] = RULE
        L[#L + 1] = "Status  \194\183  Waiting on " .. shortCount .. " requirement" .. (shortCount == 1 and "" or "s")
    end

    return table.concat(L, "\n"), ready
end

-- The bundled UI library builds every paragraph with a FIXED one-line Body (18px) inside a
-- 62px row, so a multi-line panel is clipped to a sliver and looks like nothing rendered.
-- These two helpers measure the real wrapped text height and grow the Body + row to match.
-- The section's ScrollingFrame already uses AutomaticCanvasSize.Y, so the list reflows itself.
function NexoAscUI()
    local u = NexoAscUICache
    if u and u.body and u.body.Parent and u.row and u.row.Parent then return u end
    u = nil
    pcall(function()
        local pg  = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local hub = pg and pg:FindFirstChild("NexoHub")
        if not hub then return end
        for _, d in ipairs(hub:GetDescendants()) do
            if d:IsA("TextLabel") and d.Name == "Title" and d.Text == "Ascension Requirements" then
                local para = d.Parent
                local body = para and para:FindFirstChild("Body")
                if body and body:IsA("TextLabel") and para.Parent then
                    u = { title = d, para = para, body = body, row = para.Parent, w = -1 }
                end
                break
            end
        end
    end)
    NexoAscUICache = u
    return u
end

function NexoAscFit(txt)
    local u = NexoAscUI()
    if not u then return end
    pcall(function()
        local body, para, row, title = u.body, u.para, u.row, u.title
        -- the whole hub sits under a UIScale, so convert the rendered width back into
        -- layout units before measuring (Size offsets are unscaled)
        local scale = 1
        if title.Size.Y.Offset > 0 and title.AbsoluteSize.Y > 0 then
            scale = title.AbsoluteSize.Y / title.Size.Y.Offset
        end
        if scale < 0.05 then scale = 1 end
        local w = body.AbsoluteSize.X / scale
        if w < 40 then w = (row.AbsoluteSize.X / scale) - 28 end
        u.w = body.AbsoluteSize.X
        if w < 40 then return end -- tab not drawn yet; the driver retries when it opens
        body.TextWrapped    = true
        body.TextXAlignment = Enum.TextXAlignment.Left
        body.TextYAlignment = Enum.TextYAlignment.Top
        local h = game:GetService("TextService")
            :GetTextSize(txt, body.TextSize, body.Font, Vector2.new(w, 100000)).Y
        h = math.ceil(h) + 4
        local padTop, padBot = 10, 10
        local p = para:FindFirstChildOfClass("UIPadding")
        if p then padTop, padBot = p.PaddingTop.Offset, p.PaddingBottom.Offset end
        local total = body.Position.Y.Offset + h + padTop + padBot
        body.Size = UDim2.new(1, 0, 0, h)
        para.Size = UDim2.new(1, 0, 0, total)
        row.Size  = UDim2.new(1, 0, 0, total)
        -- remember the target so the panel can heal itself if the library stomps it
        u.h, u.total = h, total
        -- The library re-applies its fixed 18px Body height after SetText (sometimes a frame
        -- later), which made the panel flash then vanish. This hook restores our height the
        -- instant that happens, so there is no visible collapse.
        if not u.hooked then
            u.hooked = true
            -- Restores our measured height the same frame the library resets it, so the panel
            -- never visibly collapses. Guarded by u.applying so it cannot recurse.
            local function restore()
                local c = NexoAscUICache
                if c ~= u or not body.Parent then return end
                if not c.h or c.h <= 0 or c.applying then return end
                if body.Size.Y.Offset == c.h and row.Size.Y.Offset == c.total then return end
                c.applying = true
                pcall(function()
                    body.Size = UDim2.new(1, 0, 0, c.h)
                    para.Size = UDim2.new(1, 0, 0, c.total)
                    row.Size  = UDim2.new(1, 0, 0, c.total)
                end)
                c.applying = false
            end
            for _, inst in ipairs({ body, para, row }) do
                local ok, hook = pcall(function()
                    return inst:GetPropertyChangedSignal("Size"):Connect(restore)
                end)
                if ok and hook and CONNS then CONNS[#CONNS + 1] = hook end
            end
        end
    end)
end

-- Cheap per-tick guard: two integer compares. Re-asserts the measured height whenever anything
-- (library redraw, tab switch, toggle) has reset the Body or row back to the default sliver.
function NexoAscEnforce()
    local u = NexoAscUICache
    if not u or not u.h or u.h <= 0 then return end
    local body, row = u.body, u.row
    if not body or not body.Parent or not row then return end
    if body.Size.Y.Offset ~= u.h or row.Size.Y.Offset ~= u.total then
        pcall(function()
            body.Size = UDim2.new(1, 0, 0, u.h)
            u.para.Size = UDim2.new(1, 0, 0, u.total)
            row.Size  = UDim2.new(1, 0, 0, u.total)
        end)
    end
end

-- Only touches the UI when the TEXT ACTUALLY CHANGES, so an idle panel costs nothing to draw.
function NexoAscRefresh()
    local txt, ready = NexoAscBuild()
    NexoAscReady = ready
    if txt ~= NexoAscLastText then
        NexoAscLastText = txt
        if NexoAscPanel then
            pcall(function() NexoAscPanel:SetText(txt) end)
            pcall(function() NexoAscPanel:Set(txt) end)
        end
        NexoAscFit(txt)
        -- the library can re-apply its own height one frame after SetText, so measure again
        task.defer(function() NexoAscFit(txt) end)
    else
        -- re-fit if the hub was resized, the tab only just became visible, or the height was reset
        local u = NexoAscUI()
        if u and u.body and u.body.Parent then
            if u.body.AbsoluteSize.X ~= u.w or not u.h or u.h <= 0 or u.body.Size.Y.Offset ~= u.h then
                NexoAscFit(txt)
            end
        end
    end
    return ready
end

