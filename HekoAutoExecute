-- position of a part / model / attachment (nil if it has none)
function NexoObjPos(obj)
    if not obj then return nil end
    local pos
    pcall(function()
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            pos = obj:GetPivot().Position
        elseif obj:IsA("Attachment") then
            pos = obj.WorldPosition
        end
    end)
    return pos
end

-- EVERY object named exactly `name`, in a stable order (X, then Y, then Z) so the walk is repeatable
function NexoAllNamed(name)
    local out = {}
    pcall(function()
        for _, d in ipairs(wsDesc()) do
            if d.Name == name and NexoObjPos(d) then out[#out + 1] = d end
        end
    end)
    pcall(function()
        table.sort(out, function(a, b)
            local pa, pb = NexoObjPos(a), NexoObjPos(b)
            if not pa or not pb then return false end
            if pa.X ~= pb.X then return pa.X < pb.X end
            if pa.Y ~= pb.Y then return pa.Y < pb.Y end
            return pa.Z < pb.Z
        end)
    end)
    return out
end

-- ONE "press F" on a specific object -- mobile safe.
-- 1) fires every ProximityPrompt on the object (and any within 25 studs) -> works with NO keyboard
-- 2) also sends a real F key press for gates that listen for the key instead of a prompt
-- ANTI-LAG (measured on the live client): the "prompts near me" pass in NexoInteractF used to
-- walk the WHOLE workspace -- 132,000+ instances, 53 ms measured -- on EVERY single F press,
-- only to find the 251 ProximityPrompts that actually exist. The prompt list is now built ONCE
-- and kept correct by two cheap events, so the same prompts are found in well under 0.1 ms.
-- Same prompts, same 25-stud rule, same firing: only the searching got cheap.
NexoPromptSet = NexoPromptSet or nil
function NexoPromptList()
    if NexoPromptSet then return NexoPromptSet end
    local set = {}
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.ClassName == "ProximityPrompt" then set[d] = true end
        end
    end)
    NexoPromptSet = set
    pcall(function()
        CONNS[#CONNS + 1] = workspace.DescendantAdded:Connect(function(d)
            if d.ClassName == "ProximityPrompt" then set[d] = true end
        end)
        CONNS[#CONNS + 1] = workspace.DescendantRemoving:Connect(function(d)
            if set[d] then set[d] = nil end
        end)
    end)
    return set
end

function NexoInteractF(obj)
    pcall(function()
        if not fireproximityprompt then return end
        if obj then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
            end
            local parent = obj.Parent
            if parent then
                for _, p in ipairs(parent:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
                end
            end
        end
        -- catch prompts parented somewhere else but physically on top of us
        local mdl = getModel()
        local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
        if hrp then
            local hpos = hrp.Position -- read once, not once per prompt
            for p in pairs(NexoPromptList()) do
