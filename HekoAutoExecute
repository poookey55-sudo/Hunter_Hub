-- ==================== SHADOW RAID (Outer World Raid section) ====================
-- Toggle: "Shadow Raid". Flow:
--   1) find the boss "Lv.1 Shadow Sorcerer" by its client name-tag
--      (Workspace.Characters.Client.Default_Client.BillboardGui.Frame.Frame.TextLabel)
--      and auto-kill it.
--   2) after some damage the boss turns [Immune] -- read from
--      Players.[Username].PlayerGui.HUD.Frame.ContentFrame.BossHP.MainPart.Detail.HP
--      -> go kill the adds: Lv.1 Bunny / Lv.1 Kuro / Lv.1 Shadow Sorcerer / Lv.1 Nue
--   3) all adds dead -> re-check the HP label. Back to a kill-stage number
--      (e.g. 1500000000/2000000000) -> return to the boss. Still [Immune] -> wipe EVERY
--      Default_Client NPC inside a 350 radius (never players, never the boss itself) and
--      keep re-checking until the [Immune] face is removed, then kill the boss.
--   4) boss dead -> "Lv. 10,000 Mahoraga" spawns (seen in BossHP.NameLabel) -> kill it,
--      HP read from the same BossHP.MainPart.Detail.HP label.
--   5) Mahoraga dead -> fire the SAME retry remote the Auto Awk Star Rage raid uses.
-- Declared GLOBAL (no `local`) to avoid consuming main-chunk local registers.
AutoShadowRaidOn        = false
inShadowRaid            = false
SHADOW_RAID_BOSS_TAG    = "lv.1 shadow sorcerer"
SHADOW_RAID_MAHO_TAG    = "mahoraga"
SHADOW_RAID_ADD_TAGS    = { "lv.1 bunny", "lv.1 kuro", "lv.1 shadow sorcerer", "lv.1 nue", "lv.1 shiro" }
SHADOW_RAID_WIPE_RADIUS = 350
shadowRaidBossModel     = nil
shadowRaidSawMaho       = false
shadowRaidBossWasAlive  = false
shadowRaidTick          = 0
-- Targeting lock read by computeTargets: the exact models EVERY attack/skill may hit right now.
shadowRaidAddCache      = {}
shadowRaidBossLocked    = false -- true while the HUD shows [Immune]: the boss is never a valid target

-- HUD boss frame: Players.[Username].PlayerGui.HUD.Frame.ContentFrame.BossHP
-- [Username] is ALWAYS the local player's own name, never a hard-coded one.
function shadowRaidBossFrame()
    local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    -- 1) the exact path first: PlayerGui.HUD.Frame.ContentFrame.BossHP
    local hud = pg:FindFirstChild("HUD")
    if hud then
        local fr = hud:FindFirstChild("Frame")
        local cf = fr and fr:FindFirstChild("ContentFrame")
        local bh = cf and cf:FindFirstChild("BossHP")
        if bh then return bh end
    end
    -- 2) FALLBACK: the HUD gets rebuilt / renamed sometimes -> just find "BossHP" anywhere.
    local found
    pcall(function() found = pg:FindFirstChild("BossHP", true) end)
    return found
end
-- Reads ...BossHP.MainPart.Detail.HP -> "[Immune]" or "1500000000/2000000000".
-- FALLBACK: if that exact chain is missing, take ANY TextLabel named "HP" under the boss frame.
function shadowRaidHpText()
    local bh = shadowRaidBossFrame(); if not bh then return "" end
    local out = ""
    pcall(function()
        local mp = bh:FindFirstChild("MainPart")
        local de = mp and mp:FindFirstChild("Detail")
        local hp = de and de:FindFirstChild("HP")
        if not hp then hp = bh:FindFirstChild("HP", true) end
        if hp then out = tostring(hp.Text) end
    end)
    return out
end
-- ...BossHP.NameLabel -> tells us when "Lv. 10,000 Mahoraga" has spawned
function shadowRaidNameText()
    local bh = shadowRaidBossFrame(); if not bh then return "" end
    local out = ""
    pcall(function()
        local nl = bh:FindFirstChild("NameLabel") or bh:FindFirstChild("NameLabel", true)
        if nl then out = tostring(nl.Text) end
    end)
    return out
end
-- "[Immune]", "[ IMMUNE ]", "<b>Immune</b>" -> all match (letters only, tags stripped)
function shadowRaidTextImmune(t)
    t = string.lower(tostring(t or ""))
    if t == "" then return false end
    t = string.gsub(t, "<[^>]->", "")
    t = string.gsub(t, "[^%a]", "")
    return string.find(t, "immune", 1, true) ~= nil
end
-- FULL detection, 3 independent sources -- if ANY of them says immune, the boss is immune:
--   A) the exact BossHP.MainPart.Detail.HP label
--   B) any visible TextLabel inside the whole boss HP bar (covers renamed/rebuilt HUD children)
--   C) the boss's own world billboard tag above its head
function shadowRaidReadImmune()
    if shadowRaidTextImmune(shadowRaidHpText()) then return true end
    local hit = false
    pcall(function()
        local bh = shadowRaidBossFrame()
        if not bh then return end
        for _, d in ipairs(bh:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and shadowRaidTextImmune(d.Text) then hit = true return end
        end
    end)
    if hit then return true end
    pcall(function()
        local ClientF = Characters and Characters:FindFirstChild("Client")
        if not ClientF then return end
        for _, d in ipairs(clientLabels(ClientF)) do
            if d:IsA("TextLabel") and shadowRaidTextImmune(d.Text) then hit = true return end
        end
    end)
    return hit
end
-- The watcher below refreshes this flag every 0.1s; everything else just reads it, so the whole
-- script always agrees on the current phase within 0.1s.
shadowRaidImmuneFlag = false
function shadowRaidIsImmune()
    return shadowRaidImmuneFlag == true
end
-- Back to kill stage = the label simply is NOT immune any more. The numbers can be ANY format
-- (1500000000/2000000000, 1.5B/2B, 75%, ...) -- we never assume one.
function shadowRaidKillStage()
    return not shadowRaidIsImmune()
end
-- Map client name-tags (Characters.Client.*.BillboardGui...TextLabel) to the real live server
-- NPCs standing under them -- the same proven method the Awakened Star raid uses.
function shadowRaidModelsFromTags(tags)
    local out = {}
    local ClientF = Characters and Characters:FindFirstChild("Client")
    if not ClientF or not NPCsF or not tags then return out end
    local spots = {}
    for _, d in ipairs(clientLabels(ClientF)) do
        if d:IsA("TextLabel") then
            local low = string.lower(tostring(d.Text))
            for _, tg in ipairs(tags) do
                if string.find(low, tg, 1, true) then
                    local rig = d:FindFirstAncestorWhichIsA("Model")
                    local h = rig and rig:FindFirstChild("HumanoidRootPart")
                    if h then table.insert(spots, h.Position) end
                    break
                end
            end
        end
    end
    if #spots == 0 then return out end
    local seen = {}
    for _, m in ipairs(NPCsF:GetChildren()) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h and not seen[m] and nexoValidNpc(m) then
            for _, p in ipairs(spots) do
                if (h.Position - p).Magnitude < 25 then
                    seen[m] = true
                    table.insert(out, m)
                    break
                end
            end
        end
    end
    return out
end
-- Every live Default_Client NPC inside `radius` of you -- players and `skip` (the boss) excluded.
function shadowRaidWipeList(myPos, radius, skip)
    local out = {}
    if not NPCsF or not myPos then return out end
    for _, m in ipairs(NPCsF:GetChildren()) do
        if m ~= skip and nexoValidNpc(m) then
            local h = m:FindFirstChild("HumanoidRootPart")
            if h and (h.Position - myPos).Magnitude <= radius then table.insert(out, m) end
        end
    end
    return out
end
-- The npc that spawns after the Lv.1 Shadow Sorcerer dies has NO nameplate, but its client rig
-- DOES carry a "BossHighlight" (Workspace.Characters.Client.Default_Client.BossHighlight).
-- We use that highlight as the marker and match it to the real server npc by position, exactly
-- the way the nameplate matcher works. Distance is NOT limited here -- if it spawns far away we
-- still go to it.
function shadowRaidHighlightSpots()
    local spots = {}
    local ClientF = Characters and Characters:FindFirstChild("Client")
    if not ClientF then return spots end
    -- NOT clientLabels(): this one matches on instance NAME (BossHighlight), not on a
    -- TextLabel, so it still needs the full descendant list.
    for _, d in ipairs(clientDesc(ClientF)) do
        if string.find(string.lower(d.Name), "bosshighlight", 1, true) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            if rig then
                local p
                pcall(function()
                    local h = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChild("Hitbox")
                    if h and h:IsA("BasePart") then
                        p = h.Position
                    elseif h and h:IsA("Model") then
                        p = h:GetPivot().Position
                    else
                        p = rig:GetPivot().Position
                    end
                end)
                if p then table.insert(spots, p) end
            end
        end
    end
    return spots
end
-- POST-BOSS list: after the Lv.1 Shadow Sorcerer dies we must NOT rely on any name/nameplate
-- filter, because the last npc is nameless. Anything alive that is not you, not another player
-- and not a pet counts. The highlighted boss rig is ALWAYS included, at any distance.
function shadowRaidPostBossList(myPos, radius)
    local out, seen = {}, {}
    if not NPCsF then return out end
    local function ok(m)
        if seen[m] or not m or not m.Parent then return false end
        local h = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if not h or not hum or hum.Health <= 0 then return false end
        local bad = false
        pcall(function()
            if nexoIsPlayerModel(m) or nexoIsPetModel(m) then bad = true end
        end)
        return not bad
    end
    -- 1) anything alive inside the radius (no name required)
    if myPos then
        for _, m in ipairs(NPCsF:GetChildren()) do
            if ok(m) then
                local h = m:FindFirstChild("HumanoidRootPart")
                if h and (h.Position - myPos).Magnitude <= radius then
                    seen[m] = true
                    table.insert(out, m)
                end
            end
        end
    end
    -- 2) the highlighted (nameless) boss rig, wherever it is -- matched to its server npc
    local spots = shadowRaidHighlightSpots()
    if #spots > 0 then
        for _, m in ipairs(NPCsF:GetChildren()) do
            if ok(m) then
                local h = m:FindFirstChild("HumanoidRootPart")
                if h then
                    for _, p in ipairs(spots) do
                        if (h.Position - p).Magnitude < 40 then
                            seen[m] = true
                            table.insert(out, m)
                            break
                        end
                    end
                end
            end
        end
    end
    return out
end
-- True while a highlighted (nameless) boss rig still exists -> never fire the retry yet.
function shadowRaidHighlightUp()
    return #shadowRaidHighlightSpots() > 0
end
function shadowRaidNearest(list, myPos)
    local best, bd
    for _, m in ipairs(list) do
        local h = m:FindFirstChild("HumanoidRootPart")
        if h then
            local d = (h.Position - myPos).Magnitude
            if not bd or d < bd then best, bd = m, d end
        end
    end
    return best
end
-- Stick next to the nearest target and hit the whole list (identical cadence to the other raids:
-- we only fire our own Punch/Black Flash when Fast Attack / Black Flash aren't already running).
function shadowRaidStrike(list, mdl, hrp)
    if not mdl or not hrp or #list == 0 then return end
    -- Our own Punch/Black Flash calls bypass computeTargets, so re-apply the [Immune] rule here:
    -- while the boss is immune it is removed from the swing list, and if nothing else is left we
    -- simply don't attack this tick.
    if shadowRaidBossLocked and shadowRaidBossModel then
        local keep = {}
        for _, m in ipairs(list) do
            if m ~= shadowRaidBossModel then table.insert(keep, m) end
        end
        list = keep
        if #list == 0 then return end
    end
    local near = shadowRaidNearest(list, hrp.Position)
    local nh = near and near:FindFirstChild("HumanoidRootPart")
    if nh then
        pcall(function()
            local goal = auraGoal(nh)
            if (hrp.Position - goal.Position).Magnitude > STICK_OFFSET + 3 then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = goal
            end
        end)
    end
    if not (FastOn or BlackFlashOn) then
        shadowRaidTick = shadowRaidTick + 1
        if shadowRaidTick % 2 == 0 then
            enableBlackFlash()
            task.spawn(pcall, blackFlashList, list, mdl, hrp)
        else
            task.spawn(pcall, attackList, list, mdl, hrp)
        end
    end
end

-- IMMUNE WATCHER: the single source of truth for the phase. Every 0.1s it re-reads the boss HP
-- bar (exact label -> any label in the bar -> the world name-tag) and ALSO watches the boss's real
-- Humanoid health. If the health does not drop for 3s while we are swinging at it, the boss is
-- treated as immune even if the HUD text could not be read at all. Runs on its OWN loop, so the
-- lock never waits for the main raid loop's attack tick.
shadowRaidLastBossHP  = nil
shadowRaidHpStuckAt   = nil
SHADOW_RAID_STALL_SEC = 3
function shadowRaidBossHealth()
    local b = shadowRaidBossModel
    if not b or not b.Parent then return nil end
    local hum = b:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    return hum.Health
end
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if AutoShadowRaidOn then
            local imm = false
            pcall(function() imm = shadowRaidReadImmune() end)
            -- STALL FALLBACK: boss alive but its HP has not moved for 3s -> it is immune.
            pcall(function()
                local hp = shadowRaidBossHealth()
                if hp == nil then
                    shadowRaidLastBossHP, shadowRaidHpStuckAt = nil, nil
                elseif shadowRaidLastBossHP == nil or hp ~= shadowRaidLastBossHP then
                    shadowRaidLastBossHP = hp
                    shadowRaidHpStuckAt = os.clock()
                elseif shadowRaidHpStuckAt and (os.clock() - shadowRaidHpStuckAt) >= SHADOW_RAID_STALL_SEC then
                    imm = true
                end
            end)
            shadowRaidImmuneFlag = imm
            if imm ~= shadowRaidBossLocked then
                shadowRaidBossLocked = imm
                -- phase just flipped -> drop the old pick so nothing keeps swinging at a stale target
                shadowRaidAddCache = {}
                TgtCache = {} -- invalidate the shared per-frame target cache instantly
                QuestScanCache.npcT = -1 -- and the quest NPC list, so nothing swings at a stale target
            end
            task.wait(0.1)
        else
            shadowRaidImmuneFlag = false
            shadowRaidBossLocked = false
            shadowRaidLastBossHP, shadowRaidHpStuckAt = nil, nil
            task.wait(NEXO_IDLE)
        end
    end
end)

task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if AutoShadowRaidOn then
            local mdl = getModel()
            local hrp = mdl and mdl:FindFirstChild("HumanoidRootPart")
            if hrp then
                inShadowRaid = true
                local myPos = hrp.Position
                local bosses = shadowRaidModelsFromTags({ SHADOW_RAID_BOSS_TAG })
                local boss = shadowRaidNearest(bosses, myPos)
                if boss then
                    shadowRaidBossModel = boss
                    shadowRaidBossWasAlive = true
                elseif shadowRaidBossModel and not shadowRaidBossModel.Parent then
                    shadowRaidBossModel = nil
                end
                if (not boss) and shadowRaidBossWasAlive then
                    ------------------------------------------------------------------
                    -- PHASE 4: the Lv.1 Shadow Sorcerer is DEAD -> now kill ANY npc that
                    -- spawns inside 350 studs. This covers "Lv. 10,000 Mahoraga" AND any
                    -- last leftover npc, so nothing is ever left standing before the retry.
                    -- Players and pets are never touched (nexoValidNpc filters them out).
                    ------------------------------------------------------------------
                    shadowRaidBossLocked = false
                    shadowRaidLastBossHP, shadowRaidHpStuckAt = nil, nil
                    local rest = shadowRaidPostBossList(myPos, SHADOW_RAID_WIPE_RADIUS)
                    shadowRaidAddCache = rest
                    if #rest > 0 then
                        -- go to it and kill it (nameless npc included)
                        shadowRaidSawMaho = true
                        shadowRaidStrike(rest, mdl, hrp)
                        task.wait(0.05)
                    elseif shadowRaidHighlightUp() then
                        -- the highlighted nameless rig is there but its server npc has not matched
                        -- yet (still streaming in) -> wait for it, never skip to the retry
                        shadowRaidSawMaho = true
                        task.wait(0.1)
                    else
                        ------------------------------------------------------------------
                        -- PHASE 5: the last npc is dead -> WAIT 2 SECONDS, then fire the AUTO
                        -- RETRY remote (the same one the Auto Awk Star Rage raid uses). If a
                        -- npc/boss shows up again during those 2s we go straight back to killing.
                        ------------------------------------------------------------------
                        clickPopup("next"); clickPopup("close")
                        local gone = true
                        local waited = 0
                        while waited < 2 do
                            task.wait(0.1)
                            waited = waited + 0.1
                            if not AutoShadowRaidOn then gone = false break end
                            local m2 = getModel()
                            local h2 = m2 and m2:FindFirstChild("HumanoidRootPart")
                            local p2 = h2 and h2.Position or myPos
                            if #shadowRaidPostBossList(p2, SHADOW_RAID_WIPE_RADIUS) > 0 then gone = false break end
                            if shadowRaidHighlightUp() then gone = false break end
                            if shadowRaidNearest(shadowRaidModelsFromTags({ SHADOW_RAID_BOSS_TAG }), p2) then gone = false break end
                        end
                        if gone and AutoShadowRaidOn then
                            pcall(function() RetrySignal:InvokeServer() end)
                            shadowRaidSawMaho = false
                            shadowRaidBossWasAlive = false
                            shadowRaidBossModel = nil
                            shadowRaidAddCache = {}
                            task.wait(1)
                        end
                    end
                else
                    if shadowRaidIsImmune() then
                        ------------------------------------------------------------------
                        -- PHASE 2: boss is [Immune] -> kill the 4 listed adds first
                        ------------------------------------------------------------------
                        shadowRaidBossLocked = true -- boss can never be targeted while [Immune]
                        local adds = {}
                        for _, m in ipairs(shadowRaidModelsFromTags(SHADOW_RAID_ADD_TAGS)) do
                            if m ~= shadowRaidBossModel then table.insert(adds, m) end
                        end
                        if #adds > 0 then
                            shadowRaidAddCache = adds
                            shadowRaidStrike(adds, mdl, hrp)
                            task.wait(0.05)
                        else
                            -- adds cleared -> re-check the HP label
                            if shadowRaidKillStage() then
                                shadowRaidBossLocked = false
                                shadowRaidAddCache = {}
                                shadowRaidLastBossHP, shadowRaidHpStuckAt = nil, nil
                                task.wait(0.05) -- back to kill stage: next tick goes for the boss
                            elseif shadowRaidIsImmune() then
                                ----------------------------------------------------------
                                -- PHASE 3: STILL [Immune] -> wipe every Default_Client NPC
                                -- in a 350 radius (no players, never the boss itself) and
                                -- keep checking until the [Immune] face is removed.
                                ----------------------------------------------------------
                                local wipe = shadowRaidWipeList(myPos, SHADOW_RAID_WIPE_RADIUS, shadowRaidBossModel)
                                shadowRaidAddCache = wipe
                                if #wipe > 0 then
                                    shadowRaidStrike(wipe, mdl, hrp)
                                    task.wait(0.05)
                                else
                                    -- nothing left to clear: re-test the boss (fresh 3s stall window)
                                    shadowRaidLastBossHP, shadowRaidHpStuckAt = nil, nil
                                    shadowRaidBossLocked = false
                                    task.wait(0.2)
                                end
                            else
                                shadowRaidBossLocked = false
                                shadowRaidAddCache = {}
                                task.wait(0.1)
                            end
                        end
                    elseif boss then
                        ------------------------------------------------------------------
                        -- PHASE 1: boss is killable -> smash "Lv.1 Shadow Sorcerer"
                        ------------------------------------------------------------------
                        -- final 0.1s-fresh re-check: only swing at the boss if it is STILL not immune
                        if shadowRaidIsImmune() then
                            shadowRaidBossLocked = true
                            shadowRaidAddCache = {}
                            task.wait(0.05)
                        else
                            shadowRaidBossLocked = false
                            shadowRaidAddCache = { boss }
                            shadowRaidStrike({ boss }, mdl, hrp)
                            task.wait(0.05)
                        end
                    else
                        shadowRaidBossLocked = false
                        shadowRaidAddCache = {}
                        clickPopup("next"); clickPopup("close")
                        task.wait(0.3)
                    end
                end
            else
                task.wait(NEXO_IDLE)
            end
        else
            inShadowRaid = false
            shadowRaidAddCache = {}
            shadowRaidBossLocked = false
            shadowRaidSawMaho = false
            shadowRaidBossWasAlive = false
            shadowRaidBossModel = nil
            task.wait(NEXO_IDLE)
        end
    end
end)

-- Auto Summer Raid (SummerSiege). Same engine as the StarRage/Blood raids: TP into the zone part,
-- smash the boss NPCs, then Retry INSTANTLY on clear. The 4 event NPCs are matched by name-tag.
-- Reuses the same CreateIslandQueue / Retry remotes and the shared clickPopup helper.
local AutoSummerRaidOn = false
local inSummerRaid = false
local FastRaidOn = false
-- ISLAND LOCK: in a shared server every player gets their OWN SummerSiege island, but the raid NPCs
-- all use identical name-tags, so an INFINITE-range bring would "steal" NPCs off other players'
-- islands. Islands spawn far apart, so we simply cap every raid bring/target to this radius around
-- YOU. Your own island's NPCs are always inside it; other islands sit far outside it.
-- Raise this if some of YOUR OWN raid NPCs get missed; lower it if islands are close together.
-- RAID_ISLAND_RADIUS is defined globally above (shared by every raid's island-lock)
local RAID_BRING_RANGE = RAID_ISLAND_RADIUS -- Fast Raid bring radius (island-locked, was inf)
local RAID_CLEAR_GRACE = 6 -- secs with NO raid NPC before we treat the raid as CLEARED (ignores wave-gaps)
local SUMMER_BOSS_NAMES = {
    "guy in snorkles",
    "just a chill dude",
    "summer island girl",
    "summer island captain",
    "summer island thug",
}
-- All matching summer-boss client name-tag positions (several NPC types can be up at once)
local function summerTagPositions()
    local hits = {}
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return hits end
    for _, d in ipairs(clientLabels(ClientF)) do
        if d:IsA("TextLabel") then
            local low = string.lower(d.Text)
            for _, nm in ipairs(SUMMER_BOSS_NAMES) do
                if string.find(low, nm, 1, true) then
                    local rig = d:FindFirstAncestorWhichIsA("Model")
                    local h = rig and rig:FindFirstChild("HumanoidRootPart")
                    if h then table.insert(hits, h.Position) end
                    break
                end
            end
        end
    end
    return hits
end
-- Alive server NPCs that belong to the summer raid (near a matching name-tag) within `range` of you.
-- Pass range = nil to get them all regardless of distance.
local function collectSummerNPCs(myHRP, range)
    local out = {}
    if not (myHRP and NPCsF) then return out end
    local tags = summerTagPositions()
    if #tags == 0 then return out end
    for _, m in ipairs(NPCsF:GetChildren()) do
        if not isPunchingBag(m) then
        local h = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if h and hum and hum.Health > 0 then
            local isRaid = false
            for _, pos in ipairs(tags) do
                if (h.Position - pos).Magnitude < 25 then isRaid = true break end
            end
            if isRaid and onMyIsland(h.Position) and (not range or (h.Position - myHRP.Position).Magnitude <= range) then
                table.insert(out, m)
            end
        end
        end
    end
