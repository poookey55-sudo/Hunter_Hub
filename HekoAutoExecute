NexoCTPickList = { "LimitlessExtra" }   -- multi-select: list of CT Extra ids
NexoCTSelected = { LimitlessExtra = true }  -- same thing as a lookup set (fast, built on change only)
function nexoCTSetPick(list)
    NexoCTPickList = list or {}
    local set = {}
    for i = 1, #NexoCTPickList do set[NexoCTPickList[i]] = true end
    NexoCTSelected = set
end
NexoCTAmt  = 0   -- 0 / empty / "all" = keep converting everything (per selected CT)
NexoCTDone = {}  -- [id] = extras already converted toward the target
NexoCTNote = ""
function nexoCTReset()
    NexoCTDone, NexoCTNote = {}, ""
    NexoCTDirty = true
end

task.spawn(function()
    local fails = 0
    while NEXOG.NexoHubSession == SESSION do
        if not AutoCTExchangeOn then
            fails = 0
            task.wait(1)   -- switch off: one cheap check per second, nothing else runs
        else
            -- Round-robin over every selected CT Extra: one exchange per CT per pass, so a
            -- multi-select drains them evenly instead of finishing one before starting the next.
            local did = false
            for i = 1, #NexoCTPickList do
                if not AutoCTExchangeOn then break end
                local e = NexoCTById[NexoCTPickList[i]]
                if e and e[3] then
                    local id     = e[1]
                    local have   = nexoCTCount(id)
                    local done   = NexoCTDone[id] or 0
                    local remain = (NexoCTAmt > 0) and (NexoCTAmt - done) or have
                    if remain >= e[4] and have >= e[4] then
                        nexoCTRemotes()
                        local before = nexoCTDust()
                        if NexoQAccept then pcall(function() NexoQAccept:InvokeServer(e[3]) end) end
                        -- wait for the server to confirm through the inventory feed (max 1.5s)
                        local t0 = os.clock()
                        local after = before
                        while (os.clock() - t0) < 1.5 do
                            task.wait(0.1)
                            after = nexoCTDust()
                            if after ~= before then break end
                        end
                        if after > before then
                            did, fails = true, 0
                            NexoCTDone[id] = done + e[4]
                            NexoCTS.runs = NexoCTS.runs + 1
                            NexoCTS.used = NexoCTS.used + e[4]
                            NexoCTS.dust = NexoCTS.dust + (after - before)
                            NexoCTNote = ""
                            NexoCTDirty = true
                            task.wait(0.25) -- polite gap between exchanges
                        else
                            fails = fails + 1
                            NexoCTNote = "server refused (" .. fails .. "/3)"
                            NexoCTDirty = true
                            if fails >= 3 then
                                AutoCTExchangeOn = false
                                fails = 0
                                pcall(function()
                                    Library:Notify({ Title = "NEXO HUB", Content = "Auto Exchange stopped: the server rejected the exchange", Type = "Warning", Duration = 6 })
                                end)
                            end
                            task.wait(0.5)
                        end
                    end
                end
            end
            if not did then
                -- nothing convertible right now: idle cheaply until new extras drop
                if #NexoCTPickList == 0 then
                    NexoCTNote = "nothing selected"
                else
                    NexoCTNote = "waiting - target reached / not enough extras"
                end
                NexoCTDirty = true
                task.wait(1)
            end
        end
    end
end)

function NexoCTStatusText()
    local L = {}
    local dust = nexoCTDust()
    L[1] = "Cursed Dust  : " .. nexoCTComma(dust)
    local target = (NexoCTAmt > 0) and (NexoCTAmt .. " each") or "all"
    L[#L + 1] = "Selected     : " .. #NexoCTPickList .. " CT  x" .. target
    L[#L + 1] = "Auto Exchange: " .. (AutoCTExchangeOn and "ON" or "OFF") ..
        ((NexoCTNote ~= "") and ("   - " .. NexoCTNote) or "")
    for i = 1, #NexoCTPickList do
        local e = NexoCTById[NexoCTPickList[i]]
        if e then
            local pad  = string.rep(" ", math.max(1, 22 - #e[2]))
            local done = NexoCTDone[e[1]] or 0
            local have = nexoCTCount(e[1])
            L[#L + 1] = "   \226\128\162 " .. e[2] .. pad ..
                (e[3] and ("(" .. e[4] .. " \226\134\146 " .. e[5] .. " dust)") or "(no exchange)") ..
                "  have " .. have ..
                (NexoCTAmt > 0 and ("  done " .. done .. "/" .. NexoCTAmt) or ("  done " .. done))
        end
    end
    L[#L + 1] = "Session      : " .. NexoCTS.runs .. " exchanges  -  " .. NexoCTS.used ..
                " extras used  -  +" .. nexoCTComma(NexoCTS.dust) .. " dust"
    -- cheapest skin you cannot afford yet + how many you can already buy
    local afford, nextName, nextNeed = 0, nil, nil
    for _, sk in ipairs(NexoCTSkins) do
        if dust >= sk[3] then
            afford = afford + 1
        elseif not nextName then
            nextName, nextNeed = sk[2], sk[3] - dust
        end
    end
    L[#L + 1] = "Skins        : " .. afford .. "/" .. #NexoCTSkins .. " affordable" ..
        (nextName and ("   next: " .. nextName .. " (need " .. nexoCTComma(nextNeed) .. " more)") or "   ALL affordable")
    -- owned extras, grouped by grade, with the dust each stack is worth
    for _, g in ipairs(NexoCTOrder) do
        local rows, total = {}, 0
        for _, e in ipairs(NexoCTX) do
            if e[6] == g then
                local c = nexoCTCount(e[1])
                if c > 0 or NexoCTSelected[e[1]] then
                    local pad = string.rep(" ", math.max(1, 22 - #e[2]))
                    local worth = ""
                    if e[3] and e[4] > 0 then
                        local runs = math.floor(c / e[4])
                        if runs > 0 then worth = "   (" .. nexoCTComma(runs * e[5]) .. " dust)" end
                    end
                    rows[#rows + 1] = "  " .. e[2] .. pad .. "= " .. c .. worth
                    total = total + c
                end
            end
        end
        if #rows > 0 then
            L[#L + 1] = ""
            L[#L + 1] = NexoCTGrade[g] .. "   (" .. total .. ")"
            L[#L + 1] = "\226\128\148\226\128\148\226\128\148\226\128\148\226\128\148\226\128\148\226\128\148\226\128\148\226\128\148"
            for _, r in ipairs(rows) do L[#L + 1] = r end
        end
    end
    return table.concat(L, "\n")
end

-- ============================ JUJUTSU TRIAL (Trial Tower) ============================
-- Auto Trial: pick a Chamber (1-11) in the Raid tab, flip the switch, and this loop runs
--   StartTower_Method:InvokeServer("C<n>")  ->  detect + smash that chamber's NPC
--   (same detection path as the raids: client name-tag -> nearest live server NPC)
--   ->  BossIslandService.Return_Method:InvokeServer()  ->  start again, forever.
-- Everything is GLOBAL (no `local`) so we don't burn scarce main-chunk local registers.
TrialOn = false
TrialChamber = 1 -- 1..11, set by the Raid-tab dropdown
-- Chamber -> client name-tag of the NPC that spawns for it (lowercase, substring match)
TRIAL_NPC_TAGS = {
    [1]  = "choso",
    [2]  = "sorcerer killer",
    [3]  = "deadly judge",
    [4]  = "jogo",
    [5]  = "cursed prodigy",
    [6]  = "awakened zen'in",
    [7]  = "awakened lightning god",
    [8]  = "awakened blood user",
    [9]  = "awakened star",
    [10] = "king of curses",
    [11] = "awakened king of curses",
}
-- Lazy remote lookups (wrapped so a missing service never breaks the rest of the hub)
function trialStartRemote()
    local ok, r = pcall(function()
        local svc = Net:FindFirstChild("TrialTowerService")
        return svc and svc:FindFirstChild("StartTower_Method")
    end)
    return ok and r or nil
end
function trialReturnRemote()
    local ok, r = pcall(function()
        local svc = Net:FindFirstChild("BossIslandService")
        return svc and svc:FindFirstChild("Return_Method")
    end)
    return ok and r or nil
end
-- Detect the chamber NPC exactly like the raid/quest detection: find the client name-tag that
-- contains the NPC name, then map it to the NEAREST live server NPC (the damageable model).
-- No island lock here (the trial tower is your own instance), so it is found instantly.
-- ============================== RELIABILITY FIXES ==============================
-- THREE real bugs were making this section random:
--  1) WRONG OWNER: the name-tag pass took the FIRST matching tag anywhere in the
--     Client folder and the fallback took the FIRST server NPC with that name
--     ANYWHERE -- so whoever else was running the same chamber nearby could be
--     picked instead of your own NPC. Both passes now take the match NEAREST TO
--     YOU, require it inside TRIAL_MY_RADIUS, and honour the island filter.
--  2) WRONG CHAMBER: "king of curses" (C10) is a substring of "awakened king of
--     curses" (C11), so C10 happily locked onto the C11 boss (and vice-versa on a
--     re-scan). Tag matching now rejects that overlap explicitly.
--  3) HARD STOP: the fallback pass never ran nexoValidNpc, so it could lock onto a
--     pet / punching bag / player rig, and ANY error in here (a part destroyed
--     mid-scan is enough) propagated out and KILLED the Trial thread for the rest
--     of the session -- that is the "sometimes it just does not work at all".
--     The scan is now fully protected and can never take the loop down.
-- Plus: the loop asks for the NPC 2-3 times per tick, so the result is cached for one
-- tick window (revalidated: still parented, still alive) instead of re-scanning.
TRIAL_MY_RADIUS = 400 -- studs: your own tower NPC is always near you, another player's never is
TRIAL_FIND_TTL  = 0.05 -- share one scan across the calls inside a single tick
TrialFindCache = TrialFindCache or { t = -1, tag = nil, m = nil, h = nil }
function trialResetFind() TrialFindCache.t, TrialFindCache.m, TrialFindCache.h = -1, nil, nil end
-- substring match, but never across chambers that contain each other
function trialTagOk(text, tag)
    local s = string.lower(tostring(text or ""))
    if not string.find(s, tag, 1, true) then return false end
    if tag == "king of curses" and string.find(s, "awakened", 1, true) then return false end
    return true
end
function trialFindNPCRaw(tag)
    if not NPCsF then return nil end
    local myModel = getModel()
    local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
    local myPos = myHRP and myHRP.Position
    local maxD2 = TRIAL_MY_RADIUS * TRIAL_MY_RADIUS
    -- 1) name-tag pass: the matching tag NEAREST TO YOU (your own tower NPC)
    local pos, bestTagD
    local ClientF = Characters and Characters:FindFirstChild("Client")
    if ClientF then
        for _, d in ipairs(clientLabels(ClientF)) do
            if d.ClassName == "TextLabel" and trialTagOk(d.Text, tag) then
                local rig = d:FindFirstAncestorWhichIsA("Model")
                local h = rig and rig:FindFirstChild("HumanoidRootPart")
                if h then
                    local p = h.Position
                    if myPos then
                        local dx, dy, dz = p.X - myPos.X, p.Y - myPos.Y, p.Z - myPos.Z
                        local dd = dx * dx + dy * dy + dz * dz -- squared: no sqrt per tag
                        if dd <= maxD2 and (not bestTagD or dd < bestTagD) then pos, bestTagD = p, dd end
                    elseif not pos then
                        pos = p
                    end
                end
            end
        end
    end
    -- 2) map that tag to the nearest LIVE, VALID server NPC (the damageable model)
    if pos then
        local best, bestD
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            if h then
                local p = h.Position
                local dx, dy, dz = p.X - pos.X, p.Y - pos.Y, p.Z - pos.Z
                local dd = dx * dx + dy * dy + dz * dz
                if dd < 625 and (not bestD or dd < bestD) then -- 25 studs, squared
                    if nexoValidNpc(m) and onMyIsland(p) then best, bestD = m, dd end
                end
            end
        end
        if best then return best, best:FindFirstChild("HumanoidRootPart") end
    end
    -- 3) FALLBACK: no name-tag streamed in yet -> server model name, still nearest to YOU
    local best, bestD
    for _, m in ipairs(NPCsF:GetChildren()) do
        if trialTagOk(m.Name, tag) then
            local h = m:FindFirstChild("HumanoidRootPart")
            if h and nexoValidNpc(m) then
                local p = h.Position
                local dd = 0
                if myPos then
                    local dx, dy, dz = p.X - myPos.X, p.Y - myPos.Y, p.Z - myPos.Z
                    dd = dx * dx + dy * dy + dz * dz
                end
                if dd <= maxD2 and onMyIsland(p) and (not bestD or dd < bestD) then best, bestD = m, dd end
            end
        end
    end
    if best then return best, best:FindFirstChild("HumanoidRootPart") end
    return nil
end
function trialFindNPC(tag)
    if not tag then return nil end
    local c, now = TrialFindCache, os.clock()
    if c.tag == tag and (now - c.t) < TRIAL_FIND_TTL then
        local m, h = c.m, c.h
        if m and h and m.Parent and h.Parent then
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then return m, h end
        elseif m == nil then
            return nil -- nothing was there a moment ago either
        end
    end
    -- CRASH FIX: a failed scan returns nil instead of throwing out of the Trial loop
    local ok, m, h = pcall(trialFindNPCRaw, tag)
    if not ok then m, h = nil, nil end
    c.tag, c.t, c.m, c.h = tag, now, m, h
    if m and h then return m, h end
    return nil
end
-- STALL WATCHDOG: if the locked NPC takes no damage at all for this long, the run is
-- stuck (immune phase, despawned server-side, lingering name-tag). Instead of spinning
-- on it forever -- the other half of "sometimes it stops working" -- we Return and start
-- a fresh run. A normal kill never comes close to this, so nothing changes when it works.
TRIAL_STALL_SEC = 10
TrialRuns, TrialRestarts = 0, 0 -- counters (visible in the Status line)
function trialReturnNow() -- popups + Return, fully protected
    pcall(clickPopup, "next")
    pcall(clickPopup, "close")
    local ret = trialReturnRemote()
    if ret then pcall(function() ret:InvokeServer() end) end
    trialResetFind()
end
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if TrialOn then
            -- CRASH FIX: the whole cycle is protected, so no single bad frame can ever
            -- kill this thread. Before, one error meant Auto Trial was dead until rejoin.
            local ok = pcall(function()
                local tag = TRIAL_NPC_TAGS[TrialChamber] or TRIAL_NPC_TAGS[1]
                local npc, nh = trialFindNPC(tag)
                if npc and nh then
                    -- KILL PHASE: identical to the raid kill path (Black Flash + attack every tick)
                    local lastHP, lastDrop = nil, os.clock()
                    while TrialOn and NEXOG.NexoHubSession == SESSION do
                        npc, nh = trialFindNPC(tag)
                        if not (npc and nh) then break end
                        local hum = npc:FindFirstChildOfClass("Humanoid")
                        local hp = hum and hum.Health
                        if hp and (lastHP == nil or hp < lastHP) then lastHP, lastDrop = hp, os.clock() end
                        if (os.clock() - lastDrop) > TRIAL_STALL_SEC then
                            TrialRestarts = TrialRestarts + 1
                            break -- stuck: fall through to Return + fresh start below
                        end
                        local cur = getModel()
                        local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                        if chrp then
                            pcall(function()
                                chrp.AssemblyLinearVelocity = Vector3.zero
                                chrp.AssemblyAngularVelocity = Vector3.zero -- ANTI-SPIKE: no spin to resolve
                                chrp.CFrame = auraGoal(nh)
                            end)
                            enableBlackFlash()
                            task.spawn(pcall, blackFlashList, {npc}, cur, chrp)
                            task.spawn(pcall, attackList, {npc}, cur, chrp)
                        end
                        task.wait(0.05)
                    end
                    -- NPC dead -> clear popups and RETURN instantly, then the loop starts the next run
                    TrialRuns = TrialRuns + 1
                    trialReturnNow()
                    task.wait(0.1)
                else
                    -- START PHASE: fire StartTower with this chamber's ID ("C1" .. "C11")
                    local st = trialStartRemote()
                    if st then pcall(function() st:InvokeServer("C" .. tostring(TrialChamber)) end) end
                    trialResetFind() -- a new run spawns a new NPC: never trust the old lock
                    local t0, found = os.clock(), false
                    while TrialOn and NEXOG.NexoHubSession == SESSION and (os.clock() - t0) < 4 do
                        if trialFindNPC(tag) then found = true break end
                        task.wait(0.05)
                    end
                    if TrialOn and not found then
                        -- nothing spawned (still inside a finished run) -> Return, then retry immediately
                        trialReturnNow()
                        task.wait(0.1)
                    end
                end
            end)
            if not ok then task.wait(0.2) end -- one bad cycle: brief pause, then carry on
        else
            trialResetFind() -- switch off: drop the lock so the next run starts clean
            task.wait(NEXO_IDLE)
        end
    end
end)
-- Auto-click Trial popups (safety net), same as every raid above.
-- ANTI-LAG: both keywords are handled in ONE PlayerGui pass (was two full walks
-- every 0.3s, i.e. ~7 walks/sec just for this net) and it is fully protected.
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if TrialOn then pcall(clickPopups, "next", "close") end
        task.wait((TrialOn) and 0.3 or NEXO_IDLE)
    end
end)

-- Auto Outer World Raid: DIFFERENT start/retry mechanic -- there is no queue/zone teleport. Instead
-- we fire RaidsService.Ready_Signal every 1s to START and to RETRY. Targeting PRIORITY: the add
-- "Lv.1 Star Remnant" is killed FIRST whenever one is alive; otherwise we smash the boss
-- "Lv.1 Awakened Star". Both are detected by client name-tag then mapped to the nearest live NPC,
-- so if a Star Remnant spawns mid-fight we auto-switch to it, then return to the boss once it dies.
-- Declared GLOBAL (no `local`) to avoid consuming main-chunk local registers (near Luau's 200 cap).
AutoOuterRaidOn = false
inOuterRaid = false
outerBossModel = nil -- remembered Awakened Star boss model (survives client name-tag streaming gaps)
outerBossWasAlive = false -- true once we've engaged the boss, so RETRY only fires AFTER it dies
OUTER_BOSS_TAG = "awakened star" -- Lv.1 Awakened Star (boss)
ReadySignal = Net.RaidsService.Ready_Signal
RetrySignal = Net.RaidsService.RetryRaid_Method -- retry after boss death (RemoteFunction)
function outerFindByTag(tag)
    -- Outer World raid is a shared/open-world boss (not a per-player island) -> NO island range-lock.
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return nil end
    local pos
    for _, d in ipairs(clientLabels(ClientF)) do
        if d:IsA("TextLabel") and string.find(string.lower(d.Text), tag, 1, true) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            local h = rig and rig:FindFirstChild("HumanoidRootPart")
            if h then pos = h.Position break end
        end
    end
    if not pos then return nil end
    if NPCsF then
        local best, bestD
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 and nexoValidNpc(m) then
                local dd = (h.Position - pos).Magnitude
                if dd < 25 and (not bestD or dd < bestD) then best, bestD = m, dd end
            end
        end
        if best then return best, best:FindFirstChild("HumanoidRootPart") end
    end
    return nil
end
-- ALL live "Star Remnant" NPCs (mapped from client name-tags), so every skill/attack can hit every
-- add -- not just the nearest one -- while any remnant is alive. Used by collectTargets override.
function outerTagModels(tag)
    local ClientF = Characters:FindFirstChild("Client")
    if not ClientF then return {} end
    local tagPositions = {}
    for _, d in ipairs(clientLabels(ClientF)) do
        if d:IsA("TextLabel") and string.find(string.lower(d.Text), tag, 1, true) then
            local rig = d:FindFirstAncestorWhichIsA("Model")
            local h = rig and rig:FindFirstChild("HumanoidRootPart")
            if h then table.insert(tagPositions, h.Position) end
        end
    end
    local out = {}
    if #tagPositions > 0 and NPCsF then
        for _, m in ipairs(NPCsF:GetChildren()) do
            local h = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                for _, tp in ipairs(tagPositions) do
                    if (h.Position - tp).Magnitude < 25 then table.insert(out, m) break end
                end
            end
        end
    end
    return out
end
-- PERF refresher: runs the heavy Outer World add/boss scan ONCE ~10x/sec and caches it in
-- outerAddCache, so the per-frame collectTargets override just reads the cache. THIS is what removes
-- the lag -- attacks are unchanged (still every frame) and the targeting logic is identical.
outerAddCache = {}
outerBossHome = nil -- saved CFrame of the Awakened Star boss while it's parked in the VOID (non-nil = boss is voided)
OUTER_VOID_OFFSET = Vector3.new(100000, 0, 100000) -- how far the immune boss is TP'd from its home spot during add phases
outerVoidPausing = false -- true for a brief beat while we void the boss: ALL attacks pause so nothing chases it into the void
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if AutoOuterRaidOn then
            pcall(function()
                local myModel = getModel()
                local myHRP = myModel and myModel:FindFirstChild("HumanoidRootPart")
                if not myHRP then outerAddCache = {} return end
                local myPos = myHRP.Position
                local Players = game:GetService("Players")
                local bossSet = {}
                for _, b in ipairs(outerTagModels(OUTER_BOSS_TAG)) do bossSet[b] = true end
                local alive, tank, tankHP, seen = {}, nil, -1, {}
                local function scanEnemies(folder)
                    if not folder then return end
                    for _, m in ipairs(folder:GetChildren()) do
                        if m:IsA("Model") and m ~= myModel and not seen[m] and not Players:GetPlayerFromCharacter(m) then
                            local h = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                            local hum = m:FindFirstChildOfClass("Humanoid")
                            -- Target NPCs AND the breakable "parts" that spawn in the boss's immune
                            -- phases: parts have a hitbox but NO Humanoid, so we can't check Health --
                            -- just require they exist within range. Real NPCs must still be alive.
                            if h and (h.Position - myPos).Magnitude <= AURA_RANGE and (not hum or hum.Health > 0) then
                                seen[m] = true
                                table.insert(alive, m)
                                -- only real Humanoid enemies can be "the boss"; parts never are
                                if hum and hum.MaxHealth > tankHP then tankHP, tank = hum.MaxHealth, m end
                            end
                        end
                    end
                end
                scanEnemies(NPCsF)
                if ServerF then
                    for _, f in ipairs(ServerF:GetChildren()) do
                        if f:IsA("Folder") and f ~= NPCsF and f ~= PlayersF then scanEnemies(f) end
                    end
                end
                -- Is the boss currently parked in the VOID (we TP'd it away)? outerBossHome holds its
                -- real home CFrame. While voided it's far out of aura range, so the scan only finds the
                -- adds/parts. We still filter it out of the cache in case the server snaps it back.
                local bossVoided = (outerBossModel ~= nil and outerBossHome ~= nil)
                if bossVoided then
                    if outerBossModel.Parent == nil then
                        -- the game removed the boss entirely -> drop our ref so we re-acquire it
                        outerBossHome = nil
                        outerBossModel = nil
                        outerAddCache = alive
                    else
                        local addsOnly = {}
                        for _, m in ipairs(alive) do if m ~= outerBossModel then addsOnly[#addsOnly + 1] = m end end
                        if #addsOnly == 0 then
                            -- ALL outer NPCs dead -> BRING THE BOSS BACK to its home spot and fight it
                            local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                            if br then pcall(function() br.CFrame = outerBossHome end) end
                            outerBossHome = nil
                            outerAddCache = {}
                        else
                            -- outer NPCs still alive -> keep PINNING the boss in the void every tick
                            -- (so the server can't yank it back) and target ONLY the outer NPCs.
                            local br = outerBossModel:FindFirstChild("HumanoidRootPart") or outerBossModel.PrimaryPart
                            if br then pcall(function() br.CFrame = CFrame.new(outerBossHome.Position + OUTER_VOID_OFFSET) end) end
                            outerAddCache = addsOnly
                        end
                    end
                else
                    -- Boss is visible: identify it (name-tag match, else tankiest Humanoid enemy).
                    local bossM
                    for _, m in ipairs(alive) do if bossSet[m] then bossM = m break end end
                    if not bossM then bossM = tank end
                    outerBossModel = bossM
                    local adds = {}
                    if bossM then
                        for _, m in ipairs(alive) do if m ~= bossM then table.insert(adds, m) end end
                    end
                    outerAddCache = adds
                    -- TELEPORT-TO-VOID: the moment any add/part is alive, send the (immune) boss to the
                    -- VOID (save its home CFrame first) so it can't be targeted or soak our damage --
