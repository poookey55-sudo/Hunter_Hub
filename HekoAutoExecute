-- The game's "Interact" interface handler (owner of the Interacted signal the gates listen on).
function NexoInteract()
    if NexoInteractIF then return NexoInteractIF end
    pcall(function()
        local client = LocalPlayer:FindFirstChild("PlayerScripts")
        client = client and client:FindFirstChild("Client")
        if not client then return end
        local IC = require(client.Controllers.InterfaceController)
        NexoInteractIF = IC:GetInterfaceHandler("Interact")
    end)
    return NexoInteractIF
end

-- REPAIR the sleitnick shared free-runner thread if a previous error left it dead.
-- This is the actual source of "cannot resume dead coroutine", so it is fixed, not muted.
-- Cheap: one status() check, and it only writes when the thread is genuinely dead.
function NexoSignalHeal()
    local h = NexoInteract()
    if not h or not h.Interacted then return false end
    local fired = false
    pcall(function()
        local fire = h.Interacted.Fire
        if type(fire) ~= "function" then return end
        if type(debug) ~= "table" or type(debug.getupvalue) ~= "function" or type(debug.setupvalue) ~= "function" then return end
        local runner, deadIdx
        for i = 1, 8 do
            local ok, v = pcall(debug.getupvalue, fire, i)
            if not ok then break end
            if typeof(v) == "thread" and coroutine.status(v) == "dead" then deadIdx = i end
            if typeof(v) == "function" then runner = v end
        end
        if not deadIdx then return end
        -- prefer a fresh live runner thread; fall back to clearing it so Fire rebuilds it itself
        local ok = false
        if runner then ok = pcall(debug.setupvalue, fire, deadIdx, coroutine.create(runner)) end
        if not ok then pcall(debug.setupvalue, fire, deadIdx, nil) end
        fired = true
    end)
    return fired
end

-- Is this gate open? The prompt being disabled is the game's own completion marker.
-- NOTE: PointLight / ParticleEmitter state is deliberately NOT used as the signal. Two reasons:
--   1) live probe showed lightEnabled = false on all 10 gates while the prompts were still
--      enabled, so the light is simply not a reliable state marker here; and
--   2) "Remove NPCs & Map (Visual)" disables Lights/Beams/Particles under Map, which would make
--      light-based detection report every gate as already open. It never touches ProximityPrompts,
--      so this check stays correct with that toggle on or off.
function nexoGateOpen(e)
    if not e then return false end
    local p = e.prompt
    if not p then return false end
    local ok, enabled = pcall(function() return p.Parent ~= nil and p.Enabled end)
    if not ok then return true end -- prompt destroyed => gate consumed
    return not enabled
end

-- Find the game's OWN interaction handler for this exact prompt, by matching the closure upvalue
-- that OnInteracted captured. Cached per gate: the connection list is long, the lookup is not free.
function NexoGateHandler(e)
    if e.conn and e.conn.Connected then return e.conn end
    e.conn = nil
    local h = NexoInteract()
    if not h or not h.Interacted or not e.prompt then return nil end
    if type(debug) ~= "table" or type(debug.getupvalues) ~= "function" then return nil end
    pcall(function()
        local item = h.Interacted._handlerListHead
        while item do
            if item.Connected and type(item._fn) == "function" then
                local ok, ups = pcall(debug.getupvalues, item._fn)
                if ok and type(ups) == "table" then
                    for _, v in pairs(ups) do
                        if v == e.prompt then e.conn = item return end
                    end
                end
            end
            item = item._next
        end
    end)
    return e.conn
end

-- ONE interaction attempt on ONE gate, always in a FRESH thread that we own.
-- We never resume, cancel or reuse a thread here, so this path cannot raise a dead-coroutine error
-- and cannot kill the signal library's shared runner thread either.
function NexoGateInteract(e)
    local conn = NexoGateHandler(e)
    if conn then
        local co = coroutine.create(function() conn._fn(e.prompt) end)
        local ok, err = coroutine.resume(co) -- fresh thread, resumed exactly once, never again
        if ok then return true end
        if err and tostring(err):find("dead coroutine") then NexoSignalHeal() end
        return false
    end
    -- Handler not registered yet (quest not focused on this client). Heal + let the game's own
    -- signal path try once, then fall back to the legacy prompt fire. No key press, no spam.
    NexoSignalHeal()
    local h = NexoInteract()
    if h and h.Interacted then
        local co = coroutine.create(function() h.Interacted:Fire(e.prompt) end)
        local ok, err = coroutine.resume(co)
        if not ok and err and tostring(err):find("dead coroutine") then NexoSignalHeal() end
    end
    pcall(function()
        if e.prompt and fireproximityprompt then fireproximityprompt(e.prompt) end
    end)
    return false
end

-- Open ONE gate through the game's own interaction system, verifying after every attempt.
-- Returns true only once the gate is CONFIRMED open (prompt disabled / destroyed).
-- Bounded by attempts AND by a wall-clock deadline, so a gate that refuses to open can never
-- hang the walker: it is left closed, reported, and retried on the next pass instead.
function nexoOpenGate(e)
    if nexoGateOpen(e) then return true end
    local deadline = os.clock() + LAZY_GATE_DEADLINE
    for _ = 1, LAZY_GATE_TRIES do
        if (not LazyFogOn) or NEXOG.NexoHubSession ~= SESSION then return false end
        if os.clock() > deadline then break end
        NexoGateInteract(e)
        task.wait(LAZY_GATE_CHECK)
        if nexoGateOpen(e) then return true end -- confirmed before moving on
        -- still shut: we may have drifted out of the 8-stud activation range, so re-seat and retry
        pcall(function() nexoTpTo(e.pos + Vector3.new(0, 3, 0)) end)
    end
    return nexoGateOpen(e)
end

-- Last-resort completion nudge. Live-verified remote: QuestService.FinishTengen_Signal (RemoteEvent,
-- fired with no arguments). Only ever used when every gate reports open but the quest did not close
-- itself out -- never per gate, so the remote is never spammed.
function NexoFinishTengen()
    if not NexoTengenSig then
        pcall(function() NexoTengenSig = Net.QuestService.FinishTengen_Signal end)
    end
    if NexoTengenSig then pcall(function() NexoTengenSig:FireServer() end) end
end

-- Every DISTINCT FogSealedGate in the world, as a fixed snapshot of POSITIONS.
-- Why a snapshot of positions instead of live objects: the gates get consumed / re-parented while
-- you clear them, which was making the walk lose its place and skip gates. Positions can't vanish,
-- so once we snapshot 10 of them we always visit all 10, one by one.
-- Scoped to the exact folder the game itself queries, and dedupes anything closer than
-- LAZY_FOG_DEDUPE studs so one gate is never counted (or visited) twice.
LAZY_FOG_DEDUPE = 8
function NexoFogPoints()
    local raw = {}
    local root = NexoFogRoot()
    local ok, all = pcall(function() return root:GetDescendants() end)
    if ok and type(all) == "table" then
        for _, d in ipairs(all) do
            if d.Name == LAZY_FOG_PART then
                local p = NexoObjPos(d)
                if p then
                    -- grab the gate's real prompt now: it is the open/closed source of truth AND
                    -- the key the game's interaction handler is registered against
                    local prompt = nil
                    pcall(function()
                        local pp = d.PrimaryPart
                        if pp then prompt = pp:FindFirstChildWhichIsA("ProximityPrompt") end
                        if not prompt then prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true) end
                    end)
                    raw[#raw + 1] = { pos = p, obj = d, prompt = prompt, conn = nil }
                end
            end
        end
    end
    -- stable order (X, then Y, then Z) so the 1-by-1 walk is the same every run
    pcall(function()
        table.sort(raw, function(a, b)
            if a.pos.X ~= b.pos.X then return a.pos.X < b.pos.X end
            if a.pos.Y ~= b.pos.Y then return a.pos.Y < b.pos.Y end
            return a.pos.Z < b.pos.Z
        end)
    end)
    local out = {}
    for _, e in ipairs(raw) do
        local dupe = false
        for _, k in ipairs(out) do
            if (k.pos - e.pos).Magnitude <= LAZY_FOG_DEDUPE then dupe = true break end
        end
        if not dupe then out[#out + 1] = e end
    end
    return out
end

-- LAZY SORCERER WORKER -- exact flow:
--   accept "TengenFog" -> wait -> TP gate 1 -> OPEN gate 1 (confirmed) -> TP gate 2 -> ...
-- A gate is only left behind once its prompt is confirmed disabled, so the walker never teleports
-- onward from a gate it did not open. Gates that resist are retried on the next pass rather than
-- blocking the queue, and the pass counter caps the whole run so it can never loop forever.
LAZY_FOG_ACCEPT_WAIT = 1.5  -- after accepting the quest, before the first teleport
LAZY_FOG_STEP_WAIT   = 0.35 -- after a gate is confirmed open, before moving to the next one
LAZY_FOG_TP_SETTLE   = 0.15 -- tiny pause so the teleport actually applies before we interact

-- SINGLE SUPERVISED WORKER.
-- Duplicate Auto Quest loops were the other way this feature broke: every re-execute of the hub
-- (or a fast toggle off/on) used to leave another walker alive, and two walkers fighting over the
-- character is what made it look like it was "stuck teleporting between gates".
-- Rules enforced here:
--   * one generation token -- an older worker sees the mismatch and returns on its next tick;
--   * a live worker is never re-spawned, never resumed and never cancelled (a cancelled thread is
--     precisely what later becomes a "dead coroutine"), it is asked to exit and it exits;
--   * a new worker is only created when the previous one is genuinely dead.
function NexoLazyWorkerBody(gen)
    while NEXOG.NexoHubSession == SESSION and NEXOG.NexoLazyGen == gen do
        if not LazyFogOn then
            task.wait(NEXO_IDLE)
        else
            NexoSafeAccept("TengenFog") -- accept ONCE per run
            task.wait(LAZY_FOG_ACCEPT_WAIT)
            NexoSignalHeal() -- clear any dead runner thread left behind before we start
            local pass, total, done = 0, 0, 0
            repeat
                pass = pass + 1
                local pts = NexoFogPoints()
                total, done = #pts, 0
                if total == 0 then break end
                for _, e in ipairs(pts) do -- one gate per step, all of them, in order
                    if (not LazyFogOn) or NEXOG.NexoHubSession ~= SESSION
                        or NEXOG.NexoLazyGen ~= gen then break end
                    if nexoGateOpen(e) then
                        done = done + 1 -- already cleared: never re-visit or re-interact with it
                    else
                        pcall(function() nexoTpTo(e.pos + Vector3.new(0, 3, 0)) end)
                        task.wait(LAZY_FOG_TP_SETTLE)
                        if nexoOpenGate(e) then -- CONFIRMED open before we move on
                            done = done + 1
                            task.wait(LAZY_FOG_STEP_WAIT)
                        end
                        -- not opened: leave it for the next pass instead of stalling here
                    end
                end
            until done >= total or pass >= LAZY_GATE_PASSES
                or (not LazyFogOn) or NEXOG.NexoHubSession ~= SESSION
                or NEXOG.NexoLazyGen ~= gen

            if LazyFogOn and NEXOG.NexoLazyGen == gen then
                if total == 0 then
                    task.wait(1) -- no gates in the world yet (or quest already finished): look again
                elseif done >= total then
                    -- Every gate confirmed open. The game fires FinishTengen itself when its own
                    -- counter completes; this nudge only covers the case where some gates were
                    -- already open before we started, so that counter never reached the total.
                    NexoFinishTengen()
                    LazyFogOn = false -- all gates cleared -> stop and auto-off the switch
                    Settings["LazyFogOn"] = false
                    pcall(function() saveSettings() end)
                    pcall(function() Library:Notify({
                        Title = "NEXO HUB",
                        Content = "Lazy Sorcerer: all " .. total .. " FogSealedGate done - stopped",
                        Type = "Success", Duration = 4,
                    }) end)
                else
                    LazyFogOn = false -- hit the pass ceiling: stop cleanly instead of looping forever
                    Settings["LazyFogOn"] = false
                    pcall(function() saveSettings() end)
                    pcall(function() Library:Notify({
                        Title = "NEXO HUB",
                        Content = "Lazy Sorcerer: " .. done .. "/" .. total ..
                                  " gates opened - stopped (accept the quest, then retry)",
                        Type = "Error", Duration = 5,
                    }) end)
                end
            end
        end
    end
end

function NexoLazyEnsureWorker()
    local t = NEXOG.NexoLazyThread
    -- a worker that is still alive keeps running: we never resume or re-spawn an existing thread
    if typeof(t) == "thread" and coroutine.status(t) ~= "dead" and NEXOG.NexoLazyOwner == SESSION then
        return t
    end
    local gen = (NEXOG.NexoLazyGen or 0) + 1
    NEXOG.NexoLazyGen = gen -- older worker (if any) retires itself on its next tick
    NEXOG.NexoLazyOwner = SESSION
    NEXOG.NexoLazyThread = task.spawn(function() -- always a NEW function, never a stored thread
        NexoLazyWorkerBody(gen)
        if NEXOG.NexoLazyGen == gen then NEXOG.NexoLazyThread = nil end -- clean up on exit
    end)
    return NEXOG.NexoLazyThread
end

NexoLazyEnsureWorker()


