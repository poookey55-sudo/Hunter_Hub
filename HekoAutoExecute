            end
        end)
    end
    if not n then
        n = 0
        local d = nexoPlayerData()
        if d and d.Inventory and d.Inventory.Items then
            for _, it in pairs(d.Inventory.Items) do
                if type(it) == "table" and it.ConfigID == SHIKI_ESSENCE_ID then
                    n = n + (tonumber(it.Count) or 1)
                end
            end
        end
    end
    ShikiEssCache.n, ShikiEssCache.t = n, os.clock()
    return n
end

-- Fire ONLY the altars that are still unused. Returns how many were fired.
-- The game drives altars through NetworkController's wrapped remote method, not a bare
-- InvokeServer. Verified live over MCP: GetRemoteMethod("QuestService", "TenShadows_UseAltar")
-- returns a table whose :Call(set, index) yields a promise; :await() gives the result. Firing it
-- this way is what lets us CONFIRM each placement instead of firing blind.
function nexoAltarMethod()
    if NexoAltarMethod then return NexoAltarMethod end
    pcall(function()
        local nc = require(game:GetService("Players").LocalPlayer
            .PlayerScripts.Client.Controllers.NetworkController)
        NexoAltarMethod = nc.GetRemoteMethod("QuestService", "TenShadows_UseAltar")
    end)
    return NexoAltarMethod
end

-- Places essence on ONE altar and waits for the SERVER to confirm by flipping Used.
-- Returns true only on confirmed success so the caller can retry instead of spamming.
function nexoActivateOne(a, idx)
    if a:GetAttribute("Used") then return true end -- never re-fire a finished altar
    local m = nexoAltarMethod()
    if m then
        pcall(function() m:Call(SHIKI_SET, idx):await() end)
    else
        local rem = nexoAltarRemote()
        if not rem then return false end
        pcall(function() rem:InvokeServer(SHIKI_SET, idx) end)
    end
    local deadline = os.clock() + 2
    while os.clock() < deadline do
        if a:GetAttribute("Used") then return true end
        task.wait(0.05)
    end
    return a:GetAttribute("Used") and true or false
end

-- Activates every REMAINING altar one at a time, confirming each before moving on and retrying
-- a failure up to 3 times. Used altars are skipped, so a 4/6 set fires exactly 2 remotes.
function nexoActivateAltars()
    local f = nexoAltarSet()
    if not f then return 0 end
    local done = 0
    for _, a in ipairs(f:GetChildren()) do
        if not AutoShikigamiOn then break end
        if not a:GetAttribute("Used") then
            local idx = tonumber(string.match(a.Name, "%d+"))
            if idx then
                for attempt = 1, 3 do
                    if not AutoShikigamiOn then break end
                    ShikiAction = "Placing essence on Altar " .. idx
                        .. (attempt > 1 and ("  (retry " .. (attempt - 1) .. ")") or "")
                    if nexoActivateOne(a, idx) then
                        done = done + 1
                        ShikiAltarDirty = true
                        break
                    end
                    task.wait(0.25)
                end
            end
        end
    end
    if done > 0 then ShikiAltarDirty = true end
    ShikiAction = "-"
    return done
end

-- ---------------------------------------------------------------------------------------------
-- LIVE-VERIFIED BOSS FACTS (inspected in-game, do not "simplify" these):
--   * A summoned shikigami is NOT named "Lv.1 Mahoraga". It appears in workspace.Characters.
--     Server.NPCs as a random-id model, e.g. "KE2758IARmQi_Server", with ZERO attributes.
--   * Its Humanoid is a decoy that always reads Health=100 / MaxHealth=100.
--   * The REAL health lives in a text label at:
--       <model>.HumanoidRootPart.CharDebug.Frame.Health.TextLabel  ->  "HP: 238623003 / 250000001"
-- Every previous version filtered on the name and on nexoIsLv1(), so the boss was rejected and the
-- farm loop never engaged, and it read HP off the decoy Humanoid so the panel showed nonsense.
-- ---------------------------------------------------------------------------------------------

-- Parse the boss's TRUE current/max HP out of its CharDebug plate. Returns nil when unavailable.
function nexoBossHPOf(m)
    if not m then return nil, nil end
    local hrp = m:FindFirstChild("HumanoidRootPart")
    local dbg = hrp and hrp:FindFirstChild("CharDebug")
    local fr = dbg and dbg:FindFirstChild("Frame")
    local hp = fr and fr:FindFirstChild("Health")
    local lb = hp and hp:FindFirstChildOfClass("TextLabel")
    if not lb then return nil, nil end
    local a, b = string.match(tostring(lb.Text), "([%d%.]+)%s*/%s*([%d%.]+)")
    return tonumber(a), tonumber(b)
end

-- Aliveness via the real HP plate, NOT the decoy Humanoid (which never drops below 100).
function nexoBossAlive(m)
    if not m or not m.Parent then return false end
    local c = nexoBossHPOf(m)
    if c then return c > 0 end
    local hum = m:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- Name-agnostic detector: the nearest LIVING non-player, non-pet NPC to the summon circle.
-- This is what actually finds a freshly summoned shikigami.
function nexoShikiSpawnTarget(radius)
    if not NPCsF then return nil end
    local best, bd
    for _, m in ipairs(NPCsF:GetChildren()) do
        if m:IsA("Model") and not shadowInShikiFolder(m)
            and not nexoIsPetModel(m) and not nexoIsPlayerModel(m) then
            local h = m:FindFirstChild("HumanoidRootPart")
            if h and nexoBossAlive(m) then
                local dd = (h.Position - SHIKI_POS).Magnitude
                if dd <= (radius or 400) and (not bd or dd < bd) then best, bd = m, dd end
            end
        end
    end
    return best
end

-- Push the CURRENT boss's identity/HP/damage into the panel globals. Cheap, called each tick.
function nexoShikiTrack(t)
    if not t then return end
    ShikiBossModel = t
    local nm
    pcall(function() nm = nexoShikiModelName(t) end)
    if nm and nm ~= "" then
        local lab = nm
        pcall(function() lab = nexoShikiLabel(nm) end)
        ShikiBossName = lab
    elseif ShikiBossName == nil or ShikiBossName == "None" or ShikiBossName == "-" then
        ShikiBossName = "Shikigami"
    end
    local c, mx = nexoBossHPOf(t)
    if c and mx and mx > 0 then
        if (ShikiBossMaxHP or 0) <= 0 or mx > ShikiBossMaxHP then ShikiBossMaxHP = mx end
        ShikiBossHP = NexoComma(math.floor(c)) .. " / " .. NexoComma(math.floor(mx))
            .. "  (" .. math.floor((c / mx) * 100) .. "%)"
        ShikiDamage = math.max((ShikiBossMaxHP or mx) - c, 0)
    end
end

-- The status paragraph is created one line tall with AutomaticSize=None, so a 14-line string was
-- being CLIPPED to its first row -- that is why the panel only ever showed "Auto Summon OFF".
-- The data was always correct. Measured live: label 581x12.5 -> 581x140 after this fix.
-- The label is cached, so this is a no-op lookup on every repaint after the first.
function nexoShikiFitPanel()
    local l = ShikiFitLbl
    if l and l.Parent then
        if l.AbsoluteSize.Y + 1 < l.TextBounds.Y then
            pcall(function() l.Size = UDim2.new(1, 0, 0, 0) end)
        end
        return
    end
    ShikiFitLbl = nil
    local plr = game:GetService("Players").LocalPlayer
    local pg = plr and plr:FindFirstChild("PlayerGui")
    local hub = pg and pg:FindFirstChild("NexoHub")
    if not hub then return end
    for _, d in ipairs(hub:GetDescendants()) do
        if d:IsA("TextLabel") and d.Name == "Body" then
            local p = d.Parent
            local t = p and p:FindFirstChild("Title")
            if t and t:IsA("TextLabel") and tostring(t.Text) == "Shikigami Status" then
                pcall(function()
                    d.TextWrapped = false
                    d.TextXAlignment = Enum.TextXAlignment.Left
                    d.AutomaticSize = Enum.AutomaticSize.Y
                    d.Size = UDim2.new(1, 0, 0, 0)
                    p.AutomaticSize = Enum.AutomaticSize.Y
                    p.Size = UDim2.new(p.Size.X.Scale, p.Size.X.Offset, 0, 0)
                end)
                ShikiFitLbl = d
                return
            end
        end
    end
end

-- Live shikigami target: selector-driven name match first (so the dropdown still steers Auto Kill),
-- then the name-agnostic summon-circle detector as the fallback that actually catches summons.
function nexoShikiTarget()
    local tags = shadowWantedTags()
    local t = findShadowTarget(tags)
    if not t then t = findShikiNear(SHIKI_POS, 400) end
    if not t then t = nexoShikiSpawnTarget(400) end
    return t
end

-- One attack tick against a resolved target. Shared by the summon farm and Auto Kill Shikigami so
-- there is exactly ONE piece of code that ever moves/attacks on this tab.
function nexoShikiStrike(t, cur, chrp)
    local h = t:FindFirstChild("HumanoidRootPart")
    if h then
        pcall(function()
            chrp.AssemblyLinearVelocity = Vector3.zero
            chrp.AssemblyAngularVelocity = Vector3.zero
            chrp.CFrame = CFrame.new(h.Position + Vector3.new(0, 0, 6))
        end)
        nexoLockAt(h.Position + Vector3.new(0, 0, 6))
    end
    if ShikiBossModel ~= t then
        ShikiBossMaxHP, ShikiDamage = 0, 0 -- new boss: reset the damage baseline to ITS full bar
        pcall(function()
            local hum = t:FindFirstChildOfClass("Humanoid")
            local _c0, _mx0 = nexoBossHPOf(t)
            if _mx0 and _mx0 > 0 then
                ShikiBossMaxHP = _mx0 -- true bar (decoy Humanoid always says 100)
            elseif hum then
                ShikiBossMaxHP = hum.MaxHealth
            end
        end)
    end
    ShikiBossModel = t -- tracked so the status panel can read HP live between strikes
    local base = nexoShikiBaseOf(t)
    ShikiBossName = base and nexoShikiLabel(base) or tostring(t.Name)
    ShikiFarm = "Fighting"
    ShikiAction = "Attacking " .. tostring(ShikiBossName)
    local npcs = { t }
    shadowTick = shadowTick + 1
    if shadowTick % 2 == 0 then
        enableBlackFlash()
        task.spawn(pcall, blackFlashList, npcs, cur, chrp)
    else
        task.spawn(pcall, attackList, npcs, cur, chrp)
    end
end

function NexoShikiStatusText()
    -- Pulled fresh on every repaint so the panel is live even while Auto Summon is OFF. Previously
    -- these only refreshed inside the Auto Summon branch, so an idle panel showed a stale 0 essence
    -- and 0/6 pillars. Both reads are event-driven/cached, so this costs effectively nothing.
    ShikiActive, ShikiTotal = nexoAltarCount()
    ShikiEssence = nexoEssenceCount()
    ShikiNeed = math.max(ShikiTotal - ShikiActive, 0)
    if ShikiBossModel and ShikiBossModel.Parent then
        -- Real HP plate, never the decoy Humanoid.
        local c, mx = nexoBossHPOf(ShikiBossModel)
        if c and mx and mx > 0 then
            if (ShikiBossMaxHP or 0) <= 0 or mx > ShikiBossMaxHP then ShikiBossMaxHP = mx end
            ShikiBossHP = NexoComma(math.floor(c)) .. " / " .. NexoComma(math.floor(mx))
                .. "  (" .. math.floor((c / mx) * 100) .. "%)"
            ShikiDamage = math.max((ShikiBossMaxHP or mx) - c, 0)
        end
    elseif ShikiBossModel then
        ShikiBossModel, ShikiBossHP = nil, "-"
    end
    -- "Essence Required" = how many altars still need feeding.
    -- "Essence Short"    = how many MORE essence you must farm before a summon can even start.
    -- Showing both removes the old ambiguity where the panel read "Required 6" while you held 4
    -- and it was not obvious that you were exactly 2 short.
    local short = math.max(ShikiNeed - (tonumber(ShikiEssence) or 0), 0)
    local gate
    if ShikiNeed <= 0 then
        gate = "Ready - All Pillars Active"
    elseif short > 0 then
        gate = "BLOCKED - Need " .. short .. " More Essence"
    else
        gate = "Ready To Summon"
    end
    local function onOff(v) return v and "ON" or "OFF" end
    local dmg = (ShikiDamage and ShikiDamage > 0) and NexoComma(math.floor(ShikiDamage)) or "-"
    return table.concat({
        "Auto Summon        " .. onOff(AutoShikigamiOn),
        "Auto Kill          " .. onOff(AutoKillShikigamiOn),
        "Shadow Essence     " .. tostring(ShikiEssence),
        "Pillars Activated  " .. tostring(ShikiActive) .. " / " .. tostring(ShikiTotal),
        "Essence Required   " .. tostring(ShikiNeed),
        "Essence Short      " .. tostring(short),
        "Gate               " .. gate,
        "Summon Status      " .. tostring(ShikiState),
        "Farming Status     " .. tostring(ShikiFarm),
        "Current Action     " .. tostring(ShikiAction),
        "Current Shikigami  " .. tostring(ShikiBossName),
        "Shikigami HP       " .. tostring(ShikiBossHP),
        "Damage Dealt       " .. dmg,
        "Cycles Completed   " .. tostring(ShikiCycles),
    }, "\n")
end

-- ONE loop owns the character on this tab. Auto Summon has priority; Auto Kill Shikigami runs only
-- when the summon engine is not mid-cycle, so the two can never fight over teleports or attacks.
task.spawn(function()
    while NEXOG.NexoHubSession == SESSION do
        if AutoShikigamiOn then
            ShikiState = "Checking Inventory"
            ShikiFarm = "Checking"
            ShikiAction = "Reading inventory and altars"
            ShikiActive, ShikiTotal = nexoAltarCount()
            ShikiEssence = nexoEssenceCount()
            ShikiNeed = math.max(ShikiTotal - ShikiActive, 0)

            if ShikiNeed > 0 and ShikiEssence < ShikiNeed then
                -- Not enough to COMPLETE the set -> do not start, do not waste essence.
                ShikiState = "Waiting - Need " .. ShikiNeed .. " Essence (have " .. ShikiEssence .. ")"
                ShikiFarm = "Waiting"
                ShikiAction = "Short " .. math.max(ShikiNeed - ShikiEssence, 0) .. " essence"
                if ShikiForcedCombat then shikiSetCombat(false) end
                task.wait(1)
            elseif ShikiNeed > 0 then
                -- Activate ONLY the missing pillars (4/6 active -> fires exactly 2).
                ShikiState = "Activating Pillars"
                ShikiFarm = "Activating"
                nexoActivateAltars()
                ShikiState = "Summoning"
                ShikiFarm = "Summoning"
                task.wait(0.3)
            else
                -- 6/6 active: wait for the spawn, then fight it.
                ShikiState = "Waiting For Spawn"
                ShikiFarm = "Summoning"
                ShikiAction = "Waiting for spawn"
                local boss, deadline = nil, os.clock() + 45
                while AutoShikigamiOn and os.clock() < deadline do
                    boss = nexoShikiTarget()
                    if boss then break end
                    task.wait(0.15)
                end
                if boss then
                    ShikiCycles = ShikiCycles + 1
                    ShikiState = "Fighting"
                    ShikiFarm = "Moving"
                    ShikiAction = "Moving to boss"
                    nexoShikiTrack(boss)
                    shikiSetCombat(true)
                    local guard = os.clock() + 300
                    local lost = 0
                    while AutoShikigamiOn and os.clock() < guard do
                        -- Keep hitting THIS boss while it lives; only re-acquire when it truly dies
                        -- or despawns. Death is judged by the real HP plate, not the decoy Humanoid.
                        if not nexoBossAlive(boss) then
                            local nxt = nexoShikiTarget()
                            if nxt and nexoBossAlive(nxt) and nxt ~= boss then
                                boss = nxt
                                ShikiBossMaxHP, ShikiDamage = 0, 0
                                nexoShikiTrack(boss)
                            else
                                break -- confirmed dead: stop swinging at a corpse
                            end
                        end
                        local cur = getModel()
                        local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
                        if chrp then
                            lost = 0
                            ShikiFarm = "Fighting"
                            nexoShikiStrike(boss, cur, chrp) -- re-teleports each tick, so it tracks movement
                            nexoShikiTrack(boss)
                        else
                            lost = lost + 1
                            ShikiAction = "Waiting for character"
                            if lost > 200 then break end -- ~10s with no rig: bail instead of hanging
                        end
                        task.wait(0.05)
                    end
                    shikiSetCombat(false)
                    ShikiBossName, ShikiBossHP, ShikiBossModel = "None", "-", nil
                    ShikiBossMaxHP, ShikiDamage = 0, 0
                    ShikiState = "Completed"
                    ShikiFarm = "Returning"
                    ShikiAction = "Returning to summon area"
                    pcall(function() nexoTpTo(SHIKI_KILL_POS) end)
                    ShikiAltarDirty = true
                    -- Kick the essence cache so the next pass sees post-kill stock, not a value
                    -- cached moments before the boss died.
                    ShikiEssCache.t = -1
                    task.wait(0.4) -- loop straight back: re-check essence and summon again
                else
                    ShikiState = "Waiting"
                    ShikiFarm = "Waiting"
                    ShikiAction = "No shikigami found near the circle"
                    task.wait(0.5)
                end
            end

        elseif AutoKillShikigamiOn then
            if ShikiState ~= "Idle" then ShikiState = "Idle" end
            if ShikiFarm ~= "Hunting" then
                ShikiFarm = "Hunting"
                ShikiAction = "Scanning for shikigami"
            end
            local cur = getModel()
            local chrp = cur and cur:FindFirstChild("HumanoidRootPart")
            if chrp then
                -- nexoShikiTarget() already tries the selector name match FIRST and only then the
                -- name-agnostic summon-circle detector, so the old nexoIsLv1/shadowNameOk gate here
                -- was pure dead weight: it re-rejected the very boss the detector had just found.
                local t = nexoShikiTarget()
                if t and nexoBossAlive(t) then
                    ShikiFarm = "Fighting"
                    nexoShikiStrike(t, cur, chrp)
                    nexoShikiTrack(t)
                    task.wait(0.05)
                else
                    if ShikiFarm ~= "Hunting" then
                        ShikiFarm = "Hunting"
                        ShikiAction = "Scanning for shikigami"
                    end
                    ShikiBossName, ShikiBossHP, ShikiBossModel = "None", "-", nil
                    ShikiBossMaxHP, ShikiDamage = 0, 0
                    task.wait(NEXO_IDLE)
                end
            else
                task.wait(NEXO_IDLE)
            end
        else
            if ShikiForcedCombat then shikiSetCombat(false) end
            if ShikiState ~= "Idle" then ShikiState = "Idle" end
            ShikiBossName, ShikiBossHP, ShikiBossModel = "-", "-", nil
            task.wait(NEXO_IDLE)
        end
    end
end)

