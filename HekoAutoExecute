    -- returns the position of a part/model (BasePart -> .Position, Model -> pivot), else nil
    function NexoPosOfObject(obj)
        if not obj then return nil end
        local pos
        pcall(function()
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                pos = obj:GetPivot().Position
            elseif obj:IsA("Attachment") then
                pos = obj.WorldPosition
            end
        end)
        return pos
    end

    -- collect EVERY object with that name (exact matches preferred, else partial), in a STABLE order
    -- so the click cycle is always the same 1, 2, 3 ... run after run.
    function NexoCollectObjects(name)
        local exact, loose = {}, {}
        local low = string.lower(name)
        -- ANTI-LAG: the name test now runs FIRST. It used to call NexoPosOfObject (2-3 IsA calls
        -- + GetPivot) on ALL 132,000+ workspace instances before even looking at the name, and
        -- string.lower allocated a fresh string for every one of them. Name first + a lowercase
        -- memo (names repeat thousands of times) gives the exact same two lists, ~50x cheaper.
        local lowMemo = {}
        pcall(function()
            for _, d in ipairs(wsDesc()) do
                local nm = d.Name
                if nm == name then
                    if NexoPosOfObject(d) then exact[#exact + 1] = d end
                else
                    local l = lowMemo[nm]
                    if l == nil then l = string.lower(nm) lowMemo[nm] = l end
                    if string.find(l, low, 1, true) and NexoPosOfObject(d) then
                        loose[#loose + 1] = d
                    end
                end
            end
        end)
        local list = (#exact > 0) and exact or loose
        pcall(function()
            table.sort(list, function(a, b)
                local pa, pb = NexoPosOfObject(a), NexoPosOfObject(b)
                if not pa or not pb then return false end
                if pa.X ~= pb.X then return pa.X < pb.X end
                if pa.Y ~= pb.Y then return pa.Y < pb.Y end
                return pa.Z < pb.Z
            end)
        end)
        return list
    end

